+    /**
+     * \brief Polls the video capture start event
+     *
+     * When DXVK_CAPTURE_VIDEO_START names an event, reads the process
+     * environment variable DXVK_CAPTURE_VIDEO_SIGNAL until it equals the
+     * event name. Call this on the application thread for every presented
+     * frame and pass the result to \ref setVideoSignal before the frame is
+     * presented, so that recording starts exactly with the first frame the
+     * application presents after it set the signal.
+     * \returns 0 while waiting, 1 after <event>.prepare, 2 after <event>
+     */
+    uint32_t pollVideoSignal();
+
+    /**
+     * \brief Sets the video capture start signal
+     *
+     * \param [in] level Value returned by \ref pollVideoSignal
+     */
+    void setVideoSignal(
+            uint32_t            level);
+
