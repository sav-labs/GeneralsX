diff --git a/src/d3d9/d3d9_swapchain.cpp b/src/d3d9/d3d9_swapchain.cpp
--- a/src/d3d9/d3d9_swapchain.cpp
+++ b/src/d3d9/d3d9_swapchain.cpp
@@ -1042,6 +1042,13 @@
       m_backBuffers.emplace_back(surface);
     }
 
+    // GeneralsX: report the back buffer the game asked for, including its
+    // multisample type, on every swap chain creation and reset.
+    Logger::info(str::format("D3D9SwapChainEx: ", bufferCount, " back buffer(s) ",
+      desc.Width, "x", desc.Height, ", format ", uint32_t(m_presentParams.BackBufferFormat),
+      ", MultiSampleType ", uint32_t(m_presentParams.MultiSampleType),
+      ", MultiSampleQuality ", m_presentParams.MultiSampleQuality));
