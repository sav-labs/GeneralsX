diff --git a/src/dxvk/dxvk_swapchain_blitter.cpp b/src/dxvk/dxvk_swapchain_blitter.cpp
--- a/src/dxvk/dxvk_swapchain_blitter.cpp
+++ b/src/dxvk/dxvk_swapchain_blitter.cpp
@@ -673,6 +673,30 @@
       && dstRect.extent.width >= srcRect.extent.width
       && dstRect.extent.height >= srcRect.extent.height;
 
+    // GeneralsX: log the present path once per change of FSR state, sizes or
+    // back buffer sample count, so the log shows whether FSR runs and whether
+    // it resolves a multisampled (D3D MultiSampleType) back buffer first.
+    VkSampleCountFlagBits srcSamples = srcView->image()->info().sampleCount;
+
+    if (useFsr != m_presentLogFsr
+     || srcSamples != m_presentLogSamples
+     || srcRect.extent != m_presentLogSrc
+     || dstRect.extent != m_presentLogDst) {
+      m_presentLogFsr = useFsr;
+      m_presentLogSamples = srcSamples;
+      m_presentLogSrc = srcRect.extent;
+      m_presentLogDst = dstRect.extent;
+
+      std::string msaa = srcSamples != VK_SAMPLE_COUNT_1_BIT
+        ? str::format(uint32_t(srcSamples), "x MSAA back buffer")
+        : std::string("single-sampled back buffer");
+
+      Logger::info(str::format("Swap chain: present ", srcRect.extent.width, "x", srcRect.extent.height,
+        " ", msaa, " to ", dstRect.extent.width, "x", dstRect.extent.height,
+        useFsr ? (srcSamples != VK_SAMPLE_COUNT_1_BIT ? ", FSR 1.0 active (MSAA resolved before EASU)" : ", FSR 1.0 active")
+               : (m_fsrEnabled ? ", FSR 1.0 enabled but inactive (no upscale)" : ", FSR 1.0 off")));
+    }
+
     Rc<DxvkImageView> blitView = srcView;
     VkRect2D blitRect = srcRect;
 
