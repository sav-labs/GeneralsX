+  /**
+   * \brief GeneralsX: finishes video writers off the present path
+   *
+   * Finishing a writer writes out its queued frames, closes the output
+   * and waits for the encoder to exit, which took about half a second at
+   * the end of a clip. That ran inside present and stalled the frame. A
+   * clip that ends while the swap chain presents is finished on its own
+   * thread instead, which then reports the clip as stopped. The blitter
+   * destructor waits for these threads, so that a clip is complete before
+   * its swap chain goes away.
+   */
+  class DxvkVideoFinisher {
+
+  public:
+
+    static DxvkVideoFinisher& instance() {
+      static DxvkVideoFinisher s_instance;
+      return s_instance;
+    }
+
+    /**
+     * \brief Finishes a writer on a thread of its own
+     *
+     * \param [in] writer The writer, may be null
+     * \param [in] message Logged once the writer is finished, if not empty
+     * \param [in] recordingState DXVK_CAPTURE_VIDEO_STATE value while
+     *    the clip records
+     * \param [in] state DXVK_CAPTURE_VIDEO_STATE value to set once the
+     *    writer is finished, if not empty and the variable still holds
+     *    recordingState
+     */
+    void finish(
+            std::unique_ptr<DxvkVideoWriter>&& writer,
+            std::string                         message,
+            std::string                         recordingState,
+            std::string                         state) {
+      auto job = std::make_shared<Job>();
+      job->writer         = std::move(writer);
+      job->message        = std::move(message);
+      job->recordingState = std::move(recordingState);
+      job->state          = std::move(state);
+
+      std::lock_guard lock(m_mutex);
+      joinFinishedLocked();
+
+      // The job outlives its thread: it is only dropped after a join
+      Job* jobPtr = job.get();
+
+      job->thread = dxvk::thread([job = jobPtr] {
+        env::setThreadName("dxvk-video-finish");
+
+        job->writer = nullptr;
+
+        if (!job->message.empty())
+          Logger::info(job->message);
+
+        // Leave the state alone if another clip was requested meanwhile
+        if (!job->state.empty()
+         && getVideoControlEnvVar("DXVK_CAPTURE_VIDEO_STATE") == job->recordingState)
+          setVideoControlEnvVar("DXVK_CAPTURE_VIDEO_STATE", job->state);
+
+        job->done = true;
+      });
+
+      m_jobs.push_back(std::move(job));
+    }
+
+    /**
+     * \brief Waits for all writers to finish
+     */
+    void waitAll() {
+      std::vector<std::shared_ptr<Job>> jobs;
+
+      { std::lock_guard lock(m_mutex);
+        jobs = std::move(m_jobs);
+        m_jobs.clear();
+      }
+
+      for (auto& job : jobs) {
+        if (job->thread.joinable())
+          job->thread.join();
+      }
+    }
+
+  private:
+
+    struct Job {
+      std::unique_ptr<DxvkVideoWriter> writer;
+      std::string                      message;
+      std::string                      recordingState;
+      std::string                      state;
+      std::atomic<bool>                done = { false };
+      dxvk::thread                     thread;
+    };
+
+    dxvk::mutex                        m_mutex;
+    std::vector<std::shared_ptr<Job>>  m_jobs;
+
+    void joinFinishedLocked() {
+      for (auto i = m_jobs.begin(); i != m_jobs.end(); ) {
+        if ((*i)->done.load()) {
+          if ((*i)->thread.joinable())
+            (*i)->thread.join();
+
+          i = m_jobs.erase(i);
+        } else {
+          i++;
+        }
+      }
+    }
+
+  };
+
   
