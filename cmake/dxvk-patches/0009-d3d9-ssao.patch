+#include "d3d9_ssao.h"
+
+#include <d3d9_ssao_vert.h>
+#include <d3d9_ssao_frag.h>
+#include <d3d9_ssao_apply_frag.h>
+
+namespace dxvk {
+
+  D3D9Ssao::D3D9Ssao(const Rc<DxvkDevice>& device)
+  : m_device(device) {
+    auto vk = m_device->vkd();
+
+    std::array<VkDescriptorSetLayoutBinding, 2> bindings = {{
+      { 0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_FRAGMENT_BIT },
+      { 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_FRAGMENT_BIT },
+    }};
+
+    VkDescriptorSetLayoutCreateInfo setInfo = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+    setInfo.bindingCount = bindings.size();
+    setInfo.pBindings = bindings.data();
+
+    VkResult vr = vk->vkCreateDescriptorSetLayout(vk->device(), &setInfo, nullptr, &m_setLayout);
+
+    if (vr != VK_SUCCESS)
+      throw DxvkError(str::format("SSAO: failed to create descriptor set layout: ", vr));
+
+    VkPushConstantRange pushConst = { };
+    pushConst.stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+    pushConst.size = sizeof(D3D9SsaoParams);
+
+    VkPipelineLayoutCreateInfo layoutInfo = { VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+    layoutInfo.setLayoutCount = 1;
+    layoutInfo.pSetLayouts = &m_setLayout;
+    layoutInfo.pushConstantRangeCount = 1;
+    layoutInfo.pPushConstantRanges = &pushConst;
+
+    vr = vk->vkCreatePipelineLayout(vk->device(), &layoutInfo, nullptr, &m_pipelineLayout);
+
+    if (vr != VK_SUCCESS)
+      throw DxvkError(str::format("SSAO: failed to create pipeline layout: ", vr));
+
+    m_vs      = CreateShaderModule(sizeof(d3d9_ssao_vert), d3d9_ssao_vert);
+    m_fsAo    = CreateShaderModule(sizeof(d3d9_ssao_frag), d3d9_ssao_frag);
+    m_fsApply = CreateShaderModule(sizeof(d3d9_ssao_apply_frag), d3d9_ssao_apply_frag);
+
+    m_aoPipeline = CreatePipeline(m_fsAo, VK_FORMAT_R8_UNORM, VK_SAMPLE_COUNT_1_BIT, false);
+
+    DxvkSamplerKey samplerKey = { };
+    samplerKey.setFilter(VK_FILTER_NEAREST, VK_FILTER_NEAREST, VK_SAMPLER_MIPMAP_MODE_NEAREST);
+    samplerKey.setAddressModes(
+      VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE);
+
+    m_sampler = m_device->createSampler(samplerKey);
+  }
+
+
+  D3D9Ssao::~D3D9Ssao() {
+    auto vk = m_device->vkd();
+
+    for (const auto& p : m_applyPipelines)
+      vk->vkDestroyPipeline(vk->device(), p.second, nullptr);
+
+    vk->vkDestroyPipeline(vk->device(), m_aoPipeline, nullptr);
+
+    vk->vkDestroyShaderModule(vk->device(), m_vs, nullptr);
+    vk->vkDestroyShaderModule(vk->device(), m_fsAo, nullptr);
+    vk->vkDestroyShaderModule(vk->device(), m_fsApply, nullptr);
+
+    vk->vkDestroyPipelineLayout(vk->device(), m_pipelineLayout, nullptr);
+    vk->vkDestroyDescriptorSetLayout(vk->device(), m_setLayout, nullptr);
+  }
+
+
+  void D3D9Ssao::Render(
+    const DxvkContextObjects&         ctx,
+    const Rc<DxvkImageView>&          colorView,
+    const Rc<DxvkImageView>&          depthView,
+    const D3D9SsaoParams&             params) {
+    VkExtent3D extent = depthView->mipLevelExtent(0u);
+
+    if (!m_aoImage || m_aoImage->info().extent != extent)
+      CreateAoImage(extent);
+
+    // Pass 1: occlusion of every pixel into the R8 image.
+    BeginPass(ctx, m_aoView, VK_IMAGE_LAYOUT_UNDEFINED,
+      m_aoPipeline, depthView, nullptr, params);
+
+    ctx.cmd->cmdDraw(3, 1, 0, 0);
+    ctx.cmd->cmdEndRendering();
+
+    VkImageMemoryBarrier2 barrier = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2 };
+    barrier.srcStageMask = VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT;
+    barrier.srcAccessMask = VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT;
+    barrier.dstStageMask = VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT;
+    barrier.dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT;
+    barrier.oldLayout = m_aoImage->pickLayout(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    barrier.newLayout = m_aoImage->info().layout;
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.image = m_aoImage->handle();
+    barrier.subresourceRange = m_aoView->imageSubresources();
+
+    VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    depInfo.imageMemoryBarrierCount = 1;
+    depInfo.pImageMemoryBarriers = &barrier;
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    // Pass 2: blur the occlusion and multiply it into the scene colour.
+    const Rc<DxvkImage>& colorImage = colorView->image();
+
+    BeginPass(ctx, colorView, colorImage->info().layout,
+      GetApplyPipeline(colorView->info().format, colorImage->info().sampleCount),
+      depthView, m_aoView, params);
+
+    ctx.cmd->cmdDraw(3, 1, 0, 0);
+    ctx.cmd->cmdEndRendering();
+
+    barrier.srcStageMask = VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT;
+    barrier.srcAccessMask = VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT
+                          | VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT;
+    barrier.dstStageMask = colorImage->info().stages;
+    barrier.dstAccessMask = colorImage->info().access;
+    barrier.oldLayout = colorImage->pickLayout(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    barrier.newLayout = colorImage->info().layout;
+    barrier.image = colorImage->handle();
+    barrier.subresourceRange = colorView->imageSubresources();
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    ctx.cmd->track(m_aoImage, DxvkAccess::Write);
+    ctx.cmd->track(colorImage, DxvkAccess::Write);
+    ctx.cmd->track(depthView->image(), DxvkAccess::Read);
+    ctx.cmd->track(m_sampler);
+  }
+
+
+  void D3D9Ssao::BeginPass(
+    const DxvkContextObjects&         ctx,
+    const Rc<DxvkImageView>&          view,
+          VkImageLayout               oldLayout,
+          VkPipeline                  pipeline,
+    const Rc<DxvkImageView>&          depthView,
+    const Rc<DxvkImageView>&          aoView,
+    const D3D9SsaoParams&             params) {
+    const Rc<DxvkImage>& image = view->image();
+    VkImageLayout layout = image->pickLayout(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+
+    // The AO image is fully overwritten. The colour target keeps its
+    // contents and waits for the scene draws that wrote it.
+    VkImageMemoryBarrier2 barrier = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2 };
+    barrier.srcStageMask = oldLayout == VK_IMAGE_LAYOUT_UNDEFINED
+      ? VkPipelineStageFlags2(VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT)
+      : VkPipelineStageFlags2(image->info().stages);
+    barrier.srcAccessMask = oldLayout == VK_IMAGE_LAYOUT_UNDEFINED
+      ? VkAccessFlags2(0)
+      : VkAccessFlags2(image->info().access);
+    barrier.dstStageMask = VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT;
+    barrier.dstAccessMask = VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT
+                          | VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT;
+    barrier.oldLayout = oldLayout;
+    barrier.newLayout = layout;
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.image = image->handle();
+    barrier.subresourceRange = view->imageSubresources();
+
+    // The depth copy was written by a transfer or resolve just before.
+    VkMemoryBarrier2 memBarrier = { VK_STRUCTURE_TYPE_MEMORY_BARRIER_2 };
+    memBarrier.srcStageMask = VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT
+                            | VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT
+                            | VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT;
+    memBarrier.srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT
+                             | VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT
+                             | VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+    memBarrier.dstStageMask = VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT;
+    memBarrier.dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT;
+
+    VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    depInfo.memoryBarrierCount = 1;
+    depInfo.pMemoryBarriers = &memBarrier;
+    depInfo.imageMemoryBarrierCount = 1;
+    depInfo.pImageMemoryBarriers = &barrier;
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    if (oldLayout == VK_IMAGE_LAYOUT_UNDEFINED)
+      image->trackInitialization(barrier.subresourceRange);
+
+    VkExtent3D extent = view->mipLevelExtent(0u);
+
+    VkRenderingAttachmentInfo attachmentInfo = { VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO };
+    attachmentInfo.imageView = view->handle();
+    attachmentInfo.imageLayout = layout;
+    attachmentInfo.loadOp = oldLayout == VK_IMAGE_LAYOUT_UNDEFINED
+      ? VK_ATTACHMENT_LOAD_OP_DONT_CARE
+      : VK_ATTACHMENT_LOAD_OP_LOAD;
+    attachmentInfo.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+
+    VkRenderingInfo renderInfo = { VK_STRUCTURE_TYPE_RENDERING_INFO };
+    renderInfo.renderArea.offset = { 0, 0 };
+    renderInfo.renderArea.extent = { extent.width, extent.height };
+    renderInfo.layerCount = 1u;
+    renderInfo.colorAttachmentCount = 1;
+    renderInfo.pColorAttachments = &attachmentInfo;
+
+    ctx.cmd->cmdBeginRendering(&renderInfo);
+
+    VkViewport viewport = { };
+    viewport.width = float(extent.width);
+    viewport.height = float(extent.height);
+    viewport.maxDepth = 1.0f;
+
+    ctx.cmd->cmdSetViewport(1, &viewport);
+    ctx.cmd->cmdSetScissor(1, &renderInfo.renderArea);
+
+    ctx.cmd->cmdBindPipeline(DxvkCmdBuffer::ExecBuffer,
+      VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+
+    VkDescriptorSet set = ctx.descriptorPool->alloc(m_setLayout);
+
+    VkDescriptorImageInfo depthDescriptor = { };
+    depthDescriptor.sampler = m_sampler->handle();
+    depthDescriptor.imageView = depthView->handle();
+    depthDescriptor.imageLayout = depthView->image()->info().layout;
+
+    // The occlusion pass does not read the AO image, bind the depth again.
+    VkDescriptorImageInfo aoDescriptor = depthDescriptor;
+
+    if (aoView != nullptr) {
+      aoDescriptor.imageView = aoView->handle();
+      aoDescriptor.imageLayout = aoView->image()->info().layout;
+    }
+
+    std::array<VkWriteDescriptorSet, 2> descriptorWrites = {{
+      { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr,
+        set, 0, 0, 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &depthDescriptor },
+      { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr,
+        set, 1, 0, 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &aoDescriptor },
+    }};
+
+    ctx.cmd->updateDescriptorSets(descriptorWrites.size(), descriptorWrites.data());
+
+    ctx.cmd->cmdBindDescriptorSet(DxvkCmdBuffer::ExecBuffer,
+      VK_PIPELINE_BIND_POINT_GRAPHICS, m_pipelineLayout, set, 0, nullptr);
+
+    ctx.cmd->cmdPushConstants(DxvkCmdBuffer::ExecBuffer, m_pipelineLayout,
+      VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof(params), &params);
+  }
+
+
+  VkShaderModule D3D9Ssao::CreateShaderModule(size_t size, const uint32_t* code) {
+    auto vk = m_device->vkd();
+
+    VkShaderModuleCreateInfo info = { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+    info.codeSize = size;
+    info.pCode = code;
+
+    VkShaderModule module = VK_NULL_HANDLE;
+    VkResult vr = vk->vkCreateShaderModule(vk->device(), &info, nullptr, &module);
+
+    if (vr != VK_SUCCESS)
+      throw DxvkError(str::format("SSAO: failed to create shader module: ", vr));
+
+    return module;
+  }
