+  // GeneralsX: darkens creases and contact areas of the opaque scene drawn
+  // so far. The depth is copied like for soft particles, then two raw
+  // Vulkan passes compute the occlusion and multiply it into render
+  // target 0. The game sends this between its opaque and its translucent
+  // geometry, so particles, water and the interface stay untouched.
+  void D3D9DeviceEx::ApplyAmbientOcclusion() {
+    if (!m_ssaoEnabled)
+      return;
+
+    D3D9Surface* rt = m_state.renderTargets[0].ptr();
+    D3D9Surface* ds = m_state.depthStencil.ptr();
+
+    if (rt == nullptr || ds == nullptr)
+      return;
+
+    Rc<DxvkImageView> colorView = rt->GetRenderTargetView(false);
+
+    if (colorView == nullptr)
+      return;
+
+    VkExtent3D rtExtent = colorView->mipLevelExtent(0u);
+    VkExtent3D dsExtent = ds->GetCommonTexture()->GetImage()->mipLevelExtent(ds->GetMipLevel());
+
+    if (rtExtent.width != dsExtent.width || rtExtent.height != dsExtent.height)
+      return;
+
+    const Matrix4& proj = m_state.transforms[GetTransformIndex(D3DTS_PROJECTION)];
+
+    // Positions are rebuilt with the clip w as depth, w = _43 / (depth - _33 / _34),
+    // which works for both handedness conventions.
+    if (proj[2][3] == 0.0f || proj[0][0] == 0.0f || proj[1][1] == 0.0f)
+      return;
+
+    CopySoftParticleDepth();
+
+    if (m_softDepthView == nullptr)
+      return;
+
+    if (m_ssao == nullptr)
+      m_ssao = std::make_shared<D3D9Ssao>(m_dxvkDevice);
+
+    D3D9SsaoParams params = { };
+    params.proj[0]   = std::abs(proj[0][0]);
+    params.proj[1]   = std::abs(proj[1][1]);
+    params.proj[2]   = proj[2][2] / proj[2][3];
+    params.proj[3]   = proj[3][2];
+    params.radius    = m_ssaoRadius;
+    params.strength  = m_ssaoStrength;
+    params.bias      = 0.1f;
+    params.maxPixels = std::max(16.0f, float(rtExtent.height) / 24.0f);
+    params.extent[0] = float(rtExtent.width);
+    params.extent[1] = float(rtExtent.height);
+
+    EmitCs([
+      cSsao      = m_ssao,
+      cColorView = std::move(colorView),
+      cDepthView = m_softDepthView,
+      cParams    = params
+    ] (DxvkContext* ctx) {
+      DxvkContextObjects objects = ctx->beginExternalRendering();
+      cSsao->Render(objects, cColorView, cDepthView, cParams);
+    });
+
+    // The depth copy is reused by soft particles, which bind it again.
+    m_softParticleBound = false;
+  }
