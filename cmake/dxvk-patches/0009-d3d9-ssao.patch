diff --git a/src/d3d9/shaders/d3d9_ssao_apply_frag.frag b/src/d3d9/shaders/d3d9_ssao_apply_frag.frag
new file mode 100644
index 0000000..2de18f5
--- /dev/null
+++ b/src/d3d9/shaders/d3d9_ssao_apply_frag.frag
@@ -0,0 +1,40 @@
+#version 450
+
+#extension GL_GOOGLE_include_directive : enable
+
+#include "d3d9_ssao_common.glsl"
+
+// GeneralsX: blurs the occlusion over the 4x4 rotation pattern, skipping
+// pixels at a different depth, and outputs it for a multiply blend into
+// the scene colour.
+
+layout(location = 0) out vec4 o_color;
+
+void main() {
+  ivec2 pixel = ivec2(gl_FragCoord.xy);
+  float depth = fetch_depth(pixel);
+
+  if (depth >= 1.0f) {
+    o_color = vec4(1.0f);
+    return;
+  }
+
+  float z = view_z(depth);
+  ivec2 size = ivec2(pc.extent);
+
+  float sum = 0.0f;
+  float weights = 0.0f;
+
+  for (int y = -2; y < 2; y++) {
+    for (int x = -2; x < 2; x++) {
+      ivec2 p = clamp(pixel + ivec2(x, y), ivec2(0), size - 1);
+      float sz = view_z(texelFetch(s_depth, p, 0).r);
+      float w = max(1.0f - abs(sz - z) / (0.1f * z + 1.0f), 0.0f);
+      sum += texelFetch(s_ao, p, 0).r * w;
+      weights += w;
+    }
+  }
+
+  float visibility = weights > 0.0f ? sum / weights : 1.0f;
+  o_color = vec4(vec3(visibility), 1.0f);
+}
diff --git a/src/d3d9/shaders/d3d9_ssao_common.glsl b/src/d3d9/shaders/d3d9_ssao_common.glsl
new file mode 100644
index 0000000..8b8b5f4
--- /dev/null
+++ b/src/d3d9/shaders/d3d9_ssao_common.glsl
@@ -0,0 +1,29 @@
+// GeneralsX: shared declarations of the ambient occlusion passes.
+
+layout(set = 0, binding = 0) uniform sampler2D s_depth;
+layout(set = 0, binding = 1) uniform sampler2D s_ao;
+
+layout(push_constant) uniform push_t {
+  // Projection _11, _22, _33, _43 of the D3D9 projection matrix.
+  vec4 proj;
+  // Radius in view units, strength, normal bias, largest radius in pixels.
+  vec4 params;
+  // Depth image size in pixels.
+  vec2 extent;
+} pc;
+
+float view_z(float depth) {
+  return pc.proj.w / (depth - pc.proj.z);
+}
+
+vec3 view_pos(ivec2 pixel, float depth) {
+  float z = view_z(depth);
+  vec2 ndc = (vec2(pixel) + 0.5f) / pc.extent * 2.0f - 1.0f;
+  ndc.y = -ndc.y;
+  return vec3(ndc.x * z / pc.proj.x, ndc.y * z / pc.proj.y, z);
+}
+
+float fetch_depth(ivec2 pixel) {
+  ivec2 size = ivec2(pc.extent);
+  return texelFetch(s_depth, clamp(pixel, ivec2(0), size - 1), 0).r;
+}
diff --git a/src/d3d9/shaders/d3d9_ssao_frag.frag b/src/d3d9/shaders/d3d9_ssao_frag.frag
new file mode 100644
index 0000000..801d7d7
--- /dev/null
+++ b/src/d3d9/shaders/d3d9_ssao_frag.frag
@@ -0,0 +1,85 @@
+#version 450
+
+#extension GL_GOOGLE_include_directive : enable
+
+#include "d3d9_ssao_common.glsl"
+
+// GeneralsX: screen space ambient occlusion from the scene depth. Writes the
+// visibility (1 = open, 0 = fully occluded) of every pixel.
+
+layout(location = 0) out float o_visibility;
+
+// GeneralsX @performance Claude 18/10/2026 8 samples instead of 12: ambient occlusion is the most expensive
+// post pass in battle, and the 4x4 interleaved rotation plus the apply-pass blur hide the lower sample count.
+const int   SAMPLE_COUNT = 8;
+const float GOLDEN_ANGLE = 2.39996323f;
+
+vec3 pick_tangent(vec3 p, vec3 a, vec3 b) {
+  // Use the neighbour closer in depth so silhouettes do not bend the normal.
+  return abs(a.z - p.z) < abs(b.z - p.z) ? a - p : p - b;
+}
+
+void main() {
+  ivec2 pixel = ivec2(gl_FragCoord.xy);
+  float depth = fetch_depth(pixel);
+
+  if (depth >= 1.0f) {
+    o_visibility = 1.0f;
+    return;
+  }
+
+  vec3 p = view_pos(pixel, depth);
+
+  ivec2 dx = ivec2(1, 0);
+  ivec2 dy = ivec2(0, 1);
+
+  vec3 px = pick_tangent(p,
+    view_pos(pixel + dx, fetch_depth(pixel + dx)),
+    view_pos(pixel - dx, fetch_depth(pixel - dx)));
+  vec3 py = pick_tangent(p,
+    view_pos(pixel + dy, fetch_depth(pixel + dy)),
+    view_pos(pixel - dy, fetch_depth(pixel - dy)));
+
+  vec3 n = normalize(cross(py, px));
+
+  if (dot(n, p) > 0.0f)
+    n = -n;
+
+  float radius = pc.params.x;
+  float radius2 = radius * radius;
+
+  // Radius on screen, from the projection scale at this depth.
+  float pixelRadius = min(radius * pc.proj.x * 0.5f * pc.extent.x / p.z, pc.params.w);
+
+  if (pixelRadius < 1.0f) {
+    o_visibility = 1.0f;
+    return;
+  }
+
+  // 4x4 interleaved rotation, removed again by the blur in the apply pass.
+  float rotation = float((pixel.x & 3) * 4 + (pixel.y & 3)) * (6.2831853f / 16.0f);
+
+  float occlusion = 0.0f;
+
+  for (int i = 0; i < SAMPLE_COUNT; i++) {
+    float t = (float(i) + 0.5f) / float(SAMPLE_COUNT);
+    float angle = float(i) * GOLDEN_ANGLE + rotation;
+    vec2 offset = vec2(cos(angle), sin(angle)) * (t * pixelRadius);
+
+    ivec2 samplePixel = pixel + ivec2(round(offset));
+    float sampleDepth = fetch_depth(samplePixel);
+
+    if (sampleDepth >= 1.0f)
+      continue;
+
+    vec3 v = view_pos(samplePixel, sampleDepth) - p;
+    float vv = dot(v, v);
+    float vn = dot(v, n);
+
+    float falloff = max(1.0f - vv / radius2, 0.0f);
+    occlusion += falloff * max(vn * inversesqrt(vv + 0.0001f) - pc.params.z, 0.0f);
+  }
+
+  occlusion /= float(SAMPLE_COUNT);
+  o_visibility = clamp(1.0f - pc.params.y * 2.0f * occlusion, 0.0f, 1.0f);
+}
diff --git a/src/d3d9/shaders/d3d9_ssao_vert.vert b/src/d3d9/shaders/d3d9_ssao_vert.vert
new file mode 100644
index 0000000..df333b1
--- /dev/null
+++ b/src/d3d9/shaders/d3d9_ssao_vert.vert
@@ -0,0 +1,7 @@
+#version 450
+
+// GeneralsX: full screen triangle for the ambient occlusion passes.
+void main() {
+  vec2 coord = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
+  gl_Position = vec4(coord * 2.0f - 1.0f, 0.0f, 1.0f);
+}
