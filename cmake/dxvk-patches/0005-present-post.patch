index 0000000..80a3b7f
--- /dev/null
+++ b/src/dxvk/shaders/dxvk_present_bloom_blur.glsl
@@ -0,0 +1,21 @@
+// Separable 9-tap Gaussian over the quarter-size bloom image. Taps are
+// two texels apart to widen the glow at no extra cost.
+layout(location = 0) in  vec2 i_coord;
+layout(location = 0) out vec4 o_color;
+
+void main() {
+  const float weights[5] = float[](0.227027f, 0.1945946f, 0.1216216f, 0.054054f, 0.016216f);
+
+  ivec2 pos = ivec2(gl_FragCoord.xy);
+  ivec2 hi = textureSize(s_image, 0) - 1;
+
+  vec3 sum = texelFetch(s_image, pos, 0).rgb * weights[0];
+
+  for (int i = 1; i < 5; i++) {
+    ivec2 ofs = c_blur_dir * (2 * i);
+    sum += texelFetch(s_image, clamp(pos + ofs, ivec2(0), hi), 0).rgb * weights[i];
+    sum += texelFetch(s_image, clamp(pos - ofs, ivec2(0), hi), 0).rgb * weights[i];
+  }
+
+  o_color = vec4(sum, 1.0f);
+}
