@@ -0,0 +1,34 @@
+#version 450
+
+#extension GL_GOOGLE_include_directive : enable
+
+#include "dxvk_present_common.glsl"
+
+// Bloom bright pass: averages 4x4 source texels into one quarter-size
+// texel and keeps only the part above the bloom threshold.
+layout(location = 0) in  vec2 i_coord;
+layout(location = 0) out vec4 o_color;
+
+void main() {
+  ivec2 pos = ivec2(gl_FragCoord.xy) - dst_offset;
+  vec2 scale = vec2(src_extent) / vec2(dst_extent);
+
+  ivec2 lo = src_offset;
+  ivec2 hi = src_offset + src_extent - 1;
+  ivec2 base = src_offset + ivec2((vec2(pos) + 0.5f) * scale) - 2;
+
+  vec3 sum = vec3(0.0f);
+
+  for (int y = 0; y < 4; y++) {
+    for (int x = 0; x < 4; x++) {
+      vec3 texel = texelFetch(s_image, clamp(base + ivec2(x, y), lo, hi), 0).rgb;
+      sum += c_src_is_srgb ? linear_to_srgb(texel) : texel;
+    }
+  }
+
+  vec3 color = sum / 16.0f;
+  float peak = max(color.r, max(color.g, color.b));
+  float weight = max(peak - bloom_threshold, 0.0f) / max(1.0f - bloom_threshold, 0.001f);
+
+  o_color = vec4(color * weight, 1.0f);
+}
