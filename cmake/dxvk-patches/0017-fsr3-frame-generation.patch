+  Rc<DxvkImageView> DxvkFsr3::interpolate(
+    const DxvkContextObjects&         ctx,
+    const DxvkTemporalUpscaleInputs&  inputs,
+    const Rc<DxvkImageView>&          finalView,
+          VkRect2D                    finalRect,
+    const Rc<DxvkImageView>&          spatialView) {
+    if (!frameGenerationReady() || m_ffx == nullptr || m_generatedView == nullptr
+     || inputs.color == nullptr || inputs.depth == nullptr)
+      return nullptr;
+
+    // A camera cut or the first frame after (re)creating the contexts has
+    // no previous frame; frame interpolation still runs to store this one.
+    bool reset = inputs.reset || !m_fgHavePrev;
+
+    if (unlikely(m_device->debugFlags().test(DxvkDebugFlag::Capture))) {
+      ctx.cmd->cmdBeginDebugUtilsLabel(DxvkCmdBuffer::ExecBuffer,
+        vk::makeLabel(0xdcc0f0, "FSR 3 frame generation"));
+    }
+
+    bool success = dispatchFrameGeneration(ctx, inputs, reset);
+
+    // The interface of the generated frame comes from the real frame: the
+    // composite pass takes it from the EASU image wherever the final image
+    // differs from the scene copy.
+    if (success && !reset) {
+      compositePass(ctx, inputs, m_fiOutputView, finalView, finalRect,
+        spatialView, m_generatedView, false);
+    }
+
+    VkMemoryBarrier2 readBarrier = { VK_STRUCTURE_TYPE_MEMORY_BARRIER_2 };
+    readBarrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    readBarrier.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+
+    VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    depInfo.memoryBarrierCount = 1;
+    depInfo.pMemoryBarriers = &readBarrier;
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    if (unlikely(m_device->debugFlags().test(DxvkDebugFlag::Capture)))
+      ctx.cmd->cmdEndDebugUtilsLabel(DxvkCmdBuffer::ExecBuffer);
+
+    releaseViews(ctx);
+
+    ctx.cmd->track(inputs.color->image(), DxvkAccess::Read);
+    ctx.cmd->track(finalView->image(), DxvkAccess::Read);
+    ctx.cmd->track(spatialView->image(), DxvkAccess::Read);
+    ctx.cmd->track(m_outputImage, DxvkAccess::Read);
+    ctx.cmd->track(m_fiOutputImage, DxvkAccess::Write);
+    ctx.cmd->track(m_generatedImage, DxvkAccess::Write);
+
+    if (!success)
+      return nullptr;
+
+    m_fgHavePrev = true;
+
+    if (reset)
+      return nullptr;
+
+    m_fgFrameCount += 1u;
+
+    if (m_fgFrameCount == 1u || !(m_fgFrameCount % 600u)) {
+      Logger::info(str::format("[FSR3] frame generation: generated frame ", m_fgFrameCount,
+        ", ", m_displayExtent.width, "x", m_displayExtent.height,
+        ", frame time ", inputs.frameTimeMs, " ms"));
+    }
+
+    return m_generatedView;
+  }
