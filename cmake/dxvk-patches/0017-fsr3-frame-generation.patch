+
+  void DxvkSwapchainBlitter::paceFrameGeneration(
+          DxvkFrameGenPass    pass) {
+    // GeneralsX: the generated frame lies halfway between two real frames,
+    // so the real frame is presented half a real frame interval after it.
+    // The interval is a moving average of the Generated passes, capped so
+    // that a stall never holds a frame back for long.
+    constexpr double MaxDelayUs = 20000.0;
+    constexpr double ResetIntervalUs = 250000.0;
+
+    auto now = dxvk::high_resolution_clock::now();
+
+    if (pass == DxvkFrameGenPass::Generated) {
+      if (m_fgLastGenerated != dxvk::high_resolution_clock::time_point()) {
+        double intervalUs = double(std::chrono::duration_cast<std::chrono::microseconds>(
+          now - m_fgLastGenerated).count());
+
+        if (intervalUs > ResetIntervalUs)
+          m_fgIntervalUs = 0.0;
+        else if (m_fgIntervalUs <= 0.0)
+          m_fgIntervalUs = intervalUs;
+        else
+          m_fgIntervalUs = 0.9 * m_fgIntervalUs + 0.1 * intervalUs;
+      }
+
+      m_fgLastGenerated = now;
+    } else if (pass == DxvkFrameGenPass::Real && m_fgIntervalUs > 0.0) {
+      double delayUs = std::min(0.5 * m_fgIntervalUs, MaxDelayUs);
+      auto target = m_fgLastGenerated + std::chrono::microseconds(int64_t(delayUs));
+
+      if (now < target)
+        Sleep::sleepUntil(now, target);
+    }
+  }
