+  bool DxvkFsr3::dispatchFrameGeneration(
+    const DxvkContextObjects&         ctx,
+    const DxvkTemporalUpscaleInputs&  inputs,
+          bool                        reset) {
+#ifdef DXVK_GENERALSX_FSR3
+    if (!m_ffx->frameInterpolationValid || !m_ffx->opticalFlowResourcesValid)
+      return false;
+
+    // Frame interpolation writes every output pixel; the composite pass of
+    // the previous frame may still read the image.
+    VkImageMemoryBarrier2 barrier = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2 };
+    barrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    barrier.dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    barrier.dstAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+    barrier.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    barrier.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.image = m_fiOutputImage->handle();
+    barrier.subresourceRange = m_fiOutputView->imageSubresources();
+
+    // The upscaler output was written in GENERAL layout
+    VkMemoryBarrier2 memBarrier = { VK_STRUCTURE_TYPE_MEMORY_BARRIER_2 };
+    memBarrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    memBarrier.srcAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+    memBarrier.dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    memBarrier.dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT;
+
+    VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    depInfo.memoryBarrierCount = 1;
+    depInfo.pMemoryBarriers = &memBarrier;
+    depInfo.imageMemoryBarrierCount = 1;
+    depInfo.pImageMemoryBarriers = &barrier;
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    VkCommandBuffer cmdBuffer = ctx.cmd->getExecCommandBuffer();
+
+    // The upscaled scene without the interface is the interpolation source.
+    // The game's colour is sRGB-encoded LDR.
+    FfxResource sceneColor = getFfxImage(m_outputImage, VK_FORMAT_R16G16B16A16_SFLOAT,
+      m_displayExtent, true, L"FSR3 upscaled scene", FFX_RESOURCE_STATE_UNORDERED_ACCESS);
+
+    FfxResource opticalFlowVector = m_ffx->backend.fpGetResource(&m_ffx->backend, m_ffx->opticalFlowVector);
+    FfxResource opticalFlowScd = m_ffx->backend.fpGetResource(&m_ffx->backend, m_ffx->opticalFlowScd);
+
+    FfxOpticalflowDispatchDescription ofDesc = { };
+    ofDesc.commandList = ffxGetCommandListVK(cmdBuffer);
+    ofDesc.color = sceneColor;
+    ofDesc.opticalFlowVector = opticalFlowVector;
+    ofDesc.opticalFlowSCD = opticalFlowScd;
+    ofDesc.reset = reset;
+    ofDesc.backbufferTransferFunction = FFX_BACKBUFFER_TRANSFER_FUNCTION_SRGB;
+    ofDesc.minMaxLuminance = { 0.0f, 1.0f };
+
