+    // the Generated pass upscales it and presents the frame interpolated
+    // between the previous and this frame, the Real pass presents this
+    // frame. Both presents need their own swap chain image, and the
+    // latency tracker (Reflex, low latency) expects one present per frame.
+    bool frameGen = false;
+
+    if (m_blitter->isFrameGenerationActive()) {
+      const char* reason = nullptr;
+
+      if (m_latencyTracker)
+        reason = "a frame latency tracker is active";
+      else if (m_wctx->presenter->getImageCount() < 3u)
+        reason = "the swap chain has fewer than 3 images";
