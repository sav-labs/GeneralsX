+  bool DxvkFsr3::createFrameGeneration(VkExtent2D renderExtent, VkExtent2D displayExtent) {
+#ifdef DXVK_GENERALSX_FSR3
+    FfxOpticalflowContextDescription ofDesc = { };
+    ofDesc.backendInterface = m_ffx->backend;
+    ofDesc.resolution = { displayExtent.width, displayExtent.height };
+
+    FfxErrorCode error = ffxOpticalflowContextCreate(&m_ffx->opticalFlow, &ofDesc);
+
+    if (error != FFX_OK) {
+      failFrameGeneration(str::format("ffxOpticalflowContextCreate failed: ", error));
+      return false;
+    }
+
+    m_ffx->opticalFlowValid = true;
+
+    // The interpolation source is the upscaled 3D scene without the
+    // interface, in the FSR 3 output format. Motion vectors are the
+    // upscaler's dilated ones at render size, without jitter.
+    FfxFrameInterpolationContextDescription fiDesc = { };
+    fiDesc.flags = 0u;
+    fiDesc.maxRenderSize = { renderExtent.width, renderExtent.height };
+    fiDesc.displaySize = { displayExtent.width, displayExtent.height };
+    fiDesc.backBufferFormat = FFX_SURFACE_FORMAT_R16G16B16A16_FLOAT;
+    fiDesc.previousInterpolationSourceFormat = FFX_SURFACE_FORMAT_R16G16B16A16_FLOAT;
+    fiDesc.backendInterface = m_ffx->backend;
+
+    error = ffxFrameInterpolationContextCreate(&m_ffx->frameInterpolation, &fiDesc);
+
+    if (error != FFX_OK) {
+      failFrameGeneration(str::format("ffxFrameInterpolationContextCreate failed: ", error));
+      return false;
+    }
+
+    m_ffx->frameInterpolationValid = true;
+
+    FfxOpticalflowSharedResourceDescriptions ofShared = { };
+    error = ffxOpticalflowGetSharedResourceDescriptions(&m_ffx->opticalFlow, &ofShared);
+
+    if (error == FFX_OK)
+      error = m_ffx->backend.fpCreateResource(&m_ffx->backend, &ofShared.opticalFlowVector, m_ffx->sharedContextId, &m_ffx->opticalFlowVector);
+
+    if (error == FFX_OK) {
+      error = m_ffx->backend.fpCreateResource(&m_ffx->backend, &ofShared.opticalFlowSCD, m_ffx->sharedContextId, &m_ffx->opticalFlowScd);
+
+      if (error != FFX_OK)
+        m_ffx->backend.fpDestroyResource(&m_ffx->backend, m_ffx->opticalFlowVector, m_ffx->sharedContextId);
+    }
+
+    if (error != FFX_OK) {
+      failFrameGeneration(str::format("optical flow resources: fpCreateResource failed: ", error));
+      return false;
+    }
+
+    m_ffx->opticalFlowResourcesValid = true;
+    m_fgFrameId = 0u;
+
+    Logger::info(str::format("[FSR3] frame generation: optical flow and frame interpolation contexts created, ",
+      displayExtent.width, "x", displayExtent.height));
+    return true;
+#else
+    (void)renderExtent;
+    (void)displayExtent;
+    return false;
+#endif
+  }
