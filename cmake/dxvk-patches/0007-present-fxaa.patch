diff --git a/src/dxvk/shaders/dxvk_present_frag_fxaa.frag b/src/dxvk/shaders/dxvk_present_frag_fxaa.frag
new file mode 100644
index 0000000..3e30007
--- /dev/null
+++ b/src/dxvk/shaders/dxvk_present_frag_fxaa.frag
@@ -0,0 +1,80 @@
+#version 450
+
+#extension GL_GOOGLE_include_directive : enable
+
+#include "dxvk_present_common.glsl"
+
+// FXAA anti-aliasing of the game image at its own size. Finds the local
+// edge direction from luma and blends along it. Output is gamma-encoded.
+layout(location = 0) in  vec2 i_coord;
+layout(location = 0) out vec4 o_color;
+
+const float FXAA_REDUCE_MIN = 1.0f / 128.0f;
+const float FXAA_REDUCE_MUL = 1.0f / 8.0f;
+const float FXAA_SPAN_MAX   = 8.0f;
+const float FXAA_EDGE_MIN   = 1.0f / 24.0f;
+const float FXAA_EDGE_REL   = 1.0f / 8.0f;
+
+vec3 fetch_gamma(ivec2 pos) {
+  ivec2 lo = src_offset;
+  ivec2 hi = src_offset + src_extent - 1;
+  vec3 texel = texelFetch(s_image, clamp(pos, lo, hi), 0).rgb;
+  return c_src_is_srgb ? linear_to_srgb(texel) : texel;
+}
+
+// Bilinear sample at a position in source pixels, where texel centers
+// sit at integer + 0.5.
+vec3 sample_gamma(vec2 pos) {
+  vec2 p = pos - 0.5f;
+  ivec2 i = ivec2(floor(p));
+  vec2 f = p - vec2(i);
+
+  vec3 a = mix(fetch_gamma(i),               fetch_gamma(i + ivec2(1, 0)), f.x);
+  vec3 b = mix(fetch_gamma(i + ivec2(0, 1)), fetch_gamma(i + ivec2(1, 1)), f.x);
+  return mix(a, b, f.y);
+}
+
+float luma(vec3 color) {
+  return dot(color, vec3(0.299f, 0.587f, 0.114f));
+}
+
+void main() {
+  ivec2 pos = ivec2(gl_FragCoord.xy) - dst_offset + src_offset;
+  vec2 center = vec2(pos) + 0.5f;
+
+  vec3 rgbM = fetch_gamma(pos);
+  float lumaM  = luma(rgbM);
+  float lumaNW = luma(fetch_gamma(pos + ivec2(-1, -1)));
+  float lumaNE = luma(fetch_gamma(pos + ivec2( 1, -1)));
+  float lumaSW = luma(fetch_gamma(pos + ivec2(-1,  1)));
+  float lumaSE = luma(fetch_gamma(pos + ivec2( 1,  1)));
+
+  float lumaMin = min(lumaM, min(min(lumaNW, lumaNE), min(lumaSW, lumaSE)));
+  float lumaMax = max(lumaM, max(max(lumaNW, lumaNE), max(lumaSW, lumaSE)));
+
+  // Flat areas keep the original pixel
+  if (lumaMax - lumaMin < max(FXAA_EDGE_MIN, lumaMax * FXAA_EDGE_REL)) {
+    o_color = vec4(rgbM, 1.0f);
+    return;
+  }
+
+  vec2 dir = vec2(
+    -((lumaNW + lumaNE) - (lumaSW + lumaSE)),
+     ((lumaNW + lumaSW) - (lumaNE + lumaSE)));
+
+  float dirReduce = max((lumaNW + lumaNE + lumaSW + lumaSE) * 0.25f * FXAA_REDUCE_MUL, FXAA_REDUCE_MIN);
+  float rcpDirMin = 1.0f / (min(abs(dir.x), abs(dir.y)) + dirReduce);
+  dir = clamp(dir * rcpDirMin, vec2(-FXAA_SPAN_MAX), vec2(FXAA_SPAN_MAX));
+
+  vec3 rgbA = 0.5f * (
+    sample_gamma(center + dir * (1.0f / 3.0f - 0.5f)) +
+    sample_gamma(center + dir * (2.0f / 3.0f - 0.5f)));
+  vec3 rgbB = rgbA * 0.5f + 0.25f * (
+    sample_gamma(center - dir * 0.5f) +
+    sample_gamma(center + dir * 0.5f));
+
+  float lumaB = luma(rgbB);
+  vec3 color = (lumaB < lumaMin || lumaB > lumaMax) ? rgbA : rgbB;
+
+  o_color = vec4(color, 1.0f);
+}
