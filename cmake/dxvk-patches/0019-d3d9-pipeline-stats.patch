+  // GeneralsX: pipeline creation totals for the game's frame hitch report.
+  // The layout is shared with the game (W3DDisplay.cpp) and checked with
+  // the size field: size, pipelines created for draws, of those compiled
+  // without pipeline libraries, fixed function shaders generated, and the
+  // time spent creating the pipelines in microseconds.
+  struct GeneralsXPipelineStats {
+    uint32_t size;
+    uint32_t pipelines;
+    uint32_t fullCompiles;
+    uint32_t ffShaders;
+    uint64_t pipelineUs;
+  };
+
+  DLLEXPORT BOOL __stdcall GeneralsX_GetPipelineStats(void* pStats) {
+    auto stats = reinterpret_cast<GeneralsXPipelineStats*>(pStats);
+
+    if (!stats || stats->size != sizeof(GeneralsXPipelineStats))
+      return FALSE;
+
+    stats->pipelines    = uint32_t(dxvk::g_drawPipelineStats.created.load());
+    stats->fullCompiles = uint32_t(dxvk::g_drawPipelineStats.fullCompiles.load());
+    stats->ffShaders    = uint32_t(dxvk::g_ffShadersCreated.load());
+    stats->pipelineUs   = dxvk::g_drawPipelineStats.timeUs.load();
+    return TRUE;
+  }
+
