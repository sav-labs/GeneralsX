+
+  void DxvkUpscalerTimer::begin(const DxvkContextObjects& ctx) {
+    if (!m_pool)
+      return;
+
+    m_slot = (m_slot + 1u) % Slots;
+
+    // Results of the frame that last used the slot, several frames ago
+    if (m_slotMarks[m_slot])
+      collect(m_slot);
+
+    uint32_t stride = uint32_t(m_passes.size() + 1u);
+
+    ctx.cmd->cmdResetQueryPool(DxvkCmdBuffer::ExecBuffer, m_pool, m_slot * stride, stride);
+    ctx.cmd->cmdWriteTimestamp(DxvkCmdBuffer::ExecBuffer,
+      VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, m_pool, m_slot * stride);
+
+    m_marks = 0u;
+    m_open = true;
+  }
+
+
+  void DxvkUpscalerTimer::mark(const DxvkContextObjects& ctx) {
+    if (!m_open || m_marks >= m_passes.size())
+      return;
+
+    uint32_t stride = uint32_t(m_passes.size() + 1u);
+
+    m_marks += 1u;
+    ctx.cmd->cmdWriteTimestamp(DxvkCmdBuffer::ExecBuffer,
+      VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, m_pool, m_slot * stride + m_marks);
+  }
+
+
+  void DxvkUpscalerTimer::end() {
+    if (!m_open)
+      return;
+
+    m_slotMarks[m_slot] = m_marks;
+    m_open = false;
+  }
+
+
+  void DxvkUpscalerTimer::collect(uint32_t slot) {
+    auto vk = m_device->vkd();
+
+    uint32_t stride = uint32_t(m_passes.size() + 1u);
+    uint32_t count = m_slotMarks[slot] + 1u;
+    m_slotMarks[slot] = 0u;
+
+    std::vector<uint64_t> ticks(count, 0u);
+
+    VkResult vr = vk->vkGetQueryPoolResults(vk->device(), m_pool, slot * stride, count,
+      sizeof(uint64_t) * count, ticks.data(), sizeof(uint64_t), VK_QUERY_RESULT_64_BIT);
+
+    // Not done yet: drop the sample rather than stall the frame
+    if (vr != VK_SUCCESS)
+      return;
+
+    for (uint32_t i = 1u; i < count; i++)
+      m_sums[i - 1u] += double(ticks[i] - ticks[i - 1u]) * m_msPerTick;
+
+    m_total += double(ticks[count - 1u] - ticks[0]) * m_msPerTick;
+
+    if (++m_samples < LogInterval)
+      return;
+
+    std::string line = str::format(m_tag, " GPU time over ", m_samples, " frames:");
+
+    for (size_t i = 0; i < m_passes.size(); i++) {
+      line += str::format(i ? ", " : " ", m_passes[i], " ", m_sums[i] / double(m_samples), " ms");
+      m_sums[i] = 0.0;
+    }
+
+    line += str::format(", total ", m_total / double(m_samples), " ms");
+    Logger::info(line);
+
+    m_total = 0.0;
+    m_samples = 0u;
+  }
