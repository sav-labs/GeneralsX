+  VkFormat DxvkFsr2::pickOutputFormat(const Rc<DxvkDevice>& device) {
+    VkFormatFeatureFlags2 required = VK_FORMAT_FEATURE_2_STORAGE_IMAGE_BIT
+      | VK_FORMAT_FEATURE_2_STORAGE_WRITE_WITHOUT_FORMAT_BIT
+      | VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_BIT
+      | VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_FILTER_LINEAR_BIT;
+
+    VkFormatFeatureFlags2 features = device->getFormatFeatures(VK_FORMAT_A2B10G10R10_UNORM_PACK32).optimal;
+
+    return (features & required) == required
+      ? VK_FORMAT_A2B10G10R10_UNORM_PACK32
+      : VK_FORMAT_R16G16B16A16_SFLOAT;
+  }
