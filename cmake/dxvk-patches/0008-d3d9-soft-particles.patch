+  void D3D9DeviceEx::CopySoftParticleDepth() {
+    D3D9Surface* ds = m_state.depthStencil.ptr();
+
+    if (ds == nullptr) {
+      m_softDepthImage = nullptr;
+      m_softDepthView = nullptr;
+      return;
     }
+
+    D3D9CommonTexture* dsTexture = ds->GetCommonTexture();
+    Rc<DxvkImage> srcImage = dsTexture->GetImage();
+    const DxvkImageCreateInfo& srcInfo = srcImage->info();
+    VkExtent3D extent = srcImage->mipLevelExtent(ds->GetMipLevel());
+
+    if (m_softDepthImage == nullptr
+     || m_softDepthImage->info().format != srcInfo.format
+     || m_softDepthImage->info().extent != extent) {
+      DxvkImageCreateInfo info = { };
+      info.type        = VK_IMAGE_TYPE_2D;
+      info.format      = srcInfo.format;
+      info.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+      info.extent      = extent;
+      info.numLayers   = 1;
+      info.mipLevels   = 1;
+      info.usage       = VK_IMAGE_USAGE_TRANSFER_DST_BIT
+                       | VK_IMAGE_USAGE_SAMPLED_BIT
+                       | VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT;
+      info.stages      = VK_PIPELINE_STAGE_TRANSFER_BIT
+                       | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT
+                       | VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT
+                       | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT;
+      info.access      = VK_ACCESS_TRANSFER_WRITE_BIT
+                       | VK_ACCESS_SHADER_READ_BIT
+                       | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT
+                       | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+      info.tiling      = VK_IMAGE_TILING_OPTIMAL;
+      info.layout      = VK_IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL;
+
+      m_softDepthImage = m_dxvkDevice->createImage(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+      DxvkImageViewKey viewKey = { };
+      viewKey.viewType   = VK_IMAGE_VIEW_TYPE_2D;
+      viewKey.format     = srcInfo.format;
+      viewKey.usage      = VK_IMAGE_USAGE_SAMPLED_BIT;
+      viewKey.aspects    = VK_IMAGE_ASPECT_DEPTH_BIT;
+      viewKey.mipIndex   = 0;
+      viewKey.mipCount   = 1;
+      viewKey.layerIndex = 0;
+      viewKey.layerCount = 1;
+
+      m_softDepthView = m_softDepthImage->createView(viewKey);
+
+      Logger::info(str::format("Soft particles: depth copy ", extent.width, "x", extent.height,
+        " (", srcInfo.sampleCount, " samples)"));
+    }
+
+    VkImageSubresourceLayers srcLayers = { };
+    srcLayers.aspectMask     = lookupFormatInfo(srcInfo.format)->aspectMask;
+    srcLayers.mipLevel       = ds->GetMipLevel();
+    srcLayers.baseArrayLayer = ds->GetFace();
+    srcLayers.layerCount     = 1;
+
+    VkImageSubresourceLayers dstLayers = srcLayers;
+    dstLayers.mipLevel       = 0;
+    dstLayers.baseArrayLayer = 0;
+
+    EmitCs([
+      cDstImage = m_softDepthImage,
+      cSrcImage = srcImage,
+      cSrcLayers = srcLayers,
+      cDstLayers = dstLayers,
+      cExtent    = extent
+    ] (DxvkContext* ctx) {
+      if (cSrcImage->info().sampleCount != VK_SAMPLE_COUNT_1_BIT) {
+        VkImageResolve region;
+        region.srcSubresource = cSrcLayers;
+        region.srcOffset      = VkOffset3D { 0, 0, 0 };
+        region.dstSubresource = cDstLayers;
+        region.dstOffset      = VkOffset3D { 0, 0, 0 };
+        region.extent         = cExtent;
+
+        ctx->resolveImage(cDstImage, cSrcImage, region, cSrcImage->info().format,
+          VK_RESOLVE_MODE_SAMPLE_ZERO_BIT, VK_RESOLVE_MODE_SAMPLE_ZERO_BIT);
+      } else {
+        ctx->copyImage(cDstImage, cDstLayers, VkOffset3D { 0, 0, 0 },
+          cSrcImage, cSrcLayers, VkOffset3D { 0, 0, 0 }, cExtent);
+      }
+    });
+
+    m_softParticleBound = false;
+  }
+
+
+  void D3D9DeviceEx::BindSoftParticleDepth() {
+    uint32_t slot = computeResourceSlotId(DxsoProgramType::PixelShader,
+      DxsoBindingType::Image, 7u);
+
+    DxvkSamplerKey key = { };
+    key.setFilter(VK_FILTER_NEAREST, VK_FILTER_NEAREST, VK_SAMPLER_MIPMAP_MODE_NEAREST);
+    key.setAddressModes(VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE);
+
+    EmitCs([
+      cSlot    = slot,
+      cView    = m_softDepthView,
+      cSampler = m_dxvkDevice->createSampler(key)
+    ] (DxvkContext* ctx) mutable {
+      VkShaderStageFlags stage = VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT;
+      ctx->bindResourceImageView(stage, cSlot, std::move(cView));
+      ctx->bindResourceSampler(stage, cSlot, std::move(cSampler));
+    });
+
+    m_softParticleBound = true;
   }
 
 
