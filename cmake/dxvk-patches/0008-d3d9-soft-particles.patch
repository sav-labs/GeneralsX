+  // GeneralsX: soft particles. Sampler 7 holds a copy of the scene depth
+  // taken before the particle pass. Both depths are turned back into view
+  // space distance with the projection terms and the particle fades out
+  // where it gets close to the geometry behind it.
+  uint32_t D3D9FFShaderCompiler::emitSoftParticleFade(uint32_t color) {
+    const uint32_t mode = m_fsKey.Stages[0].Contents.SoftParticle;
+
+    uint32_t int32Type = m_module.defIntType(32, 1);
+    uint32_t ivec2Type = m_module.defVectorType(int32Type, 2);
+
+    const auto& sampler = m_ps.samplers[7];
+    uint32_t sampledImage = m_module.opLoad(sampler.typeId, sampler.varId);
+    uint32_t imageType = m_module.defImageType(m_floatType,
+      spv::Dim2D, 0, 0, 0, 1, spv::ImageFormatUnknown);
+    uint32_t image = m_module.opImage(imageType, sampledImage);
+
+    std::array<uint32_t, 2> xy = { 0, 1 };
+    uint32_t fragXy = m_module.opVectorShuffle(m_vec2Type, m_ps.in.POS, m_ps.in.POS, xy.size(), xy.data());
+    uint32_t coord = m_module.opConvertFtoS(ivec2Type, fragXy);
+
+    SpirvImageOperands operands;
+    operands.flags = spv::ImageOperandsLodMask;
+    operands.sLod = m_module.consti32(0);
+    uint32_t sceneTexel = m_module.opImageFetch(m_vec4Type, image, coord, operands);
+
+    uint32_t idx = 0;
+    uint32_t sceneDepth = m_module.opCompositeExtract(m_floatType, sceneTexel, 1, &idx);
+    idx = 2;
+    uint32_t fragDepth = m_module.opCompositeExtract(m_floatType, m_ps.in.POS, 1, &idx);
+
+    idx = 0;
+    uint32_t p33 = m_module.opCompositeExtract(m_floatType, m_ps.constants.softParams, 1, &idx);
+    idx = 1;
+    uint32_t p43 = m_module.opCompositeExtract(m_floatType, m_ps.constants.softParams, 1, &idx);
+    idx = 2;
+    uint32_t invFade = m_module.opCompositeExtract(m_floatType, m_ps.constants.softParams, 1, &idx);
+
+    // view distance = _43 / (depth - _33), with _33 already multiplied by _34
+    uint32_t sceneZ = m_module.opFDiv(m_floatType, p43, m_module.opFSub(m_floatType, sceneDepth, p33));
+    uint32_t fragZ  = m_module.opFDiv(m_floatType, p43, m_module.opFSub(m_floatType, fragDepth, p33));
+
+    uint32_t fade = m_module.opFMul(m_floatType, m_module.opFSub(m_floatType, sceneZ, fragZ), invFade);
+    fade = m_module.opFClamp(m_floatType, fade, m_module.constf32(0.0f), m_module.constf32(1.0f));
+
+    // An empty depth copy (cleared to 1.0) means nothing behind the particle.
+    uint32_t farPlane = m_module.opFOrdGreaterThanEqual(m_module.defBoolType(), sceneDepth, m_module.constf32(1.0f));
+    fade = m_module.opSelect(m_floatType, farPlane, m_module.constf32(1.0f), fade);
+
+    if (mode == 1) {
+      idx = 3;
+      uint32_t alpha = m_module.opCompositeExtract(m_floatType, color, 1, &idx);
+      alpha = m_module.opFMul(m_floatType, alpha, fade);
+      return m_module.opCompositeInsert(m_vec4Type, alpha, color, 1, &idx);
+    }
+
+    uint32_t fadeVec = m_module.opCompositeConstruct(m_vec4Type, 4,
+      std::array<uint32_t, 4>{ fade, fade, fade, m_module.constf32(1.0f) }.data());
+
+    if (mode == 2)
+      return m_module.opFMul(m_vec4Type, color, fadeVec);
+
+    // Multiply blend: colour 1.0 leaves the destination untouched.
+    return m_module.opFMix(m_vec4Type, m_module.constvec4f32(1.0f, 1.0f, 1.0f, 1.0f), color, fadeVec);
+  }
