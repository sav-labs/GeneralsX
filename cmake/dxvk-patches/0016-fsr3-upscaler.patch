+  DxvkFsr3::~DxvkFsr3() {
+    destroyContext();
+
+    auto vk = m_device->vkd();
+
+    vk->vkDestroyPipeline(vk->device(), m_preparePipeline, nullptr);
+    vk->vkDestroyPipelineLayout(vk->device(), m_preparePipelineLayout, nullptr);
+    vk->vkDestroyDescriptorSetLayout(vk->device(), m_prepareSetLayout, nullptr);
+
+    vk->vkDestroyPipeline(vk->device(), m_compositePipeline, nullptr);
+    vk->vkDestroyPipelineLayout(vk->device(), m_compositePipelineLayout, nullptr);
+    vk->vkDestroyDescriptorSetLayout(vk->device(), m_compositeSetLayout, nullptr);
+  }
