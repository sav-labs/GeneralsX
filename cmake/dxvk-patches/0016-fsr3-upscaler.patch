+#pragma once
+
+// GeneralsX: renames the global symbols that the FidelityFX SDK shares
+// with the FidelityFX FSR 2 API sources. Both are linked into DXVK, so the
+// SDK's copies get a dxvk_fsr3_ prefix. Included by every SDK source, see
+// dxvk_fsr3_ffx_shim.h, and by DXVK code that calls the SDK.
+
+#define ffxAssertReport                           dxvk_fsr3_ffxAssertReport
+#define ffxAssertSetPrintingCallback              dxvk_fsr3_ffxAssertSetPrintingCallback
+#define ffxGetCommandListVK                       dxvk_fsr3_ffxGetCommandListVK
+#define ffxGetDeviceVK                            dxvk_fsr3_ffxGetDeviceVK
+#define addBarrier                                dxvk_fsr3_addBarrier
+#define flushBarriers                             dxvk_fsr3_flushBarriers
+#define setVKObjectName                           dxvk_fsr3_setVKObjectName
+#define findMemoryTypeIndex                       dxvk_fsr3_findMemoryTypeIndex
+#define getVKAccessFlagsFromResourceState         dxvk_fsr3_getVKAccessFlagsFromResourceState
+#define getVKImageLayoutFromResourceState         dxvk_fsr3_getVKImageLayoutFromResourceState
+#define getVKImageUsageFlagsFromResourceUsage     dxvk_fsr3_getVKImageUsageFlagsFromResourceUsage
+#define getVKPipelineStageFlagsFromResourceState  dxvk_fsr3_getVKPipelineStageFlagsFromResourceState
+#define BackendContext_VK                         DxvkFsr3BackendContextVK
diff --git a/src/dxvk/fsr3/dxvk_fsr3_ffx_shim.cpp b/src/dxvk/fsr3/dxvk_fsr3_ffx_shim.cpp
new file mode 100644
--- /dev/null
+++ b/src/dxvk/fsr3/dxvk_fsr3_ffx_shim.cpp
@@ -0,0 +1,215 @@
+// GeneralsX: Vulkan functions for the FidelityFX SDK Vulkan backend, see
+// dxvk_fsr3_ffx_shim.h. The function table is set by DxvkFsr3 before it
+// creates the SDK backend interface.
+
+#include "dxvk_fsr3_ffx_shim.h"
+#include "dxvk_fsr3_ffx_table.h"
+
+#include <FidelityFX/host/backends/vk/ffx_vk.h>
+
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+DxvkFsr3VkTable g_dxvkFsr3Vk = { };
+
+static std::mutex               g_dxvkFsr3ViewMutex;
+static std::vector<VkImageView> g_dxvkFsr3ReleasedViews;
+
+
+void dxvkFsr3TakeReleasedViews(std::vector<VkImageView>& views) {
+  std::lock_guard lock(g_dxvkFsr3ViewMutex);
+  views.insert(views.end(), g_dxvkFsr3ReleasedViews.begin(), g_dxvkFsr3ReleasedViews.end());
+  g_dxvkFsr3ReleasedViews.clear();
+}
+
+extern "C" {
+
+  // DXVK does not enable shaderFloat16, subgroup size control, ray tracing
+  // or AMD buffer markers on its device, so the backend must not pick FP16
+  // or forced wave64 pipelines, nor use the extensions. Hiding them makes
+  // it use the 32-bit default permutations that DXVK compiles.
+  static bool dxvkFsr3HiddenExtension(const char* name) {
+    return !std::strcmp(name, VK_KHR_SHADER_FLOAT16_INT8_EXTENSION_NAME)
+        || !std::strcmp(name, VK_EXT_SUBGROUP_SIZE_CONTROL_EXTENSION_NAME)
+        || !std::strcmp(name, VK_KHR_ACCELERATION_STRUCTURE_EXTENSION_NAME)
+        || !std::strcmp(name, VK_AMD_BUFFER_MARKER_EXTENSION_NAME)
+        || !std::strcmp(name, VK_AMD_DEVICE_COHERENT_MEMORY_EXTENSION_NAME);
+  }
+
+
+  VKAPI_ATTR VkResult VKAPI_CALL dxvk_fsr3_vkCreateBuffer(
+          VkDevice                          device,
+    const VkBufferCreateInfo*               pCreateInfo,
+    const VkAllocationCallbacks*            pAllocator,
+          VkBuffer*                         pBuffer) {
+    return g_dxvkFsr3Vk.createBuffer(device, pCreateInfo, pAllocator, pBuffer);
+  }
+
+
+  VKAPI_ATTR VkResult VKAPI_CALL dxvk_fsr3_vkEnumerateDeviceExtensionProperties(
+          VkPhysicalDevice                  physicalDevice,
+    const char*                             pLayerName,
+          uint32_t*                         pPropertyCount,
+          VkExtensionProperties*            pProperties) {
+    uint32_t count = 0;
+    VkResult vr = g_dxvkFsr3Vk.enumerateDeviceExtensionProperties(physicalDevice, pLayerName, &count, nullptr);
+
+    if (vr != VK_SUCCESS)
+      return vr;
+
+    std::vector<VkExtensionProperties> all(count);
+    vr = g_dxvkFsr3Vk.enumerateDeviceExtensionProperties(physicalDevice, pLayerName, &count, all.data());
+
+    if (vr < 0)
+      return vr;
+
+    uint32_t visible = 0;
+
+    for (uint32_t i = 0; i < count; i++) {
+      if (dxvkFsr3HiddenExtension(all[i].extensionName))
+        continue;
+
+      if (pProperties) {
+        if (visible >= *pPropertyCount)
+          return VK_INCOMPLETE;
+
+        pProperties[visible] = all[i];
+      }
+
+      visible++;
+    }
+
+    *pPropertyCount = visible;
+    return VK_SUCCESS;
+  }
+
+
+  VKAPI_ATTR void VKAPI_CALL dxvk_fsr3_vkGetPhysicalDeviceMemoryProperties(
+          VkPhysicalDevice                  physicalDevice,
+          VkPhysicalDeviceMemoryProperties* pMemoryProperties) {
+    g_dxvkFsr3Vk.getPhysicalDeviceMemoryProperties(physicalDevice, pMemoryProperties);
+
+    // As for FSR 2: the backend only places its textures in a device-local
+    // memory type that is not host-visible. Integrated GPUs may only expose
+    // device-local memory that is also host-visible; report those types as
+    // device-local only, as long as another host-visible type remains for
+    // the constant buffers.
+    bool hasHiddenLocal = false;
+    bool hasHostOnly = false;
+
+    for (uint32_t i = 0; i < pMemoryProperties->memoryTypeCount; i++) {
+      VkMemoryPropertyFlags flags = pMemoryProperties->memoryTypes[i].propertyFlags;
+
+      if ((flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) && !(flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+        hasHiddenLocal = true;
+
+      if (!(flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) && (flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+        hasHostOnly = true;
+    }
+
+    if (hasHiddenLocal || !hasHostOnly)
+      return;
+
+    for (uint32_t i = 0; i < pMemoryProperties->memoryTypeCount; i++) {
+      VkMemoryPropertyFlags& flags = pMemoryProperties->memoryTypes[i].propertyFlags;
+
+      if (flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
+        flags &= ~(VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT);
+    }
+  }
+
+
+  VKAPI_ATTR void VKAPI_CALL dxvk_fsr3_vkGetPhysicalDeviceProperties(
+          VkPhysicalDevice                  physicalDevice,
+          VkPhysicalDeviceProperties*       pProperties) {
+    g_dxvkFsr3Vk.getPhysicalDeviceProperties(physicalDevice, pProperties);
+  }
+
+
+  VKAPI_ATTR void VKAPI_CALL dxvk_fsr3_vkGetPhysicalDeviceProperties2(
+          VkPhysicalDevice                  physicalDevice,
+          VkPhysicalDeviceProperties2*      pProperties) {
+    g_dxvkFsr3Vk.getPhysicalDeviceProperties2(physicalDevice, pProperties);
+  }
+
+
+  VKAPI_ATTR void VKAPI_CALL dxvk_fsr3_vkGetPhysicalDeviceFeatures(
+          VkPhysicalDevice                  physicalDevice,
+          VkPhysicalDeviceFeatures*         pFeatures) {
+    g_dxvkFsr3Vk.getPhysicalDeviceFeatures(physicalDevice, pFeatures);
+  }
+
+
+  VKAPI_ATTR void VKAPI_CALL dxvk_fsr3_vkGetPhysicalDeviceFeatures2(
+          VkPhysicalDevice                  physicalDevice,
+          VkPhysicalDeviceFeatures2*        pFeatures) {
+    g_dxvkFsr3Vk.getPhysicalDeviceFeatures2(physicalDevice, pFeatures);
+  }
+
+
+  // Keeps a view the backend releases until DxvkFsr3 knows that the GPU
+  // no longer uses it, see dxvkFsr3TakeReleasedViews
+  static VKAPI_ATTR void VKAPI_CALL dxvk_fsr3_vkDestroyImageView(
+          VkDevice                          device,
+          VkImageView                       imageView,
+    const VkAllocationCallbacks*            pAllocator) {
+    (void)device;
+    (void)pAllocator;
+
+    if (imageView == VK_NULL_HANDLE)
+      return;
+
+    std::lock_guard lock(g_dxvkFsr3ViewMutex);
+    g_dxvkFsr3ReleasedViews.push_back(imageView);
+  }
+
+
+  // Functions of extensions DXVK does not enable on its device. Drivers
+  // may still return them; calling them is invalid, so the backend gets
+  // NULL and skips its debug labels, object names and breadcrumb markers.
+  static bool dxvkFsr3HiddenFunction(const char* name) {
+    return !std::strcmp(name, "vkCmdBeginDebugUtilsLabelEXT")
+        || !std::strcmp(name, "vkCmdEndDebugUtilsLabelEXT")
+        || !std::strcmp(name, "vkSetDebugUtilsObjectNameEXT")
+        || !std::strcmp(name, "vkCmdWriteBufferMarkerAMD")
+        || !std::strcmp(name, "vkCmdWriteBufferMarker2AMD");
+  }
+
+  // The backend asks for some core Vulkan 1.1+ functions by their KHR
+  // names, such as vkGetBufferMemoryRequirements2KHR. DXVK's device does
+  // not enable those extensions, so look up the core name instead.
+  VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL dxvk_fsr3_vkGetDeviceProcAddr(
+          VkDevice                          device,
+    const char*                             pName) {
+    if (!std::strcmp(pName, "vkDestroyImageView"))
+      return reinterpret_cast<PFN_vkVoidFunction>(&dxvk_fsr3_vkDestroyImageView);
+
+    if (dxvkFsr3HiddenFunction(pName))
+      return nullptr;
+
+    PFN_vkVoidFunction fn = g_dxvkFsr3Vk.getDeviceProcAddr(device, pName);
+
+    if (!fn) {
+      size_t length = std::strlen(pName);
+
+      if (length > 3u && !std::strcmp(pName + length - 3u, "KHR")) {
+        std::string core(pName, length - 3u);
+        fn = g_dxvkFsr3Vk.getDeviceProcAddr(device, core.c_str());
+      }
+    }
+
+    return fn;
+  }
+
+}
+
+
+// The backend hands this function to the SDK's frame interpolation swap
+// chain. DXVK presents generated frames itself and never creates that swap
+// chain, so a configuration request is refused.
+FfxErrorCode ffxSetFrameGenerationConfigToSwapchainVK(FfxFrameGenerationConfig const* config) {
+  (void)config;
+  return FFX_ERROR_INVALID_ARGUMENT;
+}
