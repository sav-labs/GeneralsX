@@ -0,0 +1,29 @@
+#pragma once
+
+// GeneralsX: force-included into the FidelityFX SDK sources.
+//
+// The SDK's Vulkan backend calls a few Vulkan functions through the global
+// loader symbols. DXVK loads Vulkan at run time and does not link against
+// the loader, so these calls are redirected to functions that use DXVK's
+// function tables instead, see dxvk_fsr3_ffx_shim.cpp.
+
+// The SDK is written against MSVC, whose headers pull these in implicitly
+#ifdef __cplusplus
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <cwchar>
+#include <locale>
+#include <new>
+#endif
+
+#include "dxvk_fsr3_ffx_names.h"
+
+#define vkCreateBuffer                       dxvk_fsr3_vkCreateBuffer
+#define vkEnumerateDeviceExtensionProperties dxvk_fsr3_vkEnumerateDeviceExtensionProperties
+#define vkGetPhysicalDeviceMemoryProperties  dxvk_fsr3_vkGetPhysicalDeviceMemoryProperties
+#define vkGetPhysicalDeviceProperties        dxvk_fsr3_vkGetPhysicalDeviceProperties
+#define vkGetPhysicalDeviceProperties2       dxvk_fsr3_vkGetPhysicalDeviceProperties2
+#define vkGetPhysicalDeviceFeatures          dxvk_fsr3_vkGetPhysicalDeviceFeatures
+#define vkGetPhysicalDeviceFeatures2         dxvk_fsr3_vkGetPhysicalDeviceFeatures2
+#define vkGetDeviceProcAddr                  dxvk_fsr3_vkGetDeviceProcAddr
diff --git a/src/dxvk/fsr3/dxvk_fsr3_ffx_table.h b/src/dxvk/fsr3/dxvk_fsr3_ffx_table.h
new file mode 100644
--- /dev/null
+++ b/src/dxvk/fsr3/dxvk_fsr3_ffx_table.h
@@ -0,0 +1,52 @@
+#pragma once
+
+// GeneralsX: Vulkan functions used by the FidelityFX SDK backend shim.
+// Plain Vulkan types only, so that both the SDK sources and DXVK can
+// include it.
+
+#include <vulkan/vulkan.h>
+
+struct DxvkFsr3VkTable {
+  PFN_vkCreateBuffer                       createBuffer;
+  PFN_vkEnumerateDeviceExtensionProperties enumerateDeviceExtensionProperties;
+  PFN_vkGetPhysicalDeviceMemoryProperties  getPhysicalDeviceMemoryProperties;
+  PFN_vkGetPhysicalDeviceProperties        getPhysicalDeviceProperties;
+  PFN_vkGetPhysicalDeviceProperties2       getPhysicalDeviceProperties2;
+  PFN_vkGetPhysicalDeviceFeatures          getPhysicalDeviceFeatures;
+  PFN_vkGetPhysicalDeviceFeatures2         getPhysicalDeviceFeatures2;
+  PFN_vkGetDeviceProcAddr                  getDeviceProcAddr;
+};
+
+extern DxvkFsr3VkTable g_dxvkFsr3Vk;
+
+/**
+ * \brief Device function lookup of the shim
+ *
+ * GeneralsX: must be the backend's VkDeviceContext::vkDeviceProcAddr.
+ * It maps the KHR names of core functions, keeps released image views
+ * alive and hides functions of extensions DXVK does not enable. The plain
+ * device lookup returns NULL for vkGetBufferMemoryRequirements2KHR, which
+ * the backend then calls while it creates its first context.
+ */
+#ifdef __cplusplus
+extern "C"
+#endif
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL dxvk_fsr3_vkGetDeviceProcAddr(
+        VkDevice                          device,
+  const char*                             pName);
+
+#ifdef __cplusplus
+#include <vector>
+
+/**
+ * \brief Takes the image views the backend has released
+ *
+ * The backend destroys the views of the resources a dispatch registered
+ * a fixed number of dispatches later, which assumes that the GPU is done
+ * with them by then. Under DXVK one frame can hold several dispatches of
+ * an effect and several frames can be in flight, so the shim keeps the
+ * views instead, and DxvkFsr3 destroys them once the command list that
+ * recorded the releasing dispatch has finished.
+ */
+void dxvkFsr3TakeReleasedViews(std::vector<VkImageView>& views);
+#endif
diff --git a/src/dxvk/fsr3/dxvk_fsr3_shaders.cpp b/src/dxvk/fsr3/dxvk_fsr3_shaders.cpp
new file mode 100644
--- /dev/null
+++ b/src/dxvk/fsr3/dxvk_fsr3_shaders.cpp
@@ -0,0 +1,500 @@
+// GeneralsX: SPIR-V permutations of the FidelityFX SDK passes of FSR 3:
+// the FSR 3.1 upscaler, frame interpolation and optical flow.
+//
+// Replaces the SDK's blob accessors (src/backends/shared/blob_accessors),
+// whose tables are generated by AMD's Windows-only FidelityFX_SC tool. The
+// passes are compiled with glslang at build time (see meson.build) for the
+// options DXVK uses: LDR colour, render-resolution motion vectors without
+// jitter, standard depth and 32-bit maths without forced wave64. Only the
+// reprojection Lanczos type and, for the upscaler's accumulate pass, the
+// sharpening switch vary. The resource names and bindings the backend
+// needs are read from the SPIR-V itself.
+
+#include "dxvk_fsr3_ffx_shim.h"
+
+#include <FidelityFX/host/ffx_fsr3upscaler.h>
+#include <FidelityFX/host/ffx_frameinterpolation.h>
+#include <FidelityFX/host/ffx_opticalflow.h>
+
+#include "ffx-sdk/src/backends/shared/ffx_shader_blobs.h"
+
+#include <array>
+#include <atomic>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <dxvk_fsr3_up_accumulate_l0_s0.h>
+#include <dxvk_fsr3_up_accumulate_l0_s1.h>
+#include <dxvk_fsr3_up_accumulate_l1_s0.h>
+#include <dxvk_fsr3_up_accumulate_l1_s1.h>
+#include <dxvk_fsr3_up_autogen_reactive_l0_s0.h>
+#include <dxvk_fsr3_up_autogen_reactive_l1_s0.h>
+#include <dxvk_fsr3_up_debug_view_l0_s0.h>
+#include <dxvk_fsr3_up_debug_view_l1_s0.h>
+#include <dxvk_fsr3_up_luma_instability_l0_s0.h>
+#include <dxvk_fsr3_up_luma_instability_l1_s0.h>
+#include <dxvk_fsr3_up_luma_pyramid_l0_s0.h>
+#include <dxvk_fsr3_up_luma_pyramid_l1_s0.h>
+#include <dxvk_fsr3_up_prepare_inputs_l0_s0.h>
+#include <dxvk_fsr3_up_prepare_inputs_l1_s0.h>
+#include <dxvk_fsr3_up_prepare_reactivity_l0_s0.h>
+#include <dxvk_fsr3_up_prepare_reactivity_l1_s0.h>
+#include <dxvk_fsr3_up_rcas_l0_s0.h>
+#include <dxvk_fsr3_up_rcas_l1_s0.h>
+#include <dxvk_fsr3_up_shading_change_l0_s0.h>
+#include <dxvk_fsr3_up_shading_change_l1_s0.h>
+#include <dxvk_fsr3_up_shading_change_pyramid_l0_s0.h>
+#include <dxvk_fsr3_up_shading_change_pyramid_l1_s0.h>
+
+#include <dxvk_fsr3_fi_compute_game_vector_field_inpainting_pyramid.h>
+#include <dxvk_fsr3_fi_compute_inpainting_pyramid.h>
+#include <dxvk_fsr3_fi_debug_view.h>
+#include <dxvk_fsr3_fi_disocclusion_mask.h>
+#include <dxvk_fsr3_fi_game_motion_vector_field.h>
+#include <dxvk_fsr3_fi_inpainting.h>
+#include <dxvk_fsr3_fi_optical_flow_vector_field.h>
+#include <dxvk_fsr3_fi_interpolation.h>
+#include <dxvk_fsr3_fi_reconstruct_and_dilate.h>
+#include <dxvk_fsr3_fi_reconstruct_previous_depth.h>
+#include <dxvk_fsr3_fi_setup.h>
+
+#include <dxvk_fsr3_of_compute_luminance_pyramid.h>
+#include <dxvk_fsr3_of_compute_optical_flow_advanced_v5.h>
+#include <dxvk_fsr3_of_compute_scd_divergence.h>
+#include <dxvk_fsr3_of_filter_optical_flow_v5.h>
+#include <dxvk_fsr3_of_generate_scd_histogram.h>
+#include <dxvk_fsr3_of_prepare_luma.h>
+#include <dxvk_fsr3_of_scale_optical_flow_advanced_v5.h>
+
+/// Permutation options the build does not provide, see dxvk_fsr3.cpp
+std::atomic<uint32_t> g_dxvkFsr3PermutationMismatch = { 0u };
+
+namespace {
+
+  // Permutation bits of the SDK components, from the components' private
+  // headers (ffx_fsr3upscaler_private.h, ffx_frameinterpolation_private.h,
+  // ffx_opticalflow_private.h)
+  constexpr uint32_t UpscalerLanczosLut  = 1u << 0;
+  constexpr uint32_t UpscalerLowResMv    = 1u << 2;
+  constexpr uint32_t UpscalerSharpen     = 1u << 5;
+  constexpr uint32_t UpscalerKnown       = UpscalerLanczosLut | UpscalerLowResMv | UpscalerSharpen;
+
+  constexpr uint32_t FiLowResMv          = 1u << 0;
+  constexpr uint32_t FiKnown             = FiLowResMv;
+
+  constexpr uint32_t OfKnown             = 0u;
+
+  struct Fsr3SpirvCode {
+    const uint32_t* code;
+    size_t          size;
+  };
+
+  enum Fsr3ResourceKind : uint32_t {
+    Fsr3ConstantBuffer = 0,
+    Fsr3SrvTexture     = 1,
+    Fsr3UavTexture     = 2,
+    Fsr3SrvBuffer      = 3,
+    Fsr3UavBuffer      = 4,
+    Fsr3KindCount      = 5,
+  };
+
+  struct Fsr3ReflectedBlob {
+    std::vector<std::string>  names[Fsr3KindCount];
+    std::vector<const char*>  namePtrs[Fsr3KindCount];
+    std::vector<uint32_t>     bindings[Fsr3KindCount];
+    std::vector<uint32_t>     counts[Fsr3KindCount];
+    std::vector<uint32_t>     spaces[Fsr3KindCount];
+    bool                      valid = false;
+  };
+
+  constexpr uint32_t SpvOpName            = 5;
+  constexpr uint32_t SpvOpMemberName      = 6;
+  constexpr uint32_t SpvOpEntryPoint      = 15;
+  constexpr uint32_t SpvOpTypeImage       = 25;
+  constexpr uint32_t SpvOpTypeStruct      = 30;
+  constexpr uint32_t SpvOpTypePointer     = 32;
+  constexpr uint32_t SpvOpVariable        = 59;
+  constexpr uint32_t SpvOpDecorate        = 71;
+  constexpr uint32_t SpvOpMemberDecorate  = 72;
+
+  constexpr uint32_t SpvDecorationNonWritable   = 24;
+  constexpr uint32_t SpvDecorationBinding       = 33;
+  constexpr uint32_t SpvDecorationDescriptorSet = 34;
+
+  constexpr uint32_t SpvStorageClassUniformConstant = 0;
+  constexpr uint32_t SpvStorageClassUniform         = 2;
+  constexpr uint32_t SpvStorageClassStorageBuffer   = 12;
+
+  /// Static samplers start at this binding, see SAMPLER_BINDING_SHIFT
+  constexpr int32_t  SamplerBindingShift = 1000;
+
+  /**
+   * \brief Lists the descriptor set 0 resources of a pass
+   *
+   * The samplers at binding 1000 and above are created and bound by the
+   * backend itself. As for FSR 2, only resources that some instruction
+   * refers to are listed: glslang keeps declared but unused resources,
+   * which the backend would leave as empty descriptors.
+   */
+  void reflectSpirv(const Fsr3SpirvCode& spirv, Fsr3ReflectedBlob& out) {
+    const uint32_t* words = spirv.code;
+    size_t count = spirv.size / sizeof(uint32_t);
+
+    if (count < 5u)
+      return;
+
+    uint32_t bound = words[3];
+
+    std::vector<std::string> names(bound);
+    std::vector<int32_t>     bindings(bound, -1);
+    std::vector<int32_t>     sets(bound, -1);
+    std::vector<int32_t>     imageSampled(bound, -1);
+    std::vector<uint32_t>    structMembers(bound, 0u);
+    std::vector<uint32_t>    nonWritableMembers(bound, 0u);
+    std::vector<bool>        nonWritable(bound, false);
+    std::vector<bool>        isStruct(bound, false);
+    std::vector<uint32_t>    pointee(bound, 0u);
+    std::vector<bool>        referenced(bound, false);
+
+    struct Variable {
+      uint32_t id;
+      uint32_t type;
+      uint32_t storageClass;
+    };
+
+    std::vector<Variable> variables;
+
+    for (size_t i = 5u; i < count; ) {
+      uint32_t opcode = words[i] & 0xffffu;
+      uint32_t length = words[i] >> 16u;
+
+      if (!length || i + length > count)
+        return;
+
+      const uint32_t* ins = &words[i];
+
+      switch (opcode) {
+        case SpvOpName:
+          if (length > 2u && ins[1] < bound)
+            names[ins[1]] = reinterpret_cast<const char*>(&ins[2]);
+          break;
+
+        case SpvOpDecorate:
+          if (length > 2u && ins[1] < bound) {
+            if (ins[2] == SpvDecorationBinding && length > 3u)
+              bindings[ins[1]] = int32_t(ins[3]);
+            else if (ins[2] == SpvDecorationDescriptorSet && length > 3u)
+              sets[ins[1]] = int32_t(ins[3]);
+            else if (ins[2] == SpvDecorationNonWritable)
+              nonWritable[ins[1]] = true;
+          }
+          break;
+
+        case SpvOpMemberDecorate:
+          if (length > 3u && ins[1] < bound && ins[3] == SpvDecorationNonWritable)
+            nonWritableMembers[ins[1]] += 1u;
+          break;
+
+        case SpvOpTypeImage:
+          if (length > 7u && ins[1] < bound)
+            imageSampled[ins[1]] = int32_t(ins[7]);
+          break;
+
+        case SpvOpTypeStruct:
+          if (length > 1u && ins[1] < bound) {
+            isStruct[ins[1]] = true;
+            structMembers[ins[1]] = length - 2u;
+          }
+          break;
+
+        case SpvOpTypePointer:
+          if (length > 3u && ins[1] < bound)
+            pointee[ins[1]] = ins[3];
+          break;
+
+        case SpvOpVariable:
+          if (length > 3u && ins[2] < bound)
+            variables.push_back({ ins[2], ins[1], ins[3] });
+          break;
+
+        default:
+          break;
+      }
+
+      if (opcode != SpvOpName && opcode != SpvOpMemberName && opcode != SpvOpDecorate
+       && opcode != SpvOpMemberDecorate && opcode != SpvOpEntryPoint && opcode != SpvOpVariable) {
+        for (uint32_t w = 1u; w < length; w++) {
+          if (ins[w] < bound)
+            referenced[ins[w]] = true;
+        }
+      }
+
+      i += length;
+    }
+
+    for (const auto& var : variables) {
+      if (sets[var.id] != 0 || bindings[var.id] < 0 || bindings[var.id] >= SamplerBindingShift
+       || var.type >= bound || !referenced[var.id])
+        continue;
+
+      uint32_t type = pointee[var.type];
+
+      if (type >= bound)
+        continue;
+
+      int32_t kind = -1;
+
+      if (var.storageClass == SpvStorageClassUniformConstant && imageSampled[type] == 2)
+        kind = Fsr3UavTexture;
+      else if (var.storageClass == SpvStorageClassUniformConstant && imageSampled[type] == 1)
+        kind = Fsr3SrvTexture;
+      else if (var.storageClass == SpvStorageClassUniform && isStruct[type])
+        kind = Fsr3ConstantBuffer;
+      else if (var.storageClass == SpvStorageClassStorageBuffer && isStruct[type]) {
+        bool readOnly = nonWritable[var.id]
+          || (structMembers[type] && nonWritableMembers[type] >= structMembers[type]);
+        kind = readOnly ? Fsr3SrvBuffer : Fsr3UavBuffer;
+      }
+
+      if (kind < 0)
+        continue;
+
+      out.names[kind].push_back(names[var.id]);
+      out.bindings[kind].push_back(uint32_t(bindings[var.id]));
+      out.counts[kind].push_back(1u);
+      out.spaces[kind].push_back(0u);
+    }
+
+    for (uint32_t k = 0; k < Fsr3KindCount; k++) {
+      for (const auto& name : out.names[k])
+        out.namePtrs[k].push_back(name.c_str());
+    }
+
+    out.valid = true;
+  }
+
+
+  FfxShaderBlob makeBlob(const Fsr3SpirvCode& spirv, Fsr3ReflectedBlob& r) {
+    return FfxShaderBlob {
+      reinterpret_cast<const uint8_t*>(spirv.code),
+      uint32_t(spirv.size),
+      uint32_t(r.names[Fsr3ConstantBuffer].size()),
+      uint32_t(r.names[Fsr3SrvTexture].size()),
+      uint32_t(r.names[Fsr3UavTexture].size()),
+      uint32_t(r.names[Fsr3SrvBuffer].size()),
+      uint32_t(r.names[Fsr3UavBuffer].size()),
+      0u, 0u,
+      r.namePtrs[Fsr3ConstantBuffer].data(), r.bindings[Fsr3ConstantBuffer].data(),
+      r.counts[Fsr3ConstantBuffer].data(), r.spaces[Fsr3ConstantBuffer].data(),
+      r.namePtrs[Fsr3SrvTexture].data(), r.bindings[Fsr3SrvTexture].data(),
+      r.counts[Fsr3SrvTexture].data(), r.spaces[Fsr3SrvTexture].data(),
+      r.namePtrs[Fsr3UavTexture].data(), r.bindings[Fsr3UavTexture].data(),
+      r.counts[Fsr3UavTexture].data(), r.spaces[Fsr3UavTexture].data(),
+      r.namePtrs[Fsr3SrvBuffer].data(), r.bindings[Fsr3SrvBuffer].data(),
+      r.counts[Fsr3SrvBuffer].data(), r.spaces[Fsr3SrvBuffer].data(),
+      r.namePtrs[Fsr3UavBuffer].data(), r.bindings[Fsr3UavBuffer].data(),
+      r.counts[Fsr3UavBuffer].data(), r.spaces[Fsr3UavBuffer].data(),
+      nullptr, nullptr, nullptr, nullptr,
+      nullptr, nullptr, nullptr, nullptr,
+    };
+  }
+
+
+#define DXVK_FSR3_SPIRV(name) Fsr3SpirvCode { name, sizeof(name) }
+
+  Fsr3SpirvCode getUpscalerSpirv(FfxFsr3UpscalerPass pass, bool lanczos, bool sharpen) {
+    switch (pass) {
+      case FFX_FSR3UPSCALER_PASS_PREPARE_INPUTS:
+        return lanczos ? DXVK_FSR3_SPIRV(dxvk_fsr3_up_prepare_inputs_l1_s0)
+                       : DXVK_FSR3_SPIRV(dxvk_fsr3_up_prepare_inputs_l0_s0);
+      case FFX_FSR3UPSCALER_PASS_LUMA_PYRAMID:
+        return lanczos ? DXVK_FSR3_SPIRV(dxvk_fsr3_up_luma_pyramid_l1_s0)
+                       : DXVK_FSR3_SPIRV(dxvk_fsr3_up_luma_pyramid_l0_s0);
+      case FFX_FSR3UPSCALER_PASS_SHADING_CHANGE_PYRAMID:
+        return lanczos ? DXVK_FSR3_SPIRV(dxvk_fsr3_up_shading_change_pyramid_l1_s0)
+                       : DXVK_FSR3_SPIRV(dxvk_fsr3_up_shading_change_pyramid_l0_s0);
+      case FFX_FSR3UPSCALER_PASS_SHADING_CHANGE:
+        return lanczos ? DXVK_FSR3_SPIRV(dxvk_fsr3_up_shading_change_l1_s0)
+                       : DXVK_FSR3_SPIRV(dxvk_fsr3_up_shading_change_l0_s0);
+      case FFX_FSR3UPSCALER_PASS_PREPARE_REACTIVITY:
+        return lanczos ? DXVK_FSR3_SPIRV(dxvk_fsr3_up_prepare_reactivity_l1_s0)
+                       : DXVK_FSR3_SPIRV(dxvk_fsr3_up_prepare_reactivity_l0_s0);
+      case FFX_FSR3UPSCALER_PASS_LUMA_INSTABILITY:
+        return lanczos ? DXVK_FSR3_SPIRV(dxvk_fsr3_up_luma_instability_l1_s0)
+                       : DXVK_FSR3_SPIRV(dxvk_fsr3_up_luma_instability_l0_s0);
+      case FFX_FSR3UPSCALER_PASS_ACCUMULATE:
+      case FFX_FSR3UPSCALER_PASS_ACCUMULATE_SHARPEN:
+        if (sharpen)
+          return lanczos ? DXVK_FSR3_SPIRV(dxvk_fsr3_up_accumulate_l1_s1)
+                         : DXVK_FSR3_SPIRV(dxvk_fsr3_up_accumulate_l0_s1);
+        return lanczos ? DXVK_FSR3_SPIRV(dxvk_fsr3_up_accumulate_l1_s0)
+                       : DXVK_FSR3_SPIRV(dxvk_fsr3_up_accumulate_l0_s0);
+      case FFX_FSR3UPSCALER_PASS_RCAS:
+        return lanczos ? DXVK_FSR3_SPIRV(dxvk_fsr3_up_rcas_l1_s0)
+                       : DXVK_FSR3_SPIRV(dxvk_fsr3_up_rcas_l0_s0);
+      case FFX_FSR3UPSCALER_PASS_DEBUG_VIEW:
+        return lanczos ? DXVK_FSR3_SPIRV(dxvk_fsr3_up_debug_view_l1_s0)
+                       : DXVK_FSR3_SPIRV(dxvk_fsr3_up_debug_view_l0_s0);
+      case FFX_FSR3UPSCALER_PASS_GENERATE_REACTIVE:
+        return lanczos ? DXVK_FSR3_SPIRV(dxvk_fsr3_up_autogen_reactive_l1_s0)
+                       : DXVK_FSR3_SPIRV(dxvk_fsr3_up_autogen_reactive_l0_s0);
+      default:
+        return Fsr3SpirvCode { nullptr, 0u };
+    }
+  }
+
+
+  Fsr3SpirvCode getFrameInterpolationSpirv(FfxFrameInterpolationPass pass) {
+    switch (pass) {
+      case FFX_FRAMEINTERPOLATION_PASS_RECONSTRUCT_AND_DILATE:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_fi_reconstruct_and_dilate);
+      case FFX_FRAMEINTERPOLATION_PASS_SETUP:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_fi_setup);
+      case FFX_FRAMEINTERPOLATION_PASS_RECONSTRUCT_PREV_DEPTH:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_fi_reconstruct_previous_depth);
+      case FFX_FRAMEINTERPOLATION_PASS_GAME_MOTION_VECTOR_FIELD:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_fi_game_motion_vector_field);
+      case FFX_FRAMEINTERPOLATION_PASS_OPTICAL_FLOW_VECTOR_FIELD:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_fi_optical_flow_vector_field);
+      case FFX_FRAMEINTERPOLATION_PASS_DISOCCLUSION_MASK:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_fi_disocclusion_mask);
+      case FFX_FRAMEINTERPOLATION_PASS_INTERPOLATION:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_fi_interpolation);
+      case FFX_FRAMEINTERPOLATION_PASS_INPAINTING_PYRAMID:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_fi_compute_inpainting_pyramid);
+      case FFX_FRAMEINTERPOLATION_PASS_INPAINTING:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_fi_inpainting);
+      case FFX_FRAMEINTERPOLATION_PASS_GAME_VECTOR_FIELD_INPAINTING_PYRAMID:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_fi_compute_game_vector_field_inpainting_pyramid);
+      case FFX_FRAMEINTERPOLATION_PASS_DEBUG_VIEW:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_fi_debug_view);
+      default:
+        return Fsr3SpirvCode { nullptr, 0u };
+    }
+  }
+
+
+  Fsr3SpirvCode getOpticalFlowSpirv(FfxOpticalflowPass pass) {
+    switch (pass) {
+      case FFX_OPTICALFLOW_PASS_PREPARE_LUMA:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_of_prepare_luma);
+      case FFX_OPTICALFLOW_PASS_GENERATE_OPTICAL_FLOW_INPUT_PYRAMID:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_of_compute_luminance_pyramid);
+      case FFX_OPTICALFLOW_PASS_GENERATE_SCD_HISTOGRAM:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_of_generate_scd_histogram);
+      case FFX_OPTICALFLOW_PASS_COMPUTE_SCD_DIVERGENCE:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_of_compute_scd_divergence);
+      case FFX_OPTICALFLOW_PASS_COMPUTE_OPTICAL_FLOW_ADVANCED_V5:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_of_compute_optical_flow_advanced_v5);
+      case FFX_OPTICALFLOW_PASS_FILTER_OPTICAL_FLOW_V5:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_of_filter_optical_flow_v5);
+      case FFX_OPTICALFLOW_PASS_SCALE_OPTICAL_FLOW_ADVANCED_V5:
+        return DXVK_FSR3_SPIRV(dxvk_fsr3_of_scale_optical_flow_advanced_v5);
+      default:
+        return Fsr3SpirvCode { nullptr, 0u };
+    }
+  }
+
+#undef DXVK_FSR3_SPIRV
+
+  /// Upscaler: pass, Lanczos type, sharpening. Frame interpolation and
+  /// optical flow: pass only.
+  constexpr uint32_t UpscalerSlots = FFX_FSR3UPSCALER_PASS_COUNT * 4u;
+  constexpr uint32_t FiSlots       = FFX_FRAMEINTERPOLATION_PASS_COUNT;
+  constexpr uint32_t OfSlots       = FFX_OPTICALFLOW_PASS_COUNT;
+
+}
+
+
+FfxErrorCode ffxGetPermutationBlobByIndex(
+        FfxEffect     effectId,
+        FfxPass       passId,
+        FfxBindStage  bindStage,
+        uint32_t      permutationOptions,
+        FfxShaderBlob* outBlob) {
+  static std::mutex s_mutex;
+  static std::array<Fsr3ReflectedBlob, UpscalerSlots + FiSlots + OfSlots> s_blobs;
+
+  (void)bindStage;
+
+  uint32_t slot = 0u;
+  uint32_t known = 0u;
+  Fsr3SpirvCode spirv = { nullptr, 0u };
+
+  switch (effectId) {
+    case FFX_EFFECT_FSR3UPSCALER: {
+      if (passId >= uint32_t(FFX_FSR3UPSCALER_PASS_COUNT))
+        return FFX_ERROR_INVALID_ARGUMENT;
+
+      bool lanczos = (permutationOptions & UpscalerLanczosLut) != 0u;
+      bool sharpen = (permutationOptions & UpscalerSharpen) != 0u;
+
+      // The build provides render-resolution motion vectors only
+      known = UpscalerKnown;
+
+      if (!(permutationOptions & UpscalerLowResMv))
+        g_dxvkFsr3PermutationMismatch.fetch_or(UpscalerLowResMv);
+
+      slot = passId * 4u + (lanczos ? 2u : 0u) + (sharpen ? 1u : 0u);
+      spirv = getUpscalerSpirv(FfxFsr3UpscalerPass(passId), lanczos, sharpen);
+    } break;
+
+    case FFX_EFFECT_FRAMEINTERPOLATION: {
+      if (passId >= uint32_t(FFX_FRAMEINTERPOLATION_PASS_COUNT))
+        return FFX_ERROR_INVALID_ARGUMENT;
+
+      known = FiKnown;
+
+      if (!(permutationOptions & FiLowResMv))
+        g_dxvkFsr3PermutationMismatch.fetch_or(FiLowResMv << 8u);
+
+      slot = UpscalerSlots + passId;
+      spirv = getFrameInterpolationSpirv(FfxFrameInterpolationPass(passId));
+    } break;
+
+    case FFX_EFFECT_OPTICALFLOW: {
+      if (passId >= uint32_t(FFX_OPTICALFLOW_PASS_COUNT))
+        return FFX_ERROR_INVALID_ARGUMENT;
+
+      known = OfKnown;
+      slot = UpscalerSlots + FiSlots + passId;
+      spirv = getOpticalFlowSpirv(FfxOpticalflowPass(passId));
+    } break;
+
+    default:
+      return FFX_ERROR_INVALID_ARGUMENT;
+  }
+
+  // Options outside the compiled set (HDR, jittered motion vectors,
+  // inverted depth, wave64, FP16) cannot be honoured; DXVK never creates
+  // contexts that ask for them. The closest permutation is used and the
+  // mismatch is reported once by DxvkFsr3.
+  if (permutationOptions & ~known)
+    g_dxvkFsr3PermutationMismatch.fetch_or(0x80000000u | ((permutationOptions & ~known) << 16u));
+
+  if (!spirv.code)
+    return FFX_ERROR_INVALID_ARGUMENT;
+
+  std::lock_guard lock(s_mutex);
+
+  Fsr3ReflectedBlob& entry = s_blobs[slot];
+
+  if (!entry.valid)
+    reflectSpirv(spirv, entry);
+
+  FfxShaderBlob blob = makeBlob(spirv, entry);
+  std::memcpy(static_cast<void*>(outBlob), &blob, sizeof(blob));
+  return FFX_OK;
+}
+
+
+FfxErrorCode ffxIsWave64(FfxEffect effectId, uint32_t permutationOptions, bool& isWave64) {
+  (void)effectId;
+  (void)permutationOptions;
+
+  // Only the default wave size is compiled, see dxvk_fsr3_ffx_shim.cpp
+  isWave64 = false;
+  return FFX_OK;
+}
