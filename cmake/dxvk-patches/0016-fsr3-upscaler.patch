+
+    bool failed() const {
+      return m_failed;
+    }
+
+  private:
+
+    /// SDK contexts and resources, see dxvk_fsr3.cpp
+    struct FfxState;
+
+    /// Same layouts as DxvkFsr2's, the shaders are shared
+    struct PreparePushConstants {
+      float     reproject[16];
+      float     jitterNdc[2];
+      uint32_t  extent[2];
+      float     viewport[4];
+    };
+
+    struct CompositePushConstants {
+      float     invOutputExtent[2];
+      uint32_t  inputExtent[2];
+      float     threshold;
+      float     spatialSharpness;
+      uint32_t  debugMode;
+      float     sceneSharpness;
+    };
+
+    DxvkFsr2::Settings      m_settings;
+    float                   m_spatialSharpness = 0.2f;
+    bool                    m_reactiveLogged = false;
+
+    Rc<DxvkDevice>          m_device;
+    VkFormat                m_outputFormat = VK_FORMAT_R16G16B16A16_SFLOAT;
+    std::unique_ptr<DxvkUpscalerTimer> m_timer;
+
+    bool                    m_failed = false;
+    std::unique_ptr<FfxState> m_ffx;
+
+    VkExtent2D              m_renderExtent  = { 0u, 0u };
+    VkExtent2D              m_displayExtent = { 0u, 0u };
+
+    VkDescriptorSetLayout   m_prepareSetLayout       = VK_NULL_HANDLE;
+    VkPipelineLayout        m_preparePipelineLayout  = VK_NULL_HANDLE;
+    VkPipeline              m_preparePipeline        = VK_NULL_HANDLE;
+
+    VkDescriptorSetLayout   m_compositeSetLayout      = VK_NULL_HANDLE;
+    VkPipelineLayout        m_compositePipelineLayout = VK_NULL_HANDLE;
+    VkPipeline              m_compositePipeline       = VK_NULL_HANDLE;
+
+    Rc<DxvkSampler>         m_pointSampler;
+    Rc<DxvkSampler>         m_linearSampler;
+
+    Rc<DxvkImage>           m_depthImage;
+    Rc<DxvkImageView>       m_depthView;
+    Rc<DxvkImage>           m_motionImage;
+    Rc<DxvkImageView>       m_motionView;
+    Rc<DxvkImage>           m_outputImage;
+    Rc<DxvkImageView>       m_outputView;
+    Rc<DxvkImage>           m_compositeImage;
+    Rc<DxvkImageView>       m_compositeView;
+    Rc<DxvkImage>           m_reactiveImage;
+    Rc<DxvkImageView>       m_reactiveView;
+
+    Matrix4                 m_prevViewProj;
+    bool                    m_havePrev = false;
+    uint64_t                m_frameCount = 0u;
+
+    std::vector<VkImageView> m_releasedViews;
+
+    bool createContext(VkExtent2D renderExtent, VkExtent2D displayExtent);
+
+    void destroyContext();
+
+    void createPipelines();
+
+    VkPipeline createComputePipeline(
+            VkPipelineLayout            layout,
+            size_t                      codeSize,
+      const uint32_t*                   code);
+
+    Rc<DxvkImage> createImage(
+            VkExtent2D                  extent,
+            VkFormat                    format,
+      const char*                       name,
+            Rc<DxvkImageView>&          view);
+
+    void createImages(VkExtent2D renderExtent, VkExtent2D displayExtent);
+
+    void preparePass(
+      const DxvkContextObjects&         ctx,
+      const DxvkTemporalUpscaleInputs&  inputs);
+
+    bool generateReactive(
+      const DxvkContextObjects&         ctx,
+      const DxvkTemporalUpscaleInputs&  inputs);
+
+    bool dispatchUpscaler(
+      const DxvkContextObjects&         ctx,
+      const DxvkTemporalUpscaleInputs&  inputs,
+            bool                        useReactive);
+
+    void compositePass(
+      const DxvkContextObjects&         ctx,
+      const DxvkTemporalUpscaleInputs&  inputs,
+      const Rc<DxvkImageView>&          sceneView,
+      const Rc<DxvkImageView>&          finalView,
+            VkRect2D                    finalRect,
+      const Rc<DxvkImageView>&          spatialView,
+      const Rc<DxvkImageView>&          outputView,
+            bool                        useReactive);
+
+    void releaseViews(
+      const DxvkContextObjects&         ctx);
+
+    void destroyReleasedViews();
+
+    void fail(const std::string& message);
+
+  };
+
+}
