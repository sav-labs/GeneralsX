+
+  Rc<DxvkImageView> DxvkFsr3::render(
+    const DxvkContextObjects&         ctx,
+    const DxvkTemporalUpscaleInputs&  inputs,
+    const Rc<DxvkImageView>&          finalView,
+          VkRect2D                    finalRect,
+    const Rc<DxvkImageView>&          spatialView,
+          VkExtent2D                  extent) {
+    if (m_failed || inputs.color == nullptr || inputs.depth == nullptr)
+      return nullptr;
+
+    VkExtent3D colorExtent = inputs.color->mipLevelExtent(0u);
+    VkExtent2D renderExtent = { colorExtent.width, colorExtent.height };
+
+    if (renderExtent != m_renderExtent || extent != m_displayExtent || m_ffx == nullptr) {
+      // Resources of the old context may still be in use by earlier frames
+      if (m_ffx != nullptr)
+        m_device->waitForIdle();
+
+      destroyContext();
+
+      if (!createContext(renderExtent, extent))
+        return nullptr;
+
+      createImages(renderExtent, extent);
+      m_havePrev = false;
+    }
+
+    if (unlikely(m_device->debugFlags().test(DxvkDebugFlag::Capture))) {
+      ctx.cmd->cmdBeginDebugUtilsLabel(DxvkCmdBuffer::ExecBuffer,
+        vk::makeLabel(0xdcc0f0, "FSR 3"));
+    }
+
+    // Everything written before, the scene copies by the D3D9 device, the
+    // EASU pass and the back buffer, is read by the compute passes below.
+    VkMemoryBarrier2 memBarrier = { VK_STRUCTURE_TYPE_MEMORY_BARRIER_2 };
+    memBarrier.srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    memBarrier.srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT;
+    memBarrier.dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    memBarrier.dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT;
+
+    VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    depInfo.memoryBarrierCount = 1;
+    depInfo.pMemoryBarriers = &memBarrier;
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    if (m_timer)
+      m_timer->begin(ctx);
+
+    preparePass(ctx, inputs);
+
+    if (m_timer)
+      m_timer->mark(ctx);
+
+    // Reactive mask from the scene before and after its alpha-blended
+    // effects, as with FSR 2
+    bool useReactive = m_settings.reactiveScale > 0.0f
+      && inputs.opaqueColor != nullptr
+      && inputs.opaqueColor->mipLevelExtent(0u) == colorExtent
+      && generateReactive(ctx, inputs);
+
+    if (m_timer)
+      m_timer->mark(ctx);
+
+    bool success = dispatchUpscaler(ctx, inputs, useReactive);
+
+    if (m_timer)
+      m_timer->mark(ctx);
+
+    if (success) {
+      compositePass(ctx, inputs, m_outputView, finalView, finalRect,
+        spatialView, m_compositeView, useReactive);
+    }
+
+    if (m_timer) {
+      m_timer->mark(ctx);
+      m_timer->end();
+    }
+
+    // DXVK does not know about the compute reads above, so make sure that
+    // later writes to the back buffer and the scene copies wait for them.
+    VkMemoryBarrier2 readBarrier = { VK_STRUCTURE_TYPE_MEMORY_BARRIER_2 };
+    readBarrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    readBarrier.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+
+    depInfo.pMemoryBarriers = &readBarrier;
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    if (unlikely(m_device->debugFlags().test(DxvkDebugFlag::Capture)))
+      ctx.cmd->cmdEndDebugUtilsLabel(DxvkCmdBuffer::ExecBuffer);
+
+    releaseViews(ctx);
+
+    ctx.cmd->track(inputs.color->image(), DxvkAccess::Read);
+    ctx.cmd->track(inputs.depth->image(), DxvkAccess::Read);
+    ctx.cmd->track(finalView->image(), DxvkAccess::Read);
+    ctx.cmd->track(spatialView->image(), DxvkAccess::Read);
+    ctx.cmd->track(m_depthImage, DxvkAccess::Write);
+    ctx.cmd->track(m_motionImage, DxvkAccess::Write);
+    ctx.cmd->track(m_outputImage, DxvkAccess::Write);
+    ctx.cmd->track(m_compositeImage, DxvkAccess::Write);
+
+    if (useReactive) {
+      ctx.cmd->track(inputs.opaqueColor->image(), DxvkAccess::Read);
+      ctx.cmd->track(m_reactiveImage, DxvkAccess::Write);
+    }
+
+    ctx.cmd->track(m_pointSampler);
+    ctx.cmd->track(m_linearSampler);
+
+    if (!success)
+      return nullptr;
+
+    m_prevViewProj = inputs.viewProj;
+    m_havePrev = true;
+    m_frameCount += 1u;
+
+    if (m_frameCount == 1u || !(m_frameCount % 600u)) {
+      Logger::info(str::format("[FSR3] frame ", m_frameCount, ", ",
+        renderExtent.width, "x", renderExtent.height, " to ", extent.width, "x", extent.height,
+        ", jitter ", inputs.jitter[0], " ", inputs.jitter[1],
+        ", near ", inputs.cameraNear, ", far ", inputs.cameraFar,
+        ", frame time ", inputs.frameTimeMs, " ms",
+        useReactive ? ", reactive mask" : (m_settings.reactiveScale > 0.0f ? ", no reactive mask (no opaque scene copy)" : "")));
+    }
+
+    return m_compositeView;
+  }
+
+
+  bool DxvkFsr3::createContext(VkExtent2D renderExtent, VkExtent2D displayExtent) {
+#ifdef DXVK_GENERALSX_FSR3
+    auto vki = m_device->vki();
+    auto vkd = m_device->vkd();
+
+    PFN_vkGetDeviceProcAddr getDeviceProcAddr = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+      vki->getLoaderProc()(vki->instance(), "vkGetDeviceProcAddr"));
+
+    if (!getDeviceProcAddr) {
+      fail("vkGetDeviceProcAddr not found");
+      return false;
+    }
+
+    g_dxvkFsr3Vk.createBuffer                       = vkd->vkCreateBuffer;
+    g_dxvkFsr3Vk.enumerateDeviceExtensionProperties = vki->vkEnumerateDeviceExtensionProperties;
+    g_dxvkFsr3Vk.getPhysicalDeviceMemoryProperties  = vki->vkGetPhysicalDeviceMemoryProperties;
+    g_dxvkFsr3Vk.getPhysicalDeviceProperties        = vki->vkGetPhysicalDeviceProperties;
+    g_dxvkFsr3Vk.getPhysicalDeviceProperties2       = vki->vkGetPhysicalDeviceProperties2;
+    g_dxvkFsr3Vk.getPhysicalDeviceFeatures          = vki->vkGetPhysicalDeviceFeatures;
+    g_dxvkFsr3Vk.getPhysicalDeviceFeatures2         = vki->vkGetPhysicalDeviceFeatures2;
+    g_dxvkFsr3Vk.getDeviceProcAddr                  = getDeviceProcAddr;
+
+    VkPhysicalDevice adapter = m_device->adapter()->handle();
+
+    auto state = std::make_unique<FfxState>();
+    state->scratch.resize(ffxGetScratchMemorySizeVK(adapter, Fsr3MaxContexts));
+    std::memset(state->scratch.data(), 0, state->scratch.size());
+
+    VkDeviceContext deviceContext = { };
+    deviceContext.vkDevice         = m_device->handle();
+    deviceContext.vkPhysicalDevice = adapter;
+    // GeneralsX: the shim's lookup, not the device's. The backend calls
+    // vkGetBufferMemoryRequirements2KHR while it creates its first context,
+    // which the device lookup returns as NULL since DXVK uses the core
+    // function: a crash on the first frame with -upscaler fsr3.
+    deviceContext.vkDeviceProcAddr = &dxvk_fsr3_vkGetDeviceProcAddr;
+
+    FfxErrorCode error = ffxGetInterfaceVK(&state->backend, ffxGetDeviceVK(&deviceContext),
+      state->scratch.data(), state->scratch.size(), Fsr3MaxContexts);
+
+    if (error != FFX_OK) {
+      fail(str::format("ffxGetInterfaceVK failed: ", error));
+      return false;
+    }
+
+    m_ffx = std::move(state);
+
+    // The shared resources live in their own backend context, so that
+    // frame generation can read them after the upscaler, as the SDK's
+    // ffx_fsr3.cpp does
+    error = m_ffx->backend.fpCreateBackendContext(&m_ffx->backend,
+      FFX_EFFECT_SHAREDRESOURCES, nullptr, &m_ffx->sharedContextId);
+
+    if (error != FFX_OK) {
+      destroyContext();
+      fail(str::format("shared backend context: fpCreateBackendContext failed: ", error));
+      return false;
+    }
+
+    m_ffx->sharedContextValid = true;
+
+    // The game renders LDR colour without an exposure value. Motion vectors
+    // are at render resolution and computed without jitter.
+    FfxFsr3UpscalerContextDescription desc = { };
+    desc.flags = FFX_FSR3UPSCALER_ENABLE_AUTO_EXPOSURE;
+    desc.maxRenderSize = { renderExtent.width, renderExtent.height };
+    desc.maxUpscaleSize = { displayExtent.width, displayExtent.height };
+    desc.backendInterface = m_ffx->backend;
+
+    g_dxvkFsr3PermutationMismatch.store(0u);
+
+    error = ffxFsr3UpscalerContextCreate(&m_ffx->upscaler, &desc);
+
+    if (error != FFX_OK) {
+      destroyContext();
+      fail(str::format("ffxFsr3UpscalerContextCreate failed: ", error));
+      return false;
+    }
+
+    m_ffx->upscalerValid = true;
+
+    FfxFsr3UpscalerSharedResourceDescriptions shared = { };
+    error = ffxFsr3UpscalerGetSharedResourceDescriptions(&m_ffx->upscaler, &shared);
+
+    if (error == FFX_OK)
+      error = m_ffx->backend.fpCreateResource(&m_ffx->backend, &shared.dilatedDepth, m_ffx->sharedContextId, &m_ffx->dilatedDepth);
+    if (error == FFX_OK)
+      error = m_ffx->backend.fpCreateResource(&m_ffx->backend, &shared.dilatedMotionVectors, m_ffx->sharedContextId, &m_ffx->dilatedMotionVectors);
+    if (error == FFX_OK)
+      error = m_ffx->backend.fpCreateResource(&m_ffx->backend, &shared.reconstructedPrevNearestDepth, m_ffx->sharedContextId, &m_ffx->reconstructedPrevNearestDepth);
+
+    if (error != FFX_OK) {
+      destroyContext();
+      fail(str::format("shared upscaler resources: fpCreateResource failed: ", error));
+      return false;
+    }
+
+    m_ffx->sharedResourcesValid = true;
+
+    uint32_t mismatch = g_dxvkFsr3PermutationMismatch.load();
+
+    if (mismatch) {
+      Logger::warn(str::format("[FSR3] the upscaler asked for shader options this build does not provide (mask ",
+        mismatch, "), using the closest ones"));
+    }
+
+    m_renderExtent = renderExtent;
+    m_displayExtent = displayExtent;
+
+    Logger::info(str::format("[FSR3] context created, render ", renderExtent.width, "x", renderExtent.height,
+      ", display ", displayExtent.width, "x", displayExtent.height,
+      ", FidelityFX FSR ", FFX_FSR3UPSCALER_VERSION_MAJOR, ".", FFX_FSR3UPSCALER_VERSION_MINOR, ".", FFX_FSR3UPSCALER_VERSION_PATCH,
+      " (FidelityFX SDK ", FFX_SDK_VERSION_MAJOR, ".", FFX_SDK_VERSION_MINOR, ".", FFX_SDK_VERSION_PATCH, ")"));
+    return true;
+#else
+    (void)renderExtent;
+    (void)displayExtent;
+    return false;
+#endif
+  }
+
+
+  void DxvkFsr3::destroyContext() {
+#ifdef DXVK_GENERALSX_FSR3
+    if (m_ffx != nullptr) {
+      m_device->waitForIdle();
+
+      if (m_ffx->sharedResourcesValid) {
+        m_ffx->backend.fpDestroyResource(&m_ffx->backend, m_ffx->dilatedDepth, m_ffx->sharedContextId);
+        m_ffx->backend.fpDestroyResource(&m_ffx->backend, m_ffx->dilatedMotionVectors, m_ffx->sharedContextId);
+        m_ffx->backend.fpDestroyResource(&m_ffx->backend, m_ffx->reconstructedPrevNearestDepth, m_ffx->sharedContextId);
+      }
+
+      if (m_ffx->upscalerValid)
+        ffxFsr3UpscalerContextDestroy(&m_ffx->upscaler);
+
+      if (m_ffx->sharedContextValid)
+        m_ffx->backend.fpDestroyBackendContext(&m_ffx->backend, m_ffx->sharedContextId);
+
+      // The GPU is idle, so the views the backend released can go now
+      destroyReleasedViews();
+    }
+#endif
+
+    m_ffx = nullptr;
+    m_renderExtent = { 0u, 0u };
+    m_displayExtent = { 0u, 0u };
+  }
