+  // FidelityFX/gpu/fsr3upscaler/ffx_fsr3upscaler_resources.h
+  constexpr uint32_t Fsr3ReactiveApplyTonemap    = 1u;
+  constexpr uint32_t Fsr3ReactiveApplyThreshold  = 4u;
+  constexpr uint32_t Fsr3ReactiveComponentsMax   = 8u;
