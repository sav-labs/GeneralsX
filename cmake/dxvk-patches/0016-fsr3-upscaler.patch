+  /**
+   * \brief GeneralsX: image views the SDK backend released
+   *
+   * Tracked by the command list of the frame that released them, so they
+   * are destroyed once the GPU is done with that frame.
+   */
+  class DxvkFsr3ReleasedViews : public RcObject {
+
+  public:
+
+    DxvkFsr3ReleasedViews(Rc<vk::DeviceFn> vkd, std::vector<VkImageView>&& views)
+    : m_vkd(std::move(vkd)), m_views(std::move(views)) { }
+
+    ~DxvkFsr3ReleasedViews() {
+      for (VkImageView view : m_views)
+        m_vkd->vkDestroyImageView(m_vkd->device(), view, nullptr);
+    }
+
+  private:
+
+    Rc<vk::DeviceFn>          m_vkd;
+    std::vector<VkImageView>  m_views;
+
+  };
