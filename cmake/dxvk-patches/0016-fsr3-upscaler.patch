+
+  void DxvkFsr3::createPipelines() {
+    auto vk = m_device->vkd();
+
+    // Prepare pass: depth in, linear depth copy and motion vectors out
+    std::array<VkDescriptorSetLayoutBinding, 3> prepareBindings = {{
+      { 0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_COMPUTE_BIT },
+      { 1, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,          1, VK_SHADER_STAGE_COMPUTE_BIT },
+      { 2, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,          1, VK_SHADER_STAGE_COMPUTE_BIT },
+    }};
+
+    // Composite pass: temporal output, EASU output, final and scene images,
+    // composited output, and the reactive mask for its debug view
+    std::array<VkDescriptorSetLayoutBinding, 6> compositeBindings = {{
+      { 0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_COMPUTE_BIT },
+      { 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_COMPUTE_BIT },
+      { 2, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_COMPUTE_BIT },
+      { 3, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_COMPUTE_BIT },
+      { 4, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,          1, VK_SHADER_STAGE_COMPUTE_BIT },
+      { 5, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_COMPUTE_BIT },
+    }};
+
+    auto createLayouts = [&] (const VkDescriptorSetLayoutBinding* bindings, uint32_t count,
+        uint32_t pushSize, VkDescriptorSetLayout& setLayout, VkPipelineLayout& pipelineLayout) {
+      VkDescriptorSetLayoutCreateInfo setInfo = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+      setInfo.bindingCount = count;
+      setInfo.pBindings = bindings;
+
+      VkResult vr = vk->vkCreateDescriptorSetLayout(vk->device(), &setInfo, nullptr, &setLayout);
+
+      if (vr != VK_SUCCESS)
+        throw DxvkError(str::format("[FSR3] failed to create descriptor set layout: ", vr));
+
+      VkPushConstantRange pushConst = { };
+      pushConst.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+      pushConst.size = pushSize;
+
+      VkPipelineLayoutCreateInfo layoutInfo = { VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+      layoutInfo.setLayoutCount = 1;
+      layoutInfo.pSetLayouts = &setLayout;
+      layoutInfo.pushConstantRangeCount = 1;
+      layoutInfo.pPushConstantRanges = &pushConst;
+
+      vr = vk->vkCreatePipelineLayout(vk->device(), &layoutInfo, nullptr, &pipelineLayout);
+
+      if (vr != VK_SUCCESS)
+        throw DxvkError(str::format("[FSR3] failed to create pipeline layout: ", vr));
+    };
+
+    createLayouts(prepareBindings.data(), prepareBindings.size(), sizeof(PreparePushConstants),
+      m_prepareSetLayout, m_preparePipelineLayout);
+    createLayouts(compositeBindings.data(), compositeBindings.size(), sizeof(CompositePushConstants),
+      m_compositeSetLayout, m_compositePipelineLayout);
+
+    m_preparePipeline = createComputePipeline(m_preparePipelineLayout,
+      sizeof(dxvk_fsr2_prepare), dxvk_fsr2_prepare);
+    m_compositePipeline = createComputePipeline(m_compositePipelineLayout,
+      sizeof(dxvk_fsr2_composite), dxvk_fsr2_composite);
+  }
+
+
+  VkPipeline DxvkFsr3::createComputePipeline(
+          VkPipelineLayout            layout,
+          size_t                      codeSize,
+    const uint32_t*                   code) {
+    auto vk = m_device->vkd();
+
+    VkShaderModuleCreateInfo moduleInfo = { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+    moduleInfo.codeSize = codeSize;
+    moduleInfo.pCode = code;
+
+    VkShaderModule module = VK_NULL_HANDLE;
+    VkResult vr = vk->vkCreateShaderModule(vk->device(), &moduleInfo, nullptr, &module);
+
+    if (vr != VK_SUCCESS)
+      throw DxvkError(str::format("[FSR3] failed to create shader module: ", vr));
+
+    VkComputePipelineCreateInfo info = { VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO };
+    info.stage = { VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO };
+    info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+    info.stage.module = module;
+    info.stage.pName = "main";
+    info.layout = layout;
+    info.basePipelineIndex = -1;
+
+    VkPipeline pipeline = VK_NULL_HANDLE;
+    vr = vk->vkCreateComputePipelines(vk->device(), VK_NULL_HANDLE, 1, &info, nullptr, &pipeline);
+
+    vk->vkDestroyShaderModule(vk->device(), module, nullptr);
+
+    if (vr != VK_SUCCESS)
+      throw DxvkError(str::format("[FSR3] failed to create compute pipeline: ", vr));
+
+    return pipeline;
+  }
+
+
+  Rc<DxvkImage> DxvkFsr3::createImage(
+          VkExtent2D                  extent,
+          VkFormat                    format,
+    const char*                       name,
+          Rc<DxvkImageView>&          view) {
+    DxvkImageCreateInfo imageInfo = { };
+    imageInfo.type          = VK_IMAGE_TYPE_2D;
+    imageInfo.format        = format;
+    imageInfo.sampleCount   = VK_SAMPLE_COUNT_1_BIT;
+    imageInfo.extent        = { extent.width, extent.height, 1u };
+    imageInfo.mipLevels     = 1;
+    imageInfo.numLayers     = 1;
+    imageInfo.usage         = VK_IMAGE_USAGE_STORAGE_BIT
+                            | VK_IMAGE_USAGE_SAMPLED_BIT;
+    imageInfo.stages        = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT
+                            | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
+    imageInfo.access        = VK_ACCESS_SHADER_READ_BIT
+                            | VK_ACCESS_SHADER_WRITE_BIT;
+    imageInfo.tiling        = VK_IMAGE_TILING_OPTIMAL;
+    imageInfo.layout        = VK_IMAGE_LAYOUT_GENERAL;
+    imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    imageInfo.colorSpace    = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+    imageInfo.debugName     = name;
+
+    Rc<DxvkImage> image = m_device->createImage(imageInfo, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+    DxvkImageViewKey viewInfo = { };
+    viewInfo.viewType       = VK_IMAGE_VIEW_TYPE_2D;
+    viewInfo.usage          = VK_IMAGE_USAGE_STORAGE_BIT
+                            | VK_IMAGE_USAGE_SAMPLED_BIT;
+    viewInfo.format         = format;
+    viewInfo.aspects        = VK_IMAGE_ASPECT_COLOR_BIT;
+    viewInfo.mipIndex       = 0u;
+    viewInfo.mipCount       = 1u;
+    viewInfo.layerIndex     = 0u;
+    viewInfo.layerCount     = 1u;
+
+    view = image->createView(viewInfo);
+    return image;
+  }
+
+
+  void DxvkFsr3::createImages(VkExtent2D renderExtent, VkExtent2D displayExtent) {
+    m_depthImage     = createImage(renderExtent,  VK_FORMAT_R32_SFLOAT,          "FSR3 depth",     m_depthView);
+    m_motionImage    = createImage(renderExtent,  VK_FORMAT_R16G16_SFLOAT,       "FSR3 motion",    m_motionView);
+    // GeneralsX: 10-bit output and composite images where supported, as
+    // for FSR 2
+    m_outputImage    = createImage(displayExtent, m_outputFormat,                "FSR3 output",    m_outputView);
+    m_compositeImage = createImage(displayExtent, m_outputFormat,                "FSR3 composite", m_compositeView);
+    m_reactiveImage  = createImage(renderExtent,  VK_FORMAT_R32_SFLOAT,          "FSR3 reactive",  m_reactiveView);
+  }
+
+
+  void DxvkFsr3::preparePass(
+    const DxvkContextObjects&         ctx,
+    const DxvkTemporalUpscaleInputs&  inputs) {
+    // The previous frame's FSR 3 passes may still read the images, which
+    // are fully overwritten, so their contents are discarded.
+    std::array<VkImageMemoryBarrier2, 2> barriers = { };
+
+    for (uint32_t i = 0; i < barriers.size(); i++) {
+      const Rc<DxvkImageView>& view = i ? m_motionView : m_depthView;
+
+      barriers[i] = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2 };
+      barriers[i].srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+      barriers[i].dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+      barriers[i].dstAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+      barriers[i].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      barriers[i].newLayout = VK_IMAGE_LAYOUT_GENERAL;
+      barriers[i].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barriers[i].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barriers[i].image = view->image()->handle();
+      barriers[i].subresourceRange = view->imageSubresources();
+    }
+
+    VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    depInfo.imageMemoryBarrierCount = barriers.size();
+    depInfo.pImageMemoryBarriers = barriers.data();
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    VkDescriptorSet set = ctx.descriptorPool->alloc(m_prepareSetLayout);
+
+    VkDescriptorImageInfo depthInfo = { };
+    depthInfo.sampler = m_pointSampler->handle();
+    depthInfo.imageView = inputs.depth->handle();
+    depthInfo.imageLayout = inputs.depth->image()->info().layout;
+
+    VkDescriptorImageInfo depthOutInfo = { };
+    depthOutInfo.imageView = m_depthView->handle();
+    depthOutInfo.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+
+    VkDescriptorImageInfo motionOutInfo = { };
+    motionOutInfo.imageView = m_motionView->handle();
+    motionOutInfo.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+
+    std::array<VkWriteDescriptorSet, 3> writes = {{
+      { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr, set, 0, 0, 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &depthInfo },
+      { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr, set, 1, 0, 1, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, &depthOutInfo },
+      { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr, set, 2, 0, 1, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, &motionOutInfo },
+    }};
+
+    ctx.cmd->updateDescriptorSets(writes.size(), writes.data());
+
+    // Reprojection from the current to the previous frame's clip space, see
+    // DxvkFsr2::preparePass
+    Matrix4 prevViewProj = m_havePrev && !inputs.reset ? m_prevViewProj : inputs.viewProj;
+    Matrix4 reproject = prevViewProj * inverse(inputs.viewProj);
+
+    // The camera projects into the game's 3D viewport, which leaves out
+    // the control bar at the bottom of the screen
+    float viewport[4] = { 0.0f, 0.0f, float(m_renderExtent.width), float(m_renderExtent.height) };
+
+    if (inputs.viewport[2] >= 1.0f && inputs.viewport[3] >= 1.0f)
+      std::memcpy(viewport, inputs.viewport, sizeof(viewport));
+
+    PreparePushConstants push = { };
+    std::memcpy(push.reproject, &reproject, sizeof(push.reproject));
+    push.jitterNdc[0] =  2.0f * inputs.jitter[0] / viewport[2];
+    push.jitterNdc[1] = -2.0f * inputs.jitter[1] / viewport[3];
+    push.extent[0] = m_renderExtent.width;
+    push.extent[1] = m_renderExtent.height;
+    std::memcpy(push.viewport, viewport, sizeof(push.viewport));
+
+    ctx.cmd->cmdBindPipeline(DxvkCmdBuffer::ExecBuffer,
+      VK_PIPELINE_BIND_POINT_COMPUTE, m_preparePipeline);
+    ctx.cmd->cmdBindDescriptorSet(DxvkCmdBuffer::ExecBuffer,
+      VK_PIPELINE_BIND_POINT_COMPUTE, m_preparePipelineLayout, set, 0, nullptr);
+    ctx.cmd->cmdPushConstants(DxvkCmdBuffer::ExecBuffer, m_preparePipelineLayout,
+      VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push), &push);
+    ctx.cmd->cmdDispatch(DxvkCmdBuffer::ExecBuffer,
+      (m_renderExtent.width + 7u) / 8u, (m_renderExtent.height + 7u) / 8u, 1u);
+
+    // The upscaler reads both images in SHADER_READ_ONLY_OPTIMAL layout,
+    // the state they are registered with; the backend returns them to it.
+    for (auto& barrier : barriers) {
+      barrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+      barrier.srcAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+      barrier.dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+      barrier.dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT;
+      barrier.oldLayout = VK_IMAGE_LAYOUT_GENERAL;
+      barrier.newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    }
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+  }
+
+
+  bool DxvkFsr3::generateReactive(
+    const DxvkContextObjects&         ctx,
+    const DxvkTemporalUpscaleInputs&  inputs) {
+#ifdef DXVK_GENERALSX_FSR3
+    // The mask is fully overwritten; the upscaler of the previous frame and
+    // the debug view may still read it.
+    VkImageMemoryBarrier2 barrier = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2 };
+    barrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    barrier.dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    barrier.dstAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+    barrier.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    barrier.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.image = m_reactiveImage->handle();
+    barrier.subresourceRange = m_reactiveView->imageSubresources();
+
+    VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    depInfo.imageMemoryBarrierCount = 1;
+    depInfo.pImageMemoryBarriers = &barrier;
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    VkCommandBuffer cmdBuffer = ctx.cmd->getExecCommandBuffer();
+
+    // Same mask as with FSR 2: every pixel whose largest tonemapped channel
+    // the alpha-blended effects changed by at least the threshold
+    FfxFsr3UpscalerGenerateReactiveDescription desc = { };
+    desc.commandList = ffxGetCommandListVK(cmdBuffer);
+    desc.colorOpaqueOnly = getFfxImage(inputs.opaqueColor->image(), inputs.opaqueColor->info().format,
+      m_renderExtent, false, L"FSR3 opaque color", FFX_RESOURCE_STATE_COMPUTE_READ);
+    desc.colorPreUpscale = getFfxImage(inputs.color->image(), inputs.color->info().format,
+      m_renderExtent, false, L"FSR3 color", FFX_RESOURCE_STATE_COMPUTE_READ);
+    desc.outReactive = getFfxImage(m_reactiveImage, VK_FORMAT_R32_SFLOAT,
+      m_renderExtent, true, L"FSR3 reactive", FFX_RESOURCE_STATE_UNORDERED_ACCESS);
+    desc.renderSize = { m_renderExtent.width, m_renderExtent.height };
+    desc.scale = 1.0f;
+    desc.cutoffThreshold = m_settings.reactiveThreshold;
+    desc.binaryValue = m_settings.reactiveScale;
+    desc.flags = Fsr3ReactiveApplyTonemap
+               | Fsr3ReactiveApplyThreshold
+               | Fsr3ReactiveComponentsMax;
+
+    FfxErrorCode error = ffxFsr3UpscalerContextGenerateReactiveMask(&m_ffx->upscaler, &desc);
+
+    if (error != FFX_OK) {
+      // The upscaler itself still works without the mask
+      if (!std::exchange(m_reactiveLogged, true))
+        Logger::err(str::format("[FSR3] reactive mask: ffxFsr3UpscalerContextGenerateReactiveMask failed: ", error, ", upscaling without it"));
+      return false;
+    }
+
+    if (!std::exchange(m_reactiveLogged, true)) {
+      Logger::info(str::format("[FSR3] reactive mask: first dispatch, ", m_renderExtent.width, "x", m_renderExtent.height,
+        ", value ", m_settings.reactiveScale, ", threshold ", m_settings.reactiveThreshold,
+        ", flags tonemap, threshold, max component"));
+    }
+
+    return true;
+#else
+    (void)ctx;
+    (void)inputs;
+    return false;
+#endif
+  }
+
+
+  bool DxvkFsr3::dispatchUpscaler(
+    const DxvkContextObjects&         ctx,
+    const DxvkTemporalUpscaleInputs&  inputs,
+          bool                        useReactive) {
+#ifdef DXVK_GENERALSX_FSR3
+    if (ffxGetSurfaceFormatVK(inputs.color->info().format) == FFX_SURFACE_FORMAT_UNKNOWN) {
+      fail(str::format("scene colour format ", inputs.color->info().format, " is not supported by the FidelityFX SDK"));
+      return false;
+    }
+
+    // The upscaler writes every output pixel; the composite pass of the
+    // previous frame may still read the image.
+    VkImageMemoryBarrier2 barrier = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2 };
+    barrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    barrier.dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    barrier.dstAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+    barrier.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    barrier.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.image = m_outputImage->handle();
+    barrier.subresourceRange = m_outputView->imageSubresources();
+
+    VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    depInfo.imageMemoryBarrierCount = 1;
+    depInfo.pImageMemoryBarriers = &barrier;
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    VkCommandBuffer cmdBuffer = ctx.cmd->getExecCommandBuffer();
+
+    FfxFsr3UpscalerDispatchDescription desc = { };
+    desc.commandList = ffxGetCommandListVK(cmdBuffer);
+    desc.color = getFfxImage(inputs.color->image(), inputs.color->info().format,
+      m_renderExtent, false, L"FSR3 color", FFX_RESOURCE_STATE_COMPUTE_READ);
+    desc.depth = getFfxImage(m_depthImage, VK_FORMAT_R32_SFLOAT,
+      m_renderExtent, false, L"FSR3 depth", FFX_RESOURCE_STATE_COMPUTE_READ);
+    desc.motionVectors = getFfxImage(m_motionImage, VK_FORMAT_R16G16_SFLOAT,
+      m_renderExtent, false, L"FSR3 motion", FFX_RESOURCE_STATE_COMPUTE_READ);
+    desc.output = getFfxImage(m_outputImage, m_outputFormat,
+      m_displayExtent, true, L"FSR3 output", FFX_RESOURCE_STATE_UNORDERED_ACCESS);
+
+    // generateReactive left the mask in GENERAL layout, and the backend
+    // returns it there after the dispatch, where the debug view reads it.
+    if (useReactive) {
+      desc.reactive = getFfxImage(m_reactiveImage, VK_FORMAT_R32_SFLOAT,
+        m_renderExtent, true, L"FSR3 reactive", FFX_RESOURCE_STATE_UNORDERED_ACCESS);
+    }
+
+    desc.dilatedDepth = m_ffx->backend.fpGetResource(&m_ffx->backend, m_ffx->dilatedDepth);
+    desc.dilatedMotionVectors = m_ffx->backend.fpGetResource(&m_ffx->backend, m_ffx->dilatedMotionVectors);
+    desc.reconstructedPrevNearestDepth = m_ffx->backend.fpGetResource(&m_ffx->backend, m_ffx->reconstructedPrevNearestDepth);
+
+    desc.jitterOffset.x = inputs.jitter[0];
+    desc.jitterOffset.y = inputs.jitter[1];
+    // The motion vectors are in UV units of the render size
+    desc.motionVectorScale.x = float(m_renderExtent.width);
+    desc.motionVectorScale.y = float(m_renderExtent.height);
+    desc.renderSize = { m_renderExtent.width, m_renderExtent.height };
+    desc.upscaleSize = { m_displayExtent.width, m_displayExtent.height };
+    // GeneralsX: DXVK_FSR2_SHARPNESS is applied by the composite pass, as
+    // for FSR 2, so the upscaler skips its own RCAS pass; without it the
+    // swap chain sharpens with FSR 1.0 RCAS, never both
+    desc.enableSharpening = false;
+    desc.sharpness = m_settings.sharpness;
+    desc.frameTimeDelta = std::clamp(inputs.frameTimeMs, 1.0f, 200.0f);
+    desc.preExposure = 1.0f;
+    desc.reset = inputs.reset || !m_havePrev;
+    desc.cameraNear = inputs.cameraNear;
+    desc.cameraFar = inputs.cameraFar;
+    desc.cameraFovAngleVertical = inputs.fovY;
+    // Zero Hour world units are roughly feet
+    desc.viewSpaceToMetersFactor = 0.3048f;
+
+    FfxErrorCode error = ffxFsr3UpscalerContextDispatch(&m_ffx->upscaler, &desc);
+
+    if (error != FFX_OK) {
+      fail(str::format("ffxFsr3UpscalerContextDispatch failed: ", error));
+      return false;
+    }
+
+    return true;
+#else
+    (void)ctx;
+    (void)inputs;
+    (void)useReactive;
+    return false;
+#endif
+  }
+
+
+  void DxvkFsr3::compositePass(
+    const DxvkContextObjects&         ctx,
+    const DxvkTemporalUpscaleInputs&  inputs,
+    const Rc<DxvkImageView>&          sceneView,
+    const Rc<DxvkImageView>&          finalView,
+          VkRect2D                    finalRect,
+    const Rc<DxvkImageView>&          spatialView,
+    const Rc<DxvkImageView>&          outputView,
+          bool                        useReactive) {
+    // The scene image was written in GENERAL layout by the SDK. The output
+    // is fully overwritten; the previous frame's final blit may still read
+    // it.
+    std::array<VkImageMemoryBarrier2, 2> barriers = { };
+    barriers[0] = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2 };
+    barriers[0].srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    barriers[0].srcAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+    barriers[0].dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    barriers[0].dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT;
+    barriers[0].oldLayout = VK_IMAGE_LAYOUT_GENERAL;
+    barriers[0].newLayout = VK_IMAGE_LAYOUT_GENERAL;
+    barriers[0].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barriers[0].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barriers[0].image = sceneView->image()->handle();
+    barriers[0].subresourceRange = sceneView->imageSubresources();
+
+    barriers[1] = barriers[0];
+    barriers[1].srcStageMask = VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT;
+    barriers[1].srcAccessMask = 0;
+    barriers[1].dstAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+    barriers[1].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    barriers[1].image = outputView->image()->handle();
+    barriers[1].subresourceRange = outputView->imageSubresources();
+
+    VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    depInfo.imageMemoryBarrierCount = barriers.size();
+    depInfo.pImageMemoryBarriers = barriers.data();
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    VkDescriptorSet set = ctx.descriptorPool->alloc(m_compositeSetLayout);
+
+    VkDescriptorImageInfo temporalInfo = { };
+    temporalInfo.sampler = m_linearSampler->handle();
+    temporalInfo.imageView = sceneView->handle();
+    temporalInfo.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+
+    VkDescriptorImageInfo spatialInfo = { };
+    spatialInfo.sampler = m_linearSampler->handle();
+    spatialInfo.imageView = spatialView->handle();
+    spatialInfo.imageLayout = spatialView->image()->info().layout;
+
+    VkDescriptorImageInfo finalInfo = { };
+    finalInfo.sampler = m_pointSampler->handle();
+    finalInfo.imageView = finalView->handle();
+    finalInfo.imageLayout = finalView->image()->info().layout;
+
+    VkDescriptorImageInfo sceneInfo = { };
+    sceneInfo.sampler = m_pointSampler->handle();
+    sceneInfo.imageView = inputs.color->handle();
+    sceneInfo.imageLayout = inputs.color->image()->info().layout;
+
+    VkDescriptorImageInfo outInfo = { };
+    outInfo.imageView = outputView->handle();
+    outInfo.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+
+    // The reactive mask for the debug view. Without a mask this frame, the
+    // scene copy stands in and the shader does not read it.
+    VkDescriptorImageInfo reactiveInfo = sceneInfo;
+
+    if (useReactive) {
+      reactiveInfo.sampler = m_linearSampler->handle();
+      reactiveInfo.imageView = m_reactiveView->handle();
+      reactiveInfo.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    }
+
+    std::array<VkWriteDescriptorSet, 6> writes = {{
+      { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr, set, 0, 0, 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &temporalInfo },
+      { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr, set, 1, 0, 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &spatialInfo },
+      { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr, set, 2, 0, 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &finalInfo },
+      { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr, set, 3, 0, 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &sceneInfo },
+      { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr, set, 4, 0, 1, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, &outInfo },
+      { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr, set, 5, 0, 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &reactiveInfo },
+    }};
+
+    ctx.cmd->updateDescriptorSets(writes.size(), writes.data());
+
+    CompositePushConstants push = { };
+    push.invOutputExtent[0] = 1.0f / float(m_displayExtent.width);
+    push.invOutputExtent[1] = 1.0f / float(m_displayExtent.height);
+    push.inputExtent[0] = finalRect.extent.width;
+    push.inputExtent[1] = finalRect.extent.height;
+    push.threshold = 1.5f / 255.0f;
+    // While FSR 3 sharpens the scene, the swap chain does not sharpen the
+    // composited image, so the interface pixels taken from the EASU image
+    // get the FSR 1.0 RCAS pass here. Negative: no sharpening.
+    push.spatialSharpness = sharpensOutput() ? m_spatialSharpness : -1.0f;
+    // GeneralsX: RCAS of the upscaled scene in place of the upscaler's own
+    push.sceneSharpness = sharpensOutput() ? DxvkFsr2::sceneRcasStops(m_settings.sharpness) : -1.0f;
+    // 0: normal, 1: reactive mask over a grey frame, 2: the debug view
+    // without a mask this frame
+    push.debugMode = m_settings.debugReactive ? (useReactive ? 1u : 2u) : 0u;
+
+    ctx.cmd->cmdBindPipeline(DxvkCmdBuffer::ExecBuffer,
+      VK_PIPELINE_BIND_POINT_COMPUTE, m_compositePipeline);
+    ctx.cmd->cmdBindDescriptorSet(DxvkCmdBuffer::ExecBuffer,
+      VK_PIPELINE_BIND_POINT_COMPUTE, m_compositePipelineLayout, set, 0, nullptr);
+    ctx.cmd->cmdPushConstants(DxvkCmdBuffer::ExecBuffer, m_compositePipelineLayout,
+      VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push), &push);
+    ctx.cmd->cmdDispatch(DxvkCmdBuffer::ExecBuffer,
+      (m_displayExtent.width + 7u) / 8u, (m_displayExtent.height + 7u) / 8u, 1u);
+
+    // The final blit samples the composited image in GENERAL layout
+    barriers[1].srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    barriers[1].srcAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+    barriers[1].dstStageMask = VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT;
+    barriers[1].dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT;
+    barriers[1].oldLayout = VK_IMAGE_LAYOUT_GENERAL;
+    barriers[1].newLayout = VK_IMAGE_LAYOUT_GENERAL;
+
+    depInfo.imageMemoryBarrierCount = 1;
+    depInfo.pImageMemoryBarriers = &barriers[1];
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+  }
+
+
+  void DxvkFsr3::releaseViews(
+    const DxvkContextObjects&         ctx) {
+#ifdef DXVK_GENERALSX_FSR3
+    dxvkFsr3TakeReleasedViews(m_releasedViews);
+
+    if (m_releasedViews.empty())
+      return;
+
+    // The views were released by dispatches recorded into this command
+    // list or earlier ones, so they can go once it has finished
+    ctx.cmd->track(Rc<DxvkFsr3ReleasedViews>(new DxvkFsr3ReleasedViews(
+      m_device->vkd(), std::move(m_releasedViews))));
+    m_releasedViews.clear();
+#else
+    (void)ctx;
+#endif
+  }
+
+
+  void DxvkFsr3::destroyReleasedViews() {
+#ifdef DXVK_GENERALSX_FSR3
+    dxvkFsr3TakeReleasedViews(m_releasedViews);
+
+    auto vk = m_device->vkd();
+
+    for (VkImageView view : m_releasedViews)
+      vk->vkDestroyImageView(vk->device(), view, nullptr);
+#endif
+
+    m_releasedViews.clear();
+  }
+
+
+  void DxvkFsr3::fail(const std::string& message) {
+    if (!m_failed)
+      Logger::err(str::format("[FSR3] ", message, "; falling back to FSR 2 or FSR 1.0"));
+
+    m_failed = true;
+  }
+
+}
