+# GeneralsX: AMD FidelityFX SDK (MIT) for FSR 3: the FSR 3.1 upscaler and
+# the frame interpolation and optical flow effects of frame generation. The
+# build copies include/ and src/ of a pinned SDK release into fsr3/ffx-sdk;
+# without them DXVK_UPSCALER=fsr3 falls back to FSR 2.
+fsr3_sdk_dir = 'fsr3/ffx-sdk'
+dxvk_fsr3_libs = []
+dxvk_fsr3_args = []
+dxvk_fsr3_includes = []
+
+if fs.is_file(fsr3_sdk_dir / 'src' / 'components' / 'fsr3upscaler' / 'ffx_fsr3upscaler.cpp')
+  fsr3_gpu_dir = meson.current_source_dir() / fsr3_sdk_dir / 'include' / 'FidelityFX' / 'gpu'
+  fsr3_vk_shader_dir = fsr3_sdk_dir / 'src' / 'backends' / 'vk' / 'shaders'
+
+  # GeneralsX: -Os runs the SPIR-V optimizer, which removes resources a
+  # pass declares but only reads in dead code, such as the optical flow
+  # confidence of the frame interpolation's vector field pass. The backend
+  # does not bind those, and a shader that still references an unwritten
+  # descriptor is invalid. Names stay, so the run-time reflection works.
+  fsr3_glsl_args = [
+    '--quiet',
+    '-Os',
+    '--target-env', 'vulkan1.2',
+    '-S', 'comp',
+    '-I' + fsr3_gpu_dir,
+    '-DFFX_GLSL=1',
+    '-DFFX_GPU=1',
+    '-DFFX_HALF=0',
+  ]
+
+  # Upscaler: LDR colour, render-resolution motion vectors without jitter,
+  # standard depth. The reprojection Lanczos type follows the backend's LUT
+  # choice and the accumulate pass has a sharpening variant.
+  fsr3_upscaler_args = fsr3_glsl_args + [
+    '-I' + fsr3_gpu_dir / 'fsr3upscaler',
+    '-DFFX_FSR3UPSCALER_OPTION_UPSAMPLE_SAMPLERS_USE_DATA_HALF=0',
+    '-DFFX_FSR3UPSCALER_OPTION_ACCUMULATE_SAMPLERS_USE_DATA_HALF=0',
+    '-DFFX_FSR3UPSCALER_OPTION_REPROJECT_SAMPLERS_USE_DATA_HALF=1',
+    '-DFFX_FSR3UPSCALER_OPTION_POSTPROCESSLOCKSTATUS_SAMPLERS_USE_DATA_HALF=0',
+    '-DFFX_FSR3UPSCALER_OPTION_UPSAMPLE_USE_LANCZOS_TYPE=2',
+    '-DFFX_FSR3UPSCALER_OPTION_HDR_COLOR_INPUT=0',
+    '-DFFX_FSR3UPSCALER_OPTION_LOW_RESOLUTION_MOTION_VECTORS=1',
+    '-DFFX_FSR3UPSCALER_OPTION_JITTERED_MOTION_VECTORS=0',
+    '-DFFX_FSR3UPSCALER_OPTION_INVERTED_DEPTH=0',
+  ]
+
+  fsr3_fi_args = fsr3_glsl_args + [
+    '-I' + fsr3_gpu_dir / 'frameinterpolation',
+    '-DFFX_FRAMEINTERPOLATION_OPTION_UPSAMPLE_SAMPLERS_USE_DATA_HALF=0',
+    '-DFFX_FRAMEINTERPOLATION_OPTION_ACCUMULATE_SAMPLERS_USE_DATA_HALF=0',
+    '-DFFX_FRAMEINTERPOLATION_OPTION_REPROJECT_SAMPLERS_USE_DATA_HALF=1',
+    '-DFFX_FRAMEINTERPOLATION_OPTION_POSTPROCESSLOCKSTATUS_SAMPLERS_USE_DATA_HALF=0',
+    '-DFFX_FRAMEINTERPOLATION_OPTION_UPSAMPLE_USE_LANCZOS_TYPE=2',
+    '-DFFX_FRAMEINTERPOLATION_OPTION_LOW_RES_MOTION_VECTORS=1',
+    '-DFFX_FRAMEINTERPOLATION_OPTION_JITTER_MOTION_VECTORS=0',
+    '-DFFX_FRAMEINTERPOLATION_OPTION_INVERTED_DEPTH=0',
+  ]
+
+  fsr3_of_args = fsr3_glsl_args + [
+    '-I' + fsr3_gpu_dir / 'opticalflow',
+    '-DFFX_OPTICALFLOW_OPTION_HDR_COLOR_INPUT=0',
+  ]
+
+  fsr3_shaders = []
+
+  foreach pass : [ 'accumulate', 'autogen_reactive', 'debug_view', 'luma_instability', 'luma_pyramid',
+                   'prepare_inputs', 'prepare_reactivity', 'rcas', 'shading_change', 'shading_change_pyramid' ]
+    foreach lanczos : [ '0', '1' ]
+      foreach sharpen : (pass == 'accumulate' ? [ '0', '1' ] : [ '0' ])
+        fsr3_name = 'dxvk_fsr3_up_' + pass + '_l' + lanczos + '_s' + sharpen
+        fsr3_shaders += custom_target(fsr3_name,
+          input   : files(fsr3_vk_shader_dir / 'fsr3upscaler' / 'ffx_fsr3upscaler_' + pass + '_pass.glsl'),
+          output  : fsr3_name + '.h',
+          command : [ glsl_compiler ] + fsr3_upscaler_args + [
+            '-DFFX_FSR3UPSCALER_OPTION_REPROJECT_USE_LANCZOS_TYPE=' + lanczos,
+            '-DFFX_FSR3UPSCALER_OPTION_APPLY_SHARPENING=' + sharpen,
+            '--vn', fsr3_name, '@INPUT@', '-o', '@OUTPUT@' ])
+      endforeach
+    endforeach
+  endforeach
+
+  # [ name, source file ] of the frame interpolation and optical flow passes
+  fsr3_fi_passes = [
+    [ 'compute_game_vector_field_inpainting_pyramid', 'ffx_frameinterpolation_compute_game_vector_field_inpainting_pyramid_pass.glsl' ],
+    [ 'compute_inpainting_pyramid',   'ffx_frameinterpolation_compute_inpainting_pyramid_pass.glsl' ],
+    [ 'debug_view',                   'ffx_frameinterpolation_debug_view_pass.glsl' ],
+    [ 'disocclusion_mask',            'ffx_frameinterpolation_disocclusion_mask_pass.glsl' ],
+    [ 'game_motion_vector_field',     'ffx_frameinterpolation_game_motion_vector_field_pass.glsl' ],
+    [ 'inpainting',                   'ffx_frameinterpolation_inpainting_pass.glsl' ],
+    [ 'interpolation',                'ffx_frameinterpolation_pass.glsl' ],
+    [ 'optical_flow_vector_field',    'ffx_frameinterpolation_optical_flow_vector_field_pass.glsl' ],
+    [ 'reconstruct_and_dilate',       'ffx_frameinterpolation_reconstruct_and_dilate_pass.glsl' ],
+    [ 'reconstruct_previous_depth',   'ffx_frameinterpolation_reconstruct_previous_depth_pass.glsl' ],
+    [ 'setup',                        'ffx_frameinterpolation_setup_pass.glsl' ],
+  ]
+
+  fsr3_of_passes = [
+    [ 'compute_luminance_pyramid',        'ffx_opticalflow_compute_luminance_pyramid_pass.glsl' ],
+    [ 'compute_optical_flow_advanced_v5', 'ffx_opticalflow_compute_optical_flow_advanced_pass_v5.glsl' ],
+    [ 'compute_scd_divergence',           'ffx_opticalflow_compute_scd_divergence_pass.glsl' ],
+    [ 'filter_optical_flow_v5',           'ffx_opticalflow_filter_optical_flow_pass_v5.glsl' ],
+    [ 'generate_scd_histogram',           'ffx_opticalflow_generate_scd_histogram_pass.glsl' ],
+    [ 'prepare_luma',                     'ffx_opticalflow_prepare_luma_pass.glsl' ],
+    [ 'scale_optical_flow_advanced_v5',   'ffx_opticalflow_scale_optical_flow_advanced_pass_v5.glsl' ],
+  ]
+
+  foreach pass : fsr3_fi_passes
+    fsr3_name = 'dxvk_fsr3_fi_' + pass[0]
+    fsr3_shaders += custom_target(fsr3_name,
+      input   : files(fsr3_vk_shader_dir / 'frameinterpolation' / pass[1]),
+      output  : fsr3_name + '.h',
+      command : [ glsl_compiler ] + fsr3_fi_args + [ '--vn', fsr3_name, '@INPUT@', '-o', '@OUTPUT@' ])
+  endforeach
+
+  foreach pass : fsr3_of_passes
+    fsr3_name = 'dxvk_fsr3_of_' + pass[0]
+    fsr3_shaders += custom_target(fsr3_name,
+      input   : files(fsr3_vk_shader_dir / 'opticalflow' / pass[1]),
+      output  : fsr3_name + '.h',
+      command : [ glsl_compiler ] + fsr3_of_args + [ '--vn', fsr3_name, '@INPUT@', '-o', '@OUTPUT@' ])
+  endforeach
+
+  dxvk_fsr3_includes = include_directories(fsr3_sdk_dir / 'include')
+
+  fsr3_includes = [
+    dxvk_fsr3_includes,
+    include_directories(fsr3_sdk_dir / 'src' / 'shared'),
+    include_directories(fsr3_sdk_dir / 'src' / 'backends' / 'shared'),
+    include_directories(fsr3_sdk_dir / 'src' / 'components'),
+  ]
+
+  fsr3_cpp_args = [
+    '-include', meson.current_source_dir() / 'fsr3' / 'dxvk_fsr3_ffx_shim.h',
+  ] + cpp.get_supported_arguments([
+    '-DFFX_GCC',
+    '-DUNICODE',
+    '-D_UNICODE',
+    '-Wno-unused-variable',
+    '-Wno-unused-but-set-variable',
+    '-Wno-unused-function',
+    '-Wno-unused-parameter',
+    '-Wno-sign-compare',
+    '-Wno-deprecated-declarations',
+    '-Wno-missing-field-initializers',
+    '-Wno-implicit-fallthrough',
+    '-Wno-type-limits',
+    '-Wno-switch',
+    '-Wno-class-memaccess',
+    '-Wno-unknown-pragmas',
+    '-Wno-parentheses',
+    '-Wno-format',
+    '-Wno-narrowing',
+    '-Wno-reorder',
+  ])
+
+  dxvk_fsr3_lib = static_library('dxvk_fsr3', [
+      fsr3_sdk_dir / 'src' / 'components' / 'fsr3upscaler' / 'ffx_fsr3upscaler.cpp',
+      fsr3_sdk_dir / 'src' / 'components' / 'frameinterpolation' / 'ffx_frameinterpolation.cpp',
+      fsr3_sdk_dir / 'src' / 'components' / 'opticalflow' / 'ffx_opticalflow.cpp',
+      fsr3_sdk_dir / 'src' / 'backends' / 'vk' / 'ffx_vk.cpp',
+      fsr3_sdk_dir / 'src' / 'shared' / 'ffx_assert.cpp',
+      fsr3_sdk_dir / 'src' / 'shared' / 'ffx_breadcrumbs_list.cpp',
+      fsr3_sdk_dir / 'src' / 'shared' / 'ffx_message.cpp',
+      fsr3_sdk_dir / 'src' / 'shared' / 'ffx_object_management.cpp',
+      'fsr3/dxvk_fsr3_ffx_shim.cpp',
+      'fsr3/dxvk_fsr3_shaders.cpp',
+    ] + fsr3_shaders,
+    include_directories : [ dxvk_include_path ] + fsr3_includes,
+    cpp_args            : fsr3_cpp_args,
+  )
+
