+
+  static FfxResource getFfxImage(
+    const Rc<DxvkImage>&              image,
+          VkFormat                    format,
+          VkExtent2D                  extent,
+          bool                        storage,
+    const wchar_t*                    name,
+          FfxResourceStates           state) {
+    FfxResourceDescription desc = { };
+    desc.type     = FFX_RESOURCE_TYPE_TEXTURE2D;
+    desc.format   = ffxGetSurfaceFormatVK(format);
+    desc.width    = extent.width;
+    desc.height   = extent.height;
+    desc.depth    = 1u;
+    desc.mipCount = 1u;
+    desc.flags    = FFX_RESOURCE_FLAGS_NONE;
+    desc.usage    = storage ? FFX_RESOURCE_USAGE_UAV : FFX_RESOURCE_USAGE_READ_ONLY;
+
+    return ffxGetResourceVK(reinterpret_cast<void*>(image->handle()), desc, name, state);
+  }
+#else
+  struct DxvkFsr3::FfxState { };
+#endif
