+  /**
+   * \brief GeneralsX: SDK contexts of DxvkFsr3
+   */
+  struct DxvkFsr3::FfxState {
+    std::vector<uint8_t>        scratch;
+    FfxInterface                backend = { };
+
+    FfxUInt32                   sharedContextId = 0u;
+    bool                        sharedContextValid = false;
+
+    FfxFsr3UpscalerContext      upscaler = { };
+    bool                        upscalerValid = false;
+
+    /// Shared resources the upscaler writes, as in the SDK's ffx_fsr3.cpp
+    FfxResourceInternal         dilatedDepth = { };
+    FfxResourceInternal         dilatedMotionVectors = { };
+    FfxResourceInternal         reconstructedPrevNearestDepth = { };
+    bool                        sharedResourcesValid = false;
+  };
+
