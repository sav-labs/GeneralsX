+  DxvkFsr3::DxvkFsr3(const Rc<DxvkDevice>& device)
+  : m_device(device) {
+    if (!isAvailable()) {
+      fail("FidelityFX SDK is not part of this DXVK build");
+      return;
+    }
+
+    m_settings = DxvkFsr2::getSettings();
+    m_outputFormat = DxvkFsr2::pickOutputFormat(m_device);
+
+    // GeneralsX: per-pass GPU time with DXVK_FSR_TIMING=1
+    if (DxvkUpscalerTimer::isEnabled())
+      m_timer = std::make_unique<DxvkUpscalerTimer>(m_device, "[FSR3]",
+        std::vector<std::string> { "prepare", "reactive mask", "FSR 3", "composite" });
+
+    Logger::info(str::format("[FSR3] reactive mask ",
+      m_settings.reactiveScale > 0.0f
+        ? str::format("on, value ", m_settings.reactiveScale, ", threshold ", m_settings.reactiveThreshold)
+        : std::string("off"),
+      ", FSR 3 sharpening ",
+      m_settings.sharpness > 0.0f
+        ? str::format(m_settings.sharpness)
+        : std::string("off (FSR 1.0 RCAS sharpens)"),
+      ", output ", m_outputFormat == VK_FORMAT_A2B10G10R10_UNORM_PACK32 ? "10-bit" : "16-bit float",
+      m_settings.debugReactive ? ", debug view of the reactive mask" : ""));
+
+    createPipelines();
+
+    DxvkSamplerKey samplerKey = { };
+    samplerKey.setFilter(VK_FILTER_NEAREST, VK_FILTER_NEAREST, VK_SAMPLER_MIPMAP_MODE_NEAREST);
+    samplerKey.setAddressModes(
+      VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE);
+    m_pointSampler = m_device->createSampler(samplerKey);
+
+    samplerKey.setFilter(VK_FILTER_LINEAR, VK_FILTER_LINEAR, VK_SAMPLER_MIPMAP_MODE_NEAREST);
+    m_linearSampler = m_device->createSampler(samplerKey);
+  }
+
