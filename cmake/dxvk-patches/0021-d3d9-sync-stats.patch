+  // GeneralsX: main thread waits for the GPU and the CS thread
+  GeneralsXSyncTotals g_gxSyncTotals;
+
+  void GeneralsXRecordWait(const GeneralsXWaitInfo& Info, uint64_t Us) {
+    // Waits shorter than 50 us are the normal cost of a lock
+    if (Us < 50u)
+      return;
+
+    uint32_t kind = std::min(Info.kind, 3u);
+    g_gxSyncTotals.waits[kind] += 1u;
+    g_gxSyncTotals.waitUs[kind] += Us;
+
+    if (Us > g_gxSyncTotals.slowestUs) {
+      g_gxSyncTotals.slowestUs = uint32_t(std::min<uint64_t>(Us, UINT32_MAX));
+      g_gxSyncTotals.slowest = Info;
+    }
+  }
+
+
   bool D3D9DeviceEx::WaitForResource(
+    const DxvkPagedResource&                Resource,
+          uint64_t                          SequenceNumber,
+          DWORD                             MapFlags,
+    const GeneralsXWaitInfo*                pWaitInfo) {
+    // GeneralsX: time the wait, including the CS thread synchronization
+    GeneralsXWaitInfo waitInfo = { 2u };
+
+    if (pWaitInfo)
+      waitInfo = *pWaitInfo;
+
+    auto waitStart = dxvk::high_resolution_clock::now();
+    g_gxSyncTotals.waitDepth += 1u;
+
+    bool result = WaitForResourceImpl(Resource, SequenceNumber, MapFlags);
+
+    g_gxSyncTotals.waitDepth -= 1u;
+    GeneralsXRecordWait(waitInfo, uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+      dxvk::high_resolution_clock::now() - waitStart).count()));
+    return result;
+  }
