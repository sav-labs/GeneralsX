+  // GeneralsX: running totals of the main thread waits for the GPU and
+  // the CS thread, for the game's frame hitch report. The layout is
+  // shared with the game (W3DDisplay.cpp) and checked with the size
+  // field. Kinds: buffer lock, texture lock, other resource wait, CS
+  // thread synchronization. The slowest wait since the previous call is
+  // described by its kind, size or texture extent, format, pool and usage.
+  struct GeneralsXSyncStats {
+    uint32_t size;
+    uint32_t waits[4];
+    uint64_t waitUs[4];
+    uint32_t slowestUs;
+    uint32_t slowestKind;
+    uint32_t slowestWidth;
+    uint32_t slowestHeight;
+    uint32_t slowestFormat;
+    uint32_t slowestPool;
+    uint32_t slowestUsage;
+    uint32_t slowestSize;
+  };
+
+  DLLEXPORT BOOL __stdcall GeneralsX_GetSyncStats(void* pStats) {
+    auto stats = reinterpret_cast<GeneralsXSyncStats*>(pStats);
+
+    if (!stats || stats->size != sizeof(GeneralsXSyncStats))
+      return FALSE;
+
+    auto& totals = dxvk::g_gxSyncTotals;
+
+    for (uint32_t i = 0; i < 4; i++) {
+      stats->waits[i]  = totals.waits[i].load();
+      stats->waitUs[i] = totals.waitUs[i].load();
+    }
+
+    stats->slowestUs     = totals.slowestUs;
+    stats->slowestKind   = totals.slowest.kind;
+    stats->slowestWidth  = totals.slowest.width;
+    stats->slowestHeight = totals.slowest.height;
+    stats->slowestFormat = totals.slowest.format;
+    stats->slowestPool   = totals.slowest.pool;
+    stats->slowestUsage  = totals.slowest.usage;
+    stats->slowestSize   = totals.slowest.size;
+
+    totals.slowestUs = 0u;
+    totals.slowest = { };
+    return TRUE;
+  }
+
   DLLEXPORT int __stdcall D3DPERF_BeginEvent(D3DCOLOR col, LPCWSTR wszName) {
