+
+  Rc<DxvkImageView> DxvkFsr2::render(
+    const DxvkContextObjects&         ctx,
+    const DxvkTemporalUpscaleInputs&  inputs,
+    const Rc<DxvkImageView>&          finalView,
+          VkRect2D                    finalRect,
+    const Rc<DxvkImageView>&          spatialView,
+          VkExtent2D                  extent) {
+    if (m_failed || inputs.color == nullptr || inputs.depth == nullptr)
+      return nullptr;
+
+    VkExtent3D colorExtent = inputs.color->mipLevelExtent(0u);
+    VkExtent2D renderExtent = { colorExtent.width, colorExtent.height };
+
+    if (renderExtent != m_renderExtent || extent != m_displayExtent || !m_contextValid) {
+      // Resources of the old context may still be in use by earlier frames
+      if (m_contextValid)
+        m_device->waitForIdle();
+
+      destroyContext();
+
+      if (!createContext(renderExtent, extent))
+        return nullptr;
+
+      createImages(renderExtent, extent);
+      m_havePrev = false;
+    }
+
+    if (unlikely(m_device->debugFlags().test(DxvkDebugFlag::Capture))) {
+      ctx.cmd->cmdBeginDebugUtilsLabel(DxvkCmdBuffer::ExecBuffer,
+        vk::makeLabel(0xdcc0f0, "FSR 2"));
+    }
+
+    // Everything written before, the scene copies by the D3D9 device, the
+    // EASU pass and the back buffer, is read by the compute passes below.
+    VkMemoryBarrier2 memBarrier = { VK_STRUCTURE_TYPE_MEMORY_BARRIER_2 };
+    memBarrier.srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    memBarrier.srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT;
+    memBarrier.dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    memBarrier.dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT;
+
+    VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    depInfo.memoryBarrierCount = 1;
+    depInfo.pMemoryBarriers = &memBarrier;
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    preparePass(ctx, inputs);
+
+    bool success = dispatchFsr2(ctx, inputs);
+
+    if (success)
+      compositePass(ctx, inputs, finalView, finalRect, spatialView);
+
+    // DXVK does not know about the compute reads above, so make sure that
+    // later writes to the back buffer and the scene copies wait for them.
+    VkMemoryBarrier2 readBarrier = { VK_STRUCTURE_TYPE_MEMORY_BARRIER_2 };
+    readBarrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    readBarrier.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+
+    depInfo.pMemoryBarriers = &readBarrier;
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+
+    if (unlikely(m_device->debugFlags().test(DxvkDebugFlag::Capture)))
+      ctx.cmd->cmdEndDebugUtilsLabel(DxvkCmdBuffer::ExecBuffer);
+
+    ctx.cmd->track(inputs.color->image(), DxvkAccess::Read);
+    ctx.cmd->track(inputs.depth->image(), DxvkAccess::Read);
+    ctx.cmd->track(finalView->image(), DxvkAccess::Read);
+    ctx.cmd->track(spatialView->image(), DxvkAccess::Read);
+    ctx.cmd->track(m_depthImage, DxvkAccess::Write);
+    ctx.cmd->track(m_motionImage, DxvkAccess::Write);
+    ctx.cmd->track(m_outputImage, DxvkAccess::Write);
+    ctx.cmd->track(m_compositeImage, DxvkAccess::Write);
+    ctx.cmd->track(m_pointSampler);
+    ctx.cmd->track(m_linearSampler);
+
+    if (!success)
+      return nullptr;
+
+    m_prevViewProj = inputs.viewProj;
+    m_havePrev = true;
+    m_frameCount += 1u;
+
+    if (m_frameCount == 1u || !(m_frameCount % 600u)) {
+      Logger::info(str::format("FSR2: frame ", m_frameCount, ", ",
+        renderExtent.width, "x", renderExtent.height, " to ", extent.width, "x", extent.height,
+        ", jitter ", inputs.jitter[0], " ", inputs.jitter[1],
+        ", near ", inputs.cameraNear, ", far ", inputs.cameraFar,
+        ", frame time ", inputs.frameTimeMs, " ms"));
+    }
+
+    return m_compositeView;
+  }
