+if fs.is_file(fsr2_api_dir / 'ffx_fsr2.cpp')
+  fsr2_shader_dir = meson.current_source_dir() / fsr2_api_dir / 'shaders'
+
+  fsr2_glsl_args = [
+    '--quiet',
+    '--target-env', 'vulkan1.1',
+    '-S', 'comp',
