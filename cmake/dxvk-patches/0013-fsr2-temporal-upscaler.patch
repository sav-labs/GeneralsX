+  bool DxvkFsr2::createContext(VkExtent2D renderExtent, VkExtent2D displayExtent) {
+#ifdef DXVK_GENERALSX_FSR2
+    auto vki = m_device->vki();
+
+    PFN_vkGetDeviceProcAddr getDeviceProcAddr = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+      vki->getLoaderProc()(vki->instance(), "vkGetDeviceProcAddr"));
+
+    if (!getDeviceProcAddr) {
+      fail("vkGetDeviceProcAddr not found");
+      return false;
+    }
+
+    g_dxvkFsr2Vk.enumerateDeviceExtensionProperties = vki->vkEnumerateDeviceExtensionProperties;
+    g_dxvkFsr2Vk.getPhysicalDeviceMemoryProperties  = vki->vkGetPhysicalDeviceMemoryProperties;
+    g_dxvkFsr2Vk.getPhysicalDeviceProperties        = vki->vkGetPhysicalDeviceProperties;
+    g_dxvkFsr2Vk.getPhysicalDeviceProperties2       = vki->vkGetPhysicalDeviceProperties2;
+    g_dxvkFsr2Vk.getPhysicalDeviceFeatures2         = vki->vkGetPhysicalDeviceFeatures2;
+    g_dxvkFsr2Vk.getDeviceProcAddr                  = getDeviceProcAddr;
+
+    VkPhysicalDevice adapter = m_device->adapter()->handle();
+
+    m_scratch.resize(ffxFsr2GetScratchMemorySizeVK(adapter));
+    std::memset(m_scratch.data(), 0, m_scratch.size());
+
+    FfxFsr2ContextDescription desc = { };
+    FfxErrorCode error = ffxFsr2GetInterfaceVK(&desc.callbacks,
+      m_scratch.data(), m_scratch.size(), adapter, getDeviceProcAddr);
+
+    if (error != FFX_OK) {
+      fail(str::format("ffxFsr2GetInterfaceVK failed: ", error));
+      return false;
+    }
+
+    // The game renders LDR colour without an exposure value. Motion vectors
+    // are at render resolution and computed without jitter.
+    desc.flags = FFX_FSR2_ENABLE_AUTO_EXPOSURE;
+    desc.maxRenderSize = { renderExtent.width, renderExtent.height };
+    desc.displaySize = { displayExtent.width, displayExtent.height };
+    desc.device = ffxGetDeviceVK(m_device->handle());
+
+    m_context = std::make_unique<uint8_t[]>(sizeof(FfxFsr2Context));
+    std::memset(m_context.get(), 0, sizeof(FfxFsr2Context));
+
+    error = ffxFsr2ContextCreate(reinterpret_cast<FfxFsr2Context*>(m_context.get()), &desc);
+
+    if (error != FFX_OK) {
+      m_context = nullptr;
+      fail(str::format("ffxFsr2ContextCreate failed: ", error));
+      return false;
+    }
+
+    m_contextValid = true;
+    m_renderExtent = renderExtent;
+    m_displayExtent = displayExtent;
+
+    Logger::info(str::format("FSR2: context created, render ", renderExtent.width, "x", renderExtent.height,
+      ", display ", displayExtent.width, "x", displayExtent.height,
+      ", FidelityFX FSR ", FFX_FSR2_VERSION_MAJOR, ".", FFX_FSR2_VERSION_MINOR, ".", FFX_FSR2_VERSION_PATCH));
+    return true;
+#else
+    return false;
+#endif
+  }
+
+
+  void DxvkFsr2::destroyContext() {
+#ifdef DXVK_GENERALSX_FSR2
+    if (m_contextValid) {
+      m_device->waitForIdle();
+      ffxFsr2ContextDestroy(reinterpret_cast<FfxFsr2Context*>(m_context.get()));
+    }
+#endif
+
+    m_contextValid = false;
+    m_context = nullptr;
+    m_renderExtent = { 0u, 0u };
+    m_displayExtent = { 0u, 0u };
+  }
