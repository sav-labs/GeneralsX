+extern DxvkFsr2VkTable g_dxvkFsr2Vk;
diff --git a/src/dxvk/fsr2/dxvk_fsr2_shaders.cpp b/src/dxvk/fsr2/dxvk_fsr2_shaders.cpp
new file mode 100644
--- /dev/null
+++ b/src/dxvk/fsr2/dxvk_fsr2_shaders.cpp
@@ -0,0 +1,266 @@
+// GeneralsX: SPIR-V permutations of the FidelityFX FSR 2 passes.
+//
+// Replaces ffx_fsr2_shaders_vk.cpp, whose tables are generated by AMD's
+// Windows-only FidelityFX_SC tool. The passes are compiled with glslang at
+// build time (see meson.build) for the options DXVK uses: LDR colour,
+// render-resolution motion vectors without jitter, standard depth and
+// 32-bit maths. Only the reprojection Lanczos type and, for the accumulate
+// pass, the sharpening switch vary. The resource names and bindings the
+// backend needs are read from the SPIR-V itself.
+
+#include "ffx-fsr2-api/vk/shaders/ffx_fsr2_shaders_vk.h"
+
+#include <array>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <dxvk_fsr2_accumulate_l0_s0.h>
+#include <dxvk_fsr2_accumulate_l0_s1.h>
+#include <dxvk_fsr2_accumulate_l1_s0.h>
+#include <dxvk_fsr2_accumulate_l1_s1.h>
+#include <dxvk_fsr2_autogen_reactive_l0_s0.h>
+#include <dxvk_fsr2_autogen_reactive_l1_s0.h>
+#include <dxvk_fsr2_compute_luminance_pyramid_l0_s0.h>
+#include <dxvk_fsr2_compute_luminance_pyramid_l1_s0.h>
+#include <dxvk_fsr2_depth_clip_l0_s0.h>
+#include <dxvk_fsr2_depth_clip_l1_s0.h>
+#include <dxvk_fsr2_lock_l0_s0.h>
+#include <dxvk_fsr2_lock_l1_s0.h>
+#include <dxvk_fsr2_rcas_l0_s0.h>
+#include <dxvk_fsr2_rcas_l1_s0.h>
+#include <dxvk_fsr2_reconstruct_previous_depth_l0_s0.h>
+#include <dxvk_fsr2_reconstruct_previous_depth_l1_s0.h>
+#include <dxvk_fsr2_tcr_autogen_l0_s0.h>
+#include <dxvk_fsr2_tcr_autogen_l1_s0.h>
+
+namespace {
+
+  struct Fsr2SpirvCode {
+    const uint32_t* code;
+    size_t          size;
+  };
+
+  struct Fsr2ReflectedBlob {
+    std::vector<std::string>  names[3];
+    std::vector<const char*>  namePtrs[3];
+    std::vector<uint32_t>     bindings[3];
+    Fsr2ShaderBlobVK          blob = { };
+    bool                      valid = false;
+  };
+
+  enum Fsr2ResourceKind : uint32_t {
+    Fsr2StorageImage  = 0,
+    Fsr2SampledImage  = 1,
+    Fsr2UniformBuffer = 2,
+  };
+
+  constexpr uint32_t SpvOpName          = 5;
+  constexpr uint32_t SpvOpTypeImage     = 25;
+  constexpr uint32_t SpvOpTypeStruct    = 30;
+  constexpr uint32_t SpvOpTypePointer   = 32;
+  constexpr uint32_t SpvOpVariable      = 59;
+  constexpr uint32_t SpvOpDecorate      = 71;
+
+  constexpr uint32_t SpvDecorationBinding       = 33;
+  constexpr uint32_t SpvDecorationDescriptorSet = 34;
+
+  constexpr uint32_t SpvStorageClassUniformConstant = 0;
+  constexpr uint32_t SpvStorageClassUniform         = 2;
+
+  /**
+   * \brief Lists the descriptor set 1 resources of a pass
+   *
+   * Set 0 holds the two samplers the backend binds itself.
+   */
+  void reflectSpirv(const Fsr2SpirvCode& spirv, Fsr2ReflectedBlob& out) {
+    const uint32_t* words = spirv.code;
+    size_t count = spirv.size / sizeof(uint32_t);
+
+    if (count < 5u)
+      return;
+
+    uint32_t bound = words[3];
+
+    std::vector<std::string> names(bound);
+    std::vector<int32_t>     bindings(bound, -1);
+    std::vector<int32_t>     sets(bound, -1);
+    std::vector<int32_t>     imageSampled(bound, -1);
+    std::vector<bool>        isStruct(bound, false);
+    std::vector<uint32_t>    pointee(bound, 0u);
+
+    struct Variable {
+      uint32_t id;
+      uint32_t type;
+      uint32_t storageClass;
+    };
+
+    std::vector<Variable> variables;
+
+    for (size_t i = 5u; i < count; ) {
+      uint32_t opcode = words[i] & 0xffffu;
+      uint32_t length = words[i] >> 16u;
+
+      if (!length || i + length > count)
+        return;
+
+      const uint32_t* ins = &words[i];
+
+      switch (opcode) {
+        case SpvOpName:
+          if (length > 2u && ins[1] < bound)
+            names[ins[1]] = reinterpret_cast<const char*>(&ins[2]);
+          break;
+
+        case SpvOpDecorate:
+          if (length > 3u && ins[1] < bound) {
+            if (ins[2] == SpvDecorationBinding)
+              bindings[ins[1]] = int32_t(ins[3]);
+            else if (ins[2] == SpvDecorationDescriptorSet)
+              sets[ins[1]] = int32_t(ins[3]);
+          }
+          break;
+
+        case SpvOpTypeImage:
+          if (length > 7u && ins[1] < bound)
+            imageSampled[ins[1]] = int32_t(ins[7]);
+          break;
+
+        case SpvOpTypeStruct:
+          if (length > 1u && ins[1] < bound)
+            isStruct[ins[1]] = true;
+          break;
+
+        case SpvOpTypePointer:
+          if (length > 3u && ins[1] < bound)
+            pointee[ins[1]] = ins[3];
+          break;
+
+        case SpvOpVariable:
+          if (length > 3u && ins[2] < bound)
+            variables.push_back({ ins[2], ins[1], ins[3] });
+          break;
+
+        default:
+          break;
+      }
+
+      i += length;
+    }
+
+    for (const auto& var : variables) {
+      if (sets[var.id] != 1 || bindings[var.id] < 0 || var.type >= bound)
+        continue;
+
+      uint32_t type = pointee[var.type];
+
+      if (type >= bound)
+        continue;
+
+      int32_t kind = -1;
+
+      if (var.storageClass == SpvStorageClassUniformConstant && imageSampled[type] == 2)
+        kind = Fsr2StorageImage;
+      else if (var.storageClass == SpvStorageClassUniformConstant && imageSampled[type] == 1)
+        kind = Fsr2SampledImage;
+      else if (var.storageClass == SpvStorageClassUniform && isStruct[type])
+        kind = Fsr2UniformBuffer;
+
+      if (kind < 0)
+        continue;
+
+      out.names[kind].push_back(names[var.id]);
+      out.bindings[kind].push_back(uint32_t(bindings[var.id]));
+    }
+
+    for (uint32_t k = 0; k < 3u; k++) {
+      for (const auto& name : out.names[k])
+        out.namePtrs[k].push_back(name.c_str());
+    }
+
+    out.blob.data = reinterpret_cast<const uint8_t*>(spirv.code);
+    out.blob.size = uint32_t(spirv.size);
+    out.blob.storageImageCount  = uint32_t(out.names[Fsr2StorageImage].size());
+    out.blob.sampledImageCount  = uint32_t(out.names[Fsr2SampledImage].size());
+    out.blob.uniformBufferCount = uint32_t(out.names[Fsr2UniformBuffer].size());
+    out.blob.boundStorageImageNames     = out.namePtrs[Fsr2StorageImage].data();
+    out.blob.boundStorageImageBindings  = out.bindings[Fsr2StorageImage].data();
+    out.blob.boundSampledImageNames     = out.namePtrs[Fsr2SampledImage].data();
+    out.blob.boundSampledImageBindings  = out.bindings[Fsr2SampledImage].data();
+    out.blob.boundUniformBufferNames    = out.namePtrs[Fsr2UniformBuffer].data();
+    out.blob.boundUniformBufferBindings = out.bindings[Fsr2UniformBuffer].data();
+    out.valid = true;
+  }
+
+
+  /// Index of a permutation: pass, Lanczos type, sharpening
+  uint32_t getPermutationIndex(uint32_t pass, bool lanczos, bool sharpen) {
+    return pass * 4u + (lanczos ? 2u : 0u) + (sharpen ? 1u : 0u);
+  }
+
+
+  Fsr2SpirvCode getSpirv(FfxFsr2Pass pass, bool lanczos, bool sharpen) {
+#define DXVK_FSR2_SPIRV(name) Fsr2SpirvCode { name, sizeof(name) }
+    switch (pass) {
+      case FFX_FSR2_PASS_DEPTH_CLIP:
+        return lanczos ? DXVK_FSR2_SPIRV(dxvk_fsr2_depth_clip_l1_s0)
+                       : DXVK_FSR2_SPIRV(dxvk_fsr2_depth_clip_l0_s0);
+      case FFX_FSR2_PASS_RECONSTRUCT_PREVIOUS_DEPTH:
+        return lanczos ? DXVK_FSR2_SPIRV(dxvk_fsr2_reconstruct_previous_depth_l1_s0)
+                       : DXVK_FSR2_SPIRV(dxvk_fsr2_reconstruct_previous_depth_l0_s0);
+      case FFX_FSR2_PASS_LOCK:
+        return lanczos ? DXVK_FSR2_SPIRV(dxvk_fsr2_lock_l1_s0)
+                       : DXVK_FSR2_SPIRV(dxvk_fsr2_lock_l0_s0);
+      case FFX_FSR2_PASS_ACCUMULATE:
+      case FFX_FSR2_PASS_ACCUMULATE_SHARPEN:
+        if (sharpen)
+          return lanczos ? DXVK_FSR2_SPIRV(dxvk_fsr2_accumulate_l1_s1)
+                         : DXVK_FSR2_SPIRV(dxvk_fsr2_accumulate_l0_s1);
+        return lanczos ? DXVK_FSR2_SPIRV(dxvk_fsr2_accumulate_l1_s0)
+                       : DXVK_FSR2_SPIRV(dxvk_fsr2_accumulate_l0_s0);
+      case FFX_FSR2_PASS_RCAS:
+        return lanczos ? DXVK_FSR2_SPIRV(dxvk_fsr2_rcas_l1_s0)
+                       : DXVK_FSR2_SPIRV(dxvk_fsr2_rcas_l0_s0);
+      case FFX_FSR2_PASS_COMPUTE_LUMINANCE_PYRAMID:
+        return lanczos ? DXVK_FSR2_SPIRV(dxvk_fsr2_compute_luminance_pyramid_l1_s0)
+                       : DXVK_FSR2_SPIRV(dxvk_fsr2_compute_luminance_pyramid_l0_s0);
+      case FFX_FSR2_PASS_GENERATE_REACTIVE:
+        return lanczos ? DXVK_FSR2_SPIRV(dxvk_fsr2_autogen_reactive_l1_s0)
+                       : DXVK_FSR2_SPIRV(dxvk_fsr2_autogen_reactive_l0_s0);
+      case FFX_FSR2_PASS_TCR_AUTOGENERATE:
+        return lanczos ? DXVK_FSR2_SPIRV(dxvk_fsr2_tcr_autogen_l1_s0)
+                       : DXVK_FSR2_SPIRV(dxvk_fsr2_tcr_autogen_l0_s0);
+      default:
+        return Fsr2SpirvCode { nullptr, 0u };
+    }
+#undef DXVK_FSR2_SPIRV
+  }
+
+}
+
+
+Fsr2ShaderBlobVK fsr2GetPermutationBlobByIndexVK(FfxFsr2Pass passId, uint32_t permutationOptions) {
+  static std::mutex s_mutex;
+  static std::array<Fsr2ReflectedBlob, FFX_FSR2_PASS_COUNT * 4u> s_blobs;
+
+  bool lanczos = (permutationOptions & FSR2_SHADER_PERMUTATION_REPROJECT_USE_LANCZOS_TYPE) != 0u;
+  bool sharpen = (permutationOptions & FSR2_SHADER_PERMUTATION_ENABLE_SHARPENING) != 0u;
+
+  if (uint32_t(passId) >= uint32_t(FFX_FSR2_PASS_COUNT))
+    return Fsr2ShaderBlobVK { };
+
+  std::lock_guard lock(s_mutex);
+
+  Fsr2ReflectedBlob& entry = s_blobs[getPermutationIndex(uint32_t(passId), lanczos, sharpen)];
+
+  if (!entry.valid) {
+    Fsr2SpirvCode spirv = getSpirv(passId, lanczos, sharpen);
+
+    if (!spirv.code)
+      return Fsr2ShaderBlobVK { };
+
+    reflectSpirv(spirv, entry);
+  }
+
+  return entry.blob;
+}
diff --git a/src/dxvk/shaders/dxvk_fsr2_composite.comp b/src/dxvk/shaders/dxvk_fsr2_composite.comp
new file mode 100644
--- /dev/null
+++ b/src/dxvk/shaders/dxvk_fsr2_composite.comp
@@ -0,0 +1,59 @@
+#version 450
+
+// GeneralsX: composites the FSR 2 output of the 3D scene with the final
+// image. Pixels where the final image differs from the scene copy taken
+// before the interface was drawn belong to the interface; they come from
+// the spatially (FSR 1 EASU) upscaled final image, so the interface is
+// never part of the temporal history and does not ghost.
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(set = 0, binding = 0) uniform sampler2D s_fsr2;
+layout(set = 0, binding = 1) uniform sampler2D s_spatial;
+layout(set = 0, binding = 2) uniform sampler2D s_final;
+layout(set = 0, binding = 3) uniform sampler2D s_scene;
+layout(set = 0, binding = 4, rgba16f) writeonly uniform image2D o_color;
+
+layout(push_constant)
+uniform push_t {
+  vec2  inv_output_extent;
+  uvec2 input_extent;
+  float threshold;
+};
+
+float interfaceWeight(ivec2 coord) {
+  coord = clamp(coord, ivec2(0), ivec2(input_extent) - 1);
+
+  vec3 final_color = texelFetch(s_final, coord, 0).rgb;
+  vec3 scene_color = texelFetch(s_scene, coord, 0).rgb;
+  vec3 diff = abs(final_color - scene_color);
+
+  return smoothstep(threshold, 4.0f * threshold, max(diff.r, max(diff.g, diff.b)));
+}
+
+void main() {
+  ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
+  ivec2 size = imageSize(o_color);
+
+  if (any(greaterThanEqual(coord, size)))
+    return;
+
+  vec2 uv = (vec2(coord) + 0.5f) * inv_output_extent;
+
+  // Interface mask at render size, bilinearly interpolated
+  vec2 pos = uv * vec2(input_extent) - 0.5f;
+  ivec2 base = ivec2(floor(pos));
+  vec2 f = pos - vec2(base);
+
+  float w00 = interfaceWeight(base);
+  float w10 = interfaceWeight(base + ivec2(1, 0));
+  float w01 = interfaceWeight(base + ivec2(0, 1));
+  float w11 = interfaceWeight(base + ivec2(1, 1));
+
+  float ui = mix(mix(w00, w10, f.x), mix(w01, w11, f.x), f.y);
+
+  vec4 temporal = textureLod(s_fsr2, uv, 0.0f);
+  vec4 spatial = textureLod(s_spatial, uv, 0.0f);
+
+  imageStore(o_color, coord, vec4(mix(temporal.rgb, spatial.rgb, ui), 1.0f));
+}
diff --git a/src/dxvk/shaders/dxvk_fsr2_prepare.comp b/src/dxvk/shaders/dxvk_fsr2_prepare.comp
new file mode 100644
--- /dev/null
+++ b/src/dxvk/shaders/dxvk_fsr2_prepare.comp
@@ -0,0 +1,53 @@
+#version 450
+
+// GeneralsX: FSR 2 inputs from the scene depth. Copies the depth into a
+// colour image and computes camera motion vectors by reprojecting every
+// pixel into the previous frame. Moving objects only get the camera's
+// motion; FSR 2 handles the rest with its locks and depth clipping.
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(set = 0, binding = 0) uniform sampler2D s_depth;
+layout(set = 0, binding = 1, r32f)  writeonly uniform image2D o_depth;
+layout(set = 0, binding = 2, rg16f) writeonly uniform image2D o_motion;
+
+layout(push_constant)
+uniform push_t {
+  // Current to previous clip space, see DxvkFsr2::preparePass
+  mat4  reproject;
+  // Jitter of the current frame in normalized device coordinates
+  vec2  jitter_ndc;
+  uvec2 extent;
+  // 3D viewport in pixels: x, y, width, height
+  vec4  viewport;
+};
+
+void main() {
+  uvec2 coord = gl_GlobalInvocationID.xy;
+
+  if (any(greaterThanEqual(coord, extent)))
+    return;
+
+  float depth = texelFetch(s_depth, ivec2(coord), 0).r;
+
+  // D3D clip space has y pointing up, the image has row 0 at the top.
+  // Removing the jitter gives the position the unjittered camera sees.
+  vec2 uv = (vec2(coord) + 0.5f - viewport.xy) / viewport.zw;
+  vec2 ndc = vec2(uv.x * 2.0f - 1.0f, 1.0f - uv.y * 2.0f) - jitter_ndc;
+
+  vec4 prev = reproject * vec4(ndc, depth, 1.0f);
+  vec2 motion = vec2(0.0f);
+
+  bool inside = all(greaterThanEqual(uv, vec2(0.0f))) && all(lessThanEqual(uv, vec2(1.0f)));
+
+  if (inside && prev.w > 1.0e-6f) {
+    vec2 prev_ndc = prev.xy / prev.w;
+    // FSR 2 adds the vector to the current UV of the whole image to find
+    // the previous one, so the viewport's share of the image scales it
+    motion = vec2(prev_ndc.x - ndc.x, ndc.y - prev_ndc.y) * 0.5f
+           * viewport.zw / vec2(extent);
+  }
+
+  imageStore(o_depth, ivec2(coord), vec4(depth, 0.0f, 0.0f, 0.0f));
+  imageStore(o_motion, ivec2(coord), vec4(motion, 0.0f, 0.0f));
+}
