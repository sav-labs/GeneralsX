+  std::atomic<bool> DxvkFsr2::s_temporalActive = { false };
+
+
+  DxvkFsr2::DxvkFsr2(const Rc<DxvkDevice>& device)
+  : m_device(device) {
+    if (!isAvailable()) {
+      fail("FidelityFX FSR 2 is not part of this DXVK build");
+      return;
+    }
+
+    createPipelines();
+
+    DxvkSamplerKey samplerKey = { };
+    samplerKey.setFilter(VK_FILTER_NEAREST, VK_FILTER_NEAREST, VK_SAMPLER_MIPMAP_MODE_NEAREST);
+    samplerKey.setAddressModes(
+      VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE);
+    m_pointSampler = m_device->createSampler(samplerKey);
+
+    samplerKey.setFilter(VK_FILTER_LINEAR, VK_FILTER_LINEAR, VK_SAMPLER_MIPMAP_MODE_NEAREST);
+    m_linearSampler = m_device->createSampler(samplerKey);
+  }
+
+
+  DxvkFsr2::~DxvkFsr2() {
+    destroyContext();
+
+    auto vk = m_device->vkd();
+
+    vk->vkDestroyPipeline(vk->device(), m_preparePipeline, nullptr);
+    vk->vkDestroyPipelineLayout(vk->device(), m_preparePipelineLayout, nullptr);
+    vk->vkDestroyDescriptorSetLayout(vk->device(), m_prepareSetLayout, nullptr);
+
+    vk->vkDestroyPipeline(vk->device(), m_compositePipeline, nullptr);
+    vk->vkDestroyPipelineLayout(vk->device(), m_compositePipelineLayout, nullptr);
+    vk->vkDestroyDescriptorSetLayout(vk->device(), m_compositeSetLayout, nullptr);
+  }
+
+
+  bool DxvkFsr2::isAvailable() {
+#ifdef DXVK_GENERALSX_FSR2
+    return true;
+#else
+    return false;
+#endif
+  }
