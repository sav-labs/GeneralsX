+  void DxvkSwapchainBlitter::writeCapture() {
+    const DxvkImageCreateInfo& info = m_captureImage->info();
+    const uint32_t width = info.extent.width;
+    const uint32_t height = info.extent.height;
+    const bool bgra = info.format == VK_FORMAT_B8G8R8A8_UNORM
+                   || info.format == VK_FORMAT_B8G8R8A8_SRGB;
+
+    auto pushBigEndian = [] (std::vector<uint8_t>& dst, uint32_t value) {
+      dst.push_back(uint8_t(value >> 24));
+      dst.push_back(uint8_t(value >> 16));
+      dst.push_back(uint8_t(value >> 8));
+      dst.push_back(uint8_t(value));
+    };
+
+    // PNG scanlines: filter byte, then RGB
+    const size_t rowSize = 1u + size_t(width) * 3u;
+    std::vector<uint8_t> raw(rowSize * height);
+    auto src = reinterpret_cast<const uint8_t*>(m_captureBuffer->mapPtr(0));
+
+    for (uint32_t y = 0; y < height; y++) {
+      uint8_t* dst = &raw[rowSize * y];
+      *(dst++) = 0u;
+
+      for (uint32_t x = 0; x < width; x++) {
+        const uint8_t* px = &src[(size_t(y) * width + x) * 4u];
+        *(dst++) = px[bgra ? 2 : 0];
+        *(dst++) = px[1];
+        *(dst++) = px[bgra ? 0 : 2];
+      }
+    }
+
+    // zlib stream with stored (uncompressed) deflate blocks
+    std::vector<uint8_t> zlib = { 0x78u, 0x01u };
+    uint32_t adlerA = 1u, adlerB = 0u;
+
+    for (size_t offset = 0; offset < raw.size(); ) {
+      size_t length = std::min<size_t>(raw.size() - offset, 65535u);
+      bool last = offset + length == raw.size();
+
+      zlib.push_back(last ? 1u : 0u);
+      zlib.push_back(uint8_t(length));
+      zlib.push_back(uint8_t(length >> 8));
+      zlib.push_back(uint8_t(~length));
+      zlib.push_back(uint8_t(~length >> 8));
+      zlib.insert(zlib.end(), raw.begin() + offset, raw.begin() + offset + length);
+
+      for (size_t i = offset; i < offset + length; i++) {
+        adlerA = (adlerA + raw[i]) % 65521u;
+        adlerB = (adlerB + adlerA) % 65521u;
+      }
+
+      offset += length;
+    }
+
+    pushBigEndian(zlib, (adlerB << 16) | adlerA);
+
+    std::array<uint32_t, 256> crcTable;
+
+    for (uint32_t n = 0; n < 256; n++) {
+      uint32_t c = n;
+
+      for (uint32_t k = 0; k < 8; k++)
+        c = (c & 1u) ? 0xedb88320u ^ (c >> 1) : (c >> 1);
+
+      crcTable[n] = c;
+    }
+
+    std::vector<uint8_t> png = { 0x89u, 'P', 'N', 'G', 0x0du, 0x0au, 0x1au, 0x0au };
+
+    auto writeChunk = [&] (const char* type, const std::vector<uint8_t>& data) {
+      pushBigEndian(png, uint32_t(data.size()));
+
+      size_t crcStart = png.size();
+      png.insert(png.end(), type, type + 4);
+      png.insert(png.end(), data.begin(), data.end());
+
+      uint32_t crc = 0xffffffffu;
+
+      for (size_t i = crcStart; i < png.size(); i++)
+        crc = crcTable[(crc ^ png[i]) & 0xffu] ^ (crc >> 8);
+
+      pushBigEndian(png, crc ^ 0xffffffffu);
+    };
+
+    // 8-bit RGB, no interlacing
+    std::vector<uint8_t> header;
+    pushBigEndian(header, width);
+    pushBigEndian(header, height);
+    header.insert(header.end(), { 8u, 2u, 0u, 0u, 0u });
+
+    writeChunk("IHDR", header);
+    writeChunk("IDAT", zlib);
+    writeChunk("IEND", { });
+
+    // Write a temporary file first so readers never see a partial image
+    std::string tmpPath = m_capturePath + ".tmp";
+
+    {
+      std::ofstream file(str::topath(tmpPath.c_str()).c_str(), std::ios::binary | std::ios::trunc);
+
+      if (!file.write(reinterpret_cast<const char*>(png.data()), png.size())) {
+        Logger::warn(str::format("Swap chain: failed to write ", tmpPath));
+        return;
+      }
+    }
+
+    std::remove(m_capturePath.c_str());
+
+    if (std::rename(tmpPath.c_str(), m_capturePath.c_str()))
+      Logger::warn(str::format("Swap chain: failed to replace ", m_capturePath));
+    else
+      Logger::info(str::format("Swap chain: captured ", width, "x", height, " frame to ", m_capturePath));
+  }
