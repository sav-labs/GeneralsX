+
+    // The writer is created up to a second before recording starts,
+    // so that starting the encoder does not delay the first frames.
+    if (m_videoState == VideoState::Waiting && m_videoWriter
+     && now - m_videoFirstPresent >= m_videoStart) {
+      m_videoState = VideoState::Recording;
+      m_videoBegin = now;
+    }
+
+    // Frames before recording starts go through the same passes without
+    // a readback, so that pipelines are compiled before the first frame.
+    if (m_videoState == VideoState::Waiting)
+      return m_videoWriter != nullptr;
+
+    return now - m_videoBegin < m_videoLength;
+  }
+
+
+  void DxvkSwapchainBlitter::processVideo(
+    const DxvkContextObjects&         ctx,
+          high_resolution_clock::time_point now,
+          bool                        active,
+          VkExtent2D                  swapExtent,
+          VkRect2D                    dstRect,
+    const Rc<DxvkImageView>&          srcView,
+          VkRect2D                    srcRect,
+          VkBool32                    composite) {
+    if (m_videoState == VideoState::Waiting && !m_videoWriter
+     && now - m_videoFirstPresent + std::chrono::seconds(1) >= m_videoStart)
+      startVideo(dstRect.extent);
+
+    if (!m_videoWriter)
+      return;
+
+    drainVideoFrames(0u);
+
+    if (m_videoWriter->failed()) {
+      finishVideo(false);
+      return;
+    }
+
+    if (m_videoState == VideoState::Recording && !active) {
+      finishVideo(true);
+      return;
+    }
+
+    bool readback = m_videoState == VideoState::Recording;
+
+    // If the GPU is more than a full ring of frames behind, wait for the
+    // oldest frame rather than drop the new one.
+    if (readback && m_videoPending == VideoSlotCount) {
+      m_videoGpuWaits += 1u;
+      drainVideoFrames(1u);
+    }
+
+    auto timeUs = std::chrono::duration_cast<std::chrono::microseconds>(now - m_videoBegin);
+
+    recordVideoFrame(ctx, swapExtent, dstRect, srcView, srcRect,
+      composite, readback, readback ? uint64_t(timeUs.count()) : 0u);
+  }
+
+
+  void DxvkSwapchainBlitter::startVideo(
+          VkExtent2D                  presentExtent) {
+    // Only record one clip per process, even if the swap chain is recreated
+    static std::atomic<bool> s_videoStarted = { false };
+
+    if (s_videoStarted.exchange(true)) {
+      m_videoState = VideoState::Finished;
+      return;
+    }
+
+    // Even dimensions keep 4:2:0 encoders happy
+    VkExtent3D extent = {
+      std::max(16u, presentExtent.width  * m_videoScale / 100u) & ~1u,
+      std::max(16u, presentExtent.height * m_videoScale / 100u) & ~1u, 1u };
+
+    // The video always uses the same 8-bit BGRA sRGB format, whatever the
+    // swap chain format and color space are. The blit converts as needed.
+    DxvkImageCreateInfo imageInfo = { };
+    imageInfo.type          = VK_IMAGE_TYPE_2D;
+    imageInfo.format        = VK_FORMAT_B8G8R8A8_UNORM;
+    imageInfo.sampleCount   = VK_SAMPLE_COUNT_1_BIT;
+    imageInfo.extent        = extent;
+    imageInfo.mipLevels     = 1;
+    imageInfo.numLayers     = 1;
+    imageInfo.usage         = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT
+                            | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    imageInfo.stages        = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT
+                            | VK_PIPELINE_STAGE_TRANSFER_BIT;
+    imageInfo.access        = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT
+                            | VK_ACCESS_TRANSFER_READ_BIT;
+    imageInfo.tiling        = VK_IMAGE_TILING_OPTIMAL;
+    imageInfo.layout        = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    imageInfo.colorSpace    = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+    imageInfo.debugName     = "Swap chain video";
+
+    m_videoImage = m_device->createImage(imageInfo, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+    DxvkImageViewKey viewInfo = { };
+    viewInfo.viewType       = VK_IMAGE_VIEW_TYPE_2D;
+    viewInfo.usage          = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+    viewInfo.format         = imageInfo.format;
+    viewInfo.aspects        = VK_IMAGE_ASPECT_COLOR_BIT;
+    viewInfo.mipIndex       = 0u;
+    viewInfo.mipCount       = 1u;
+    viewInfo.layerIndex     = 0u;
+    viewInfo.layerCount     = 1u;
+
+    m_videoView = m_videoImage->createView(viewInfo);
+
+    // Cached memory, since the CPU reads every byte of these buffers
+    DxvkBufferCreateInfo bufferInfo = { };
+    bufferInfo.size   = VkDeviceSize(extent.width) * extent.height * 4u;
+    bufferInfo.usage  = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+    bufferInfo.stages = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    bufferInfo.access = VK_ACCESS_TRANSFER_WRITE_BIT;
+    bufferInfo.debugName = "Swap chain video";
+
+    for (auto& slot : m_videoSlots) {
+      slot.buffer = m_device->createBuffer(bufferInfo,
+        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT
+      | VK_MEMORY_PROPERTY_HOST_CACHED_BIT);
+    }
+
+    m_videoOldest = 0u;
+    m_videoPending = 0u;
+    m_videoGpuWaits = 0u;
+
+    Logger::info(str::format("Swap chain: recording ", m_videoLength.count() / 1000u,
+      " ms of video at ", extent.width, "x", extent.height));
+
+    m_videoWriter = std::make_unique<DxvkVideoWriter>(m_videoTarget, extent.width, extent.height);
+  }
+
+
+  void DxvkSwapchainBlitter::recordVideoFrame(
+    const DxvkContextObjects&         ctx,
+          VkExtent2D                  swapExtent,
+          VkRect2D                    dstRect,
+    const Rc<DxvkImageView>&          srcView,
+          VkRect2D                    srcRect,
+          VkBool32                    composite,
+          bool                        readback,
+          uint64_t                    timeUs) {
+    auto drawPass = [&] (
+      const Rc<DxvkImage>&      image,
+      const Rc<DxvkImageView>&  view,
+            VkRect2D            rect,
+      const Rc<DxvkImageView>&  passSrcView,
+            VkRect2D            passSrcRect,
+            VkBool32            passComposite,
+            VkPipelineStageFlags2 dstStages,
+            VkAccessFlags2      dstAccess) {
+      VkExtent3D extent = image->info().extent;
+
+      // The previous frame may still read the image
+      VkImageMemoryBarrier2 barrier = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2 };
+      barrier.srcStageMask = VK_PIPELINE_STAGE_2_TRANSFER_BIT
+                           | VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT;
+      barrier.dstAccessMask = VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT;
+      barrier.dstStageMask = VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT;
+      barrier.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      barrier.newLayout = image->pickLayout(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+      barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barrier.image = image->handle();
+      barrier.subresourceRange = view->imageSubresources();
+
+      VkDependencyInfo depInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+      depInfo.imageMemoryBarrierCount = 1;
+      depInfo.pImageMemoryBarriers = &barrier;
+
+      ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+      image->trackInitialization(barrier.subresourceRange);
+
+      VkRenderingAttachmentInfo attachmentInfo = { VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO };
+      attachmentInfo.imageView = view->handle();
+      attachmentInfo.imageLayout = image->pickLayout(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+      attachmentInfo.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+      attachmentInfo.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+
+      VkRenderingInfo renderInfo = { VK_STRUCTURE_TYPE_RENDERING_INFO };
+      renderInfo.renderArea.offset = { 0, 0 };
+      renderInfo.renderArea.extent = { extent.width, extent.height };
+      renderInfo.layerCount = 1u;
+      renderInfo.colorAttachmentCount = 1;
+      renderInfo.pColorAttachments = &attachmentInfo;
+
+      ctx.cmd->cmdBeginRendering(&renderInfo);
+
+      performDraw(ctx, view, rect, passSrcView, passSrcRect, passComposite, DxvkFsrPass::None);
+
+      ctx.cmd->cmdEndRendering();
+
+      barrier.srcStageMask = VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT;
+      barrier.srcAccessMask = VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT;
+      barrier.dstStageMask = dstStages;
+      barrier.dstAccessMask = dstAccess;
+      barrier.oldLayout = image->pickLayout(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+      barrier.newLayout = image->info().layout;
+
+      ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &depInfo);
+      ctx.cmd->track(image, DxvkAccess::Write);
+    };
+
+    Rc<DxvkImageView> videoSrcView = srcView;
+    VkRect2D videoSrcRect = srcRect;
+
+    // The HUD and the software cursor are positioned in swap chain pixels.
+    // To include them, compose the frame at swap chain size first, exactly
+    // like the swap chain image, then downscale that.
+    if (composite && (m_hudView || m_cursorView)) {
+      VkExtent3D fullExtent = { swapExtent.width, swapExtent.height, 1u };
+
+      if (!m_videoFullImage || m_videoFullImage->info().extent != fullExtent) {
+        DxvkImageCreateInfo imageInfo = { };
+        imageInfo.type          = VK_IMAGE_TYPE_2D;
+        imageInfo.format        = VK_FORMAT_B8G8R8A8_UNORM;
+        imageInfo.sampleCount   = VK_SAMPLE_COUNT_1_BIT;
+        imageInfo.extent        = fullExtent;
+        imageInfo.mipLevels     = 1;
+        imageInfo.numLayers     = 1;
+        imageInfo.usage         = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT
+                                | VK_IMAGE_USAGE_SAMPLED_BIT;
+        imageInfo.stages        = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT
+                                | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
+        imageInfo.access        = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT
+                                | VK_ACCESS_SHADER_READ_BIT;
+        imageInfo.tiling        = VK_IMAGE_TILING_OPTIMAL;
+        imageInfo.layout        = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+        imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        imageInfo.colorSpace    = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+        imageInfo.debugName     = "Swap chain video composition";
+
+        m_videoFullImage = m_device->createImage(imageInfo, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+        DxvkImageViewKey viewInfo = { };
+        viewInfo.viewType       = VK_IMAGE_VIEW_TYPE_2D;
+        viewInfo.usage          = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT
+                                | VK_IMAGE_USAGE_SAMPLED_BIT;
+        viewInfo.format         = imageInfo.format;
+        viewInfo.aspects        = VK_IMAGE_ASPECT_COLOR_BIT;
+        viewInfo.mipIndex       = 0u;
+        viewInfo.mipCount       = 1u;
+        viewInfo.layerIndex     = 0u;
+        viewInfo.layerCount     = 1u;
+
+        m_videoFullView = m_videoFullImage->createView(viewInfo);
+      }
+
+      drawPass(m_videoFullImage, m_videoFullView, dstRect, srcView, srcRect, composite,
+        VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT, VK_ACCESS_2_SHADER_READ_BIT);
+
+      videoSrcView = m_videoFullView;
+      videoSrcRect = dstRect;
+    } else {
+      m_videoFullImage = nullptr;
+      m_videoFullView = nullptr;
+    }
+
+    // Downscale with the linear blit shader
+    VkExtent3D extent = m_videoImage->info().extent;
+
+    drawPass(m_videoImage, m_videoView, { { 0, 0 }, { extent.width, extent.height } },
+      videoSrcView, videoSrcRect, VK_FALSE,
+      VK_PIPELINE_STAGE_2_TRANSFER_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+
+    if (!readback)
+      return;
+
+    VideoSlot& slot = m_videoSlots[(m_videoOldest + m_videoPending) % VideoSlotCount];
+    slot.timeUs = timeUs;
+
+    DxvkBufferSliceHandle bufferSlice = slot.buffer->getSliceHandle();
+
+    VkBufferImageCopy2 region = { VK_STRUCTURE_TYPE_BUFFER_IMAGE_COPY_2 };
+    region.bufferOffset = bufferSlice.offset;
+    region.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 0u, 1u };
+    region.imageExtent = extent;
+
+    VkCopyImageToBufferInfo2 copyInfo = { VK_STRUCTURE_TYPE_COPY_IMAGE_TO_BUFFER_INFO_2 };
+    copyInfo.srcImage = m_videoImage->handle();
+    copyInfo.srcImageLayout = m_videoImage->info().layout;
+    copyInfo.dstBuffer = bufferSlice.handle;
+    copyInfo.regionCount = 1;
+    copyInfo.pRegions = &region;
+
+    ctx.cmd->cmdCopyImageToBuffer(DxvkCmdBuffer::ExecBuffer, &copyInfo);
+
+    VkMemoryBarrier2 hostBarrier = { VK_STRUCTURE_TYPE_MEMORY_BARRIER_2 };
+    hostBarrier.srcStageMask = VK_PIPELINE_STAGE_2_TRANSFER_BIT;
+    hostBarrier.srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    hostBarrier.dstStageMask = VK_PIPELINE_STAGE_2_HOST_BIT;
+    hostBarrier.dstAccessMask = VK_ACCESS_2_HOST_READ_BIT;
+
+    VkDependencyInfo hostDepInfo = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    hostDepInfo.memoryBarrierCount = 1;
+    hostDepInfo.pMemoryBarriers = &hostBarrier;
+
+    ctx.cmd->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer, &hostDepInfo);
+    ctx.cmd->track(slot.buffer, DxvkAccess::Write);
+
+    m_videoPending += 1u;
+  }
+
+
+  void DxvkSwapchainBlitter::drainVideoFrames(
+          uint32_t                    waitCount) {
+    // Hand finished frames to the writer in present order. Frames recorded
+    // in earlier presents have been submitted, so waiting on them is safe.
+    while (m_videoPending) {
+      VideoSlot& slot = m_videoSlots[m_videoOldest];
+
+      if (slot.buffer->isInUse(DxvkAccess::Write)) {
+        if (!waitCount)
+          break;
+
+        m_device->waitForResource(*slot.buffer, DxvkAccess::Write);
+      }
+
+      m_videoWriter->submit(slot.buffer->mapPtr(0), slot.timeUs);
+
+      m_videoOldest = (m_videoOldest + 1u) % VideoSlotCount;
+      m_videoPending -= 1u;
+
+      if (waitCount)
+        waitCount -= 1u;
+    }
+  }
+
+
+  void DxvkSwapchainBlitter::finishVideo(
+          bool                        drain) {
+    if (m_videoWriter) {
+      if (drain)
+        drainVideoFrames(VideoSlotCount);
+
+      m_videoWriter->finish();
+      m_videoWriter = nullptr;
+
+      if (m_videoGpuWaits) {
+        Logger::warn(str::format("Swap chain: video capture waited for the GPU on ",
+          m_videoGpuWaits, " frames"));
+      }
+    }
+
+    for (auto& slot : m_videoSlots)
+      slot.buffer = nullptr;
+
+    m_videoImage = nullptr;
+    m_videoView = nullptr;
+    m_videoFullImage = nullptr;
+    m_videoFullView = nullptr;
+    m_videoPending = 0u;
+    m_videoState = VideoState::Finished;
+  }
+
