+  /**
+   * \brief Video capture writer
+   *
+   * Writes captured BGRA frames on a dedicated thread, so that a slow
+   * encoder or disk does not stall presentation until the bounded frame
+   * queue is full. The queue holds QueueBytes of frames (at least
+   * MinQueueFrames), enough to ride out the one-time stall of an encoder
+   * that starts up or a file that is first written to, and its buffers
+   * are allocated by the writer thread before recording starts. A target
+   * of the form raw:<path> writes the frames to <path>.bgra and their
+   * present time stamps to <path>.txt. Any other target is a command line
+   * that receives the frames on its standard input as Matroska raw BGRA
+   * video with present time stamps, so that the encoder sees the exact
+   * frame timing even when it falls behind.
+   */
+  class DxvkVideoWriter {
+    constexpr static size_t QueueBytes = (sizeof(void*) >= 8u ? 512u : 128u) << 20;
+    constexpr static size_t MinQueueFrames = 16u;
+    constexpr static size_t MaxQueueFrames = 1024u;
+  public:
+
+    DxvkVideoWriter(
+      const std::string&  target,
+            uint32_t      width,
+            uint32_t      height)
+    : m_width(width), m_height(height),
+      m_frameSize(size_t(width) * height * 4u),
+      m_queueFrames(std::clamp(QueueBytes / m_frameSize, MinQueueFrames, MaxQueueFrames)) {
+      if (target.compare(0, 4, "raw:") == 0)
+        m_rawPath = target.substr(4);
+      else
+        m_command = expandCommand(target);
+
+      m_thread = dxvk::thread([this] { run(); });
+    }
+
+    ~DxvkVideoWriter() {
+      finish();
+    }
+
+    bool failed() const {
+      return m_failed.load();
+    }
+
+    /**
+     * \brief Queues a frame
+     *
+     * Copies the frame. Blocks while the queue is full, and only drops
+     * the frame if the writer makes no progress for two seconds.
+     * \param [in] data Tightly packed BGRA pixels
+     * \param [in] timeUs Present time stamp, in microseconds
+     */
+    void submit(const void* data, uint64_t timeUs) {
+      std::unique_lock lock(m_mutex);
+
+      auto t0 = high_resolution_clock::now();
+      auto deadline = t0 + std::chrono::seconds(2);
+
+      std::vector<uint8_t> pixels;
+
+      while (true) {
+        if (m_failed)
+          return;
+
+        if (!m_free.empty()) {
+          pixels = std::move(m_free.back());
+          m_free.pop_back();
+          break;
+        }
+
+        if (m_allocated < m_queueFrames) {
+          pixels.resize(m_frameSize);
+          m_allocated += 1u;
+          break;
+        }
+
+        if (high_resolution_clock::now() >= deadline) {
+          m_dropped += 1u;
+          Logger::warn("Swap chain: video writer stalled for 2 s, dropping a frame");
+          return;
+        }
+
+        m_cond.wait_for(lock, std::chrono::milliseconds(2));
+      }
+
+      auto blocked = std::chrono::duration_cast<std::chrono::microseconds>(
+        high_resolution_clock::now() - t0);
+
+      if (blocked.count() >= 1000) {
+        if (!m_blockedFrames) {
+          Logger::warn("Swap chain: video writer queue is full, "
+            "presentation waits for the writer instead of dropping frames");
+        }
+
+        m_blockedFrames += 1u;
+        m_blockedUs += blocked.count();
+        m_blockedMaxUs = std::max(m_blockedMaxUs, uint64_t(blocked.count()));
+      }
+
+      lock.unlock();
+      std::memcpy(pixels.data(), data, m_frameSize);
+      lock.lock();
+
+      m_queue.push_back({ std::move(pixels), timeUs });
+      m_cond.notify_all();
+    }
+
+    /**
+     * \brief Writes all queued frames and closes the output
+     */
+    void finish() {
+      { std::unique_lock lock(m_mutex);
+        m_stopping = true;
+        m_cond.notify_all();
+      }
+
+      if (m_thread.joinable())
+        m_thread.join();
+    }
+
+  private:
+
+    struct Frame {
+      std::vector<uint8_t>  pixels;
+      uint64_t              timeUs = 0u;
+    };
+
+    uint32_t                m_width;
+    uint32_t                m_height;
+    size_t                  m_frameSize;
+    size_t                  m_queueFrames;
+
+    std::string             m_rawPath;
+    std::string             m_command;
+
+    dxvk::mutex             m_mutex;
+    dxvk::condition_variable m_cond;
+    std::deque<Frame>       m_queue;
+    std::vector<std::vector<uint8_t>> m_free;
+    size_t                  m_allocated = 0u;
+    bool                    m_stopping = false;
+    std::atomic<bool>       m_failed = { false };
+
+    uint32_t                m_dropped = 0u;
+    uint32_t                m_blockedFrames = 0u;
+    uint64_t                m_blockedUs = 0u;
+    uint64_t                m_blockedMaxUs = 0u;
+
+    std::ofstream           m_file;
+#ifdef _WIN32
+    HANDLE                  m_pipe = nullptr;
+    HANDLE                  m_process = nullptr;
+#else
+    FILE*                   m_pipe = nullptr;
+#endif
+
+    dxvk::thread            m_thread;
+
+    std::string expandCommand(std::string command) const {
+      auto replace = [&command] (const std::string& key, uint32_t value) {
+        std::string text = std::to_string(value);
+        size_t pos = command.find(key);
+
+        while (pos != std::string::npos) {
+          command.replace(pos, key.size(), text);
+          pos = command.find(key, pos + text.size());
+        }
+      };
+
+      replace("{w}", m_width);
+      replace("{h}", m_height);
+      return command;
+    }
+
+    void run() {
+      env::setThreadName("dxvk-video");
+
+#ifndef _WIN32
+      // Report a closed pipe as a write error instead of a fatal signal
+      sigset_t sigset;
+      sigemptyset(&sigset);
+      sigaddset(&sigset, SIGPIPE);
+      pthread_sigmask(SIG_BLOCK, &sigset, nullptr);
+#endif
+
+      bool ok = m_rawPath.empty()
+        ? openPipe() && writeHeader()
+        : openFile();
+
+      // The writer starts about a second before recording does. Allocate
+      // and touch the whole queue now, while the encoder starts up, so
+      // that presentation never has to.
+      if (ok)
+        allocateQueue();
+      else
+        m_failed = true;
+
+      std::vector<uint64_t> timestamps;
+
+      while (true) {
+        Frame frame;
+
+        { std::unique_lock lock(m_mutex);
+
+          while (m_queue.empty() && !m_stopping)
+            m_cond.wait(lock);
+
+          if (m_queue.empty())
+            break;
+
+          frame = std::move(m_queue.front());
+          m_queue.pop_front();
+        }
+
+        if (!m_failed) {
+          if (writeFrame(frame)) {
+            timestamps.push_back(frame.timeUs);
+          } else {
+            Logger::err("Swap chain: failed to write video frame, stopping capture");
+            m_failed = true;
+          }
+        }
+
+        { std::unique_lock lock(m_mutex);
+          m_free.push_back(std::move(frame.pixels));
+          m_cond.notify_all();
+        }
+      }
+
+      close(timestamps);
+    }
+
+    void allocateQueue() {
+      std::unique_lock lock(m_mutex);
+
+      while (m_allocated < m_queueFrames && !m_stopping) {
+        m_allocated += 1u;
+        lock.unlock();
+
+        std::vector<uint8_t> pixels(m_frameSize);
+
+        lock.lock();
+        m_free.push_back(std::move(pixels));
+        m_cond.notify_all();
+      }
+
+      Logger::info(str::format("Swap chain: video writer queue holds ", m_allocated,
+        " frames (", (m_allocated * m_frameSize) >> 20, " MB)"));
+    }
+
+    bool openFile() {
+      std::string path = m_rawPath + ".bgra";
+      m_file.open(str::topath(path.c_str()).c_str(), std::ios::binary | std::ios::trunc);
+
+      if (!m_file) {
+        Logger::err(str::format("Swap chain: failed to create ", path));
+        return false;
+      }
+
+      Logger::info(str::format("Swap chain: writing ", m_width, "x", m_height, " BGRA video to ", path));
+      return true;
+    }
+
+    bool openPipe() {
+#ifdef _WIN32
+      // Start the command directly: _popen does not work in GUI
+      // applications, and it would open a console window.
+      SECURITY_ATTRIBUTES sa = { sizeof(sa), nullptr, TRUE };
+      HANDLE readPipe = nullptr;
+      HANDLE writePipe = nullptr;
+
+      if (!CreatePipe(&readPipe, &writePipe, &sa, 4u << 20)) {
+        Logger::err(str::format("Swap chain: failed to create video pipe, error ", GetLastError()));
+        return false;
+      }
+
+      SetHandleInformation(writePipe, HANDLE_FLAG_INHERIT, 0);
+
+      HANDLE nul = CreateFileW(L"NUL", GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+        &sa, OPEN_EXISTING, 0, nullptr);
+
+      // Forward the command's diagnostics to our stderr when there is one
+      HANDLE errHandle = nullptr;
+      HANDLE parentErr = GetStdHandle(STD_ERROR_HANDLE);
+
+      if (parentErr && parentErr != INVALID_HANDLE_VALUE) {
+        if (!DuplicateHandle(GetCurrentProcess(), parentErr, GetCurrentProcess(),
+            &errHandle, 0, TRUE, DUPLICATE_SAME_ACCESS))
+          errHandle = nullptr;
+      }
+
+      STARTUPINFOW si = { };
+      si.cb = sizeof(si);
+      si.dwFlags = STARTF_USESTDHANDLES;
+      si.hStdInput = readPipe;
+      si.hStdOutput = nul;
+      si.hStdError = errHandle ? errHandle : nul;
+
+      PROCESS_INFORMATION pi = { };
+      std::wstring commandLine = str::tows(m_command.c_str());
+
+      BOOL created = CreateProcessW(nullptr, commandLine.data(), nullptr, nullptr,
+        TRUE, CREATE_NO_WINDOW, nullptr, nullptr, &si, &pi);
+      DWORD error = GetLastError();
+
+      CloseHandle(readPipe);
+
+      if (nul != INVALID_HANDLE_VALUE)
+        CloseHandle(nul);
+
+      if (errHandle)
+        CloseHandle(errHandle);
+
+      if (!created) {
+        CloseHandle(writePipe);
+        Logger::err(str::format("Swap chain: failed to start video command, error ", error, ": ", m_command));
+        return false;
+      }
+
+      CloseHandle(pi.hThread);
+      m_process = pi.hProcess;
+      m_pipe = writePipe;
+#else
+      m_pipe = popen(m_command.c_str(), "w");
+
+      if (!m_pipe) {
+        Logger::err(str::format("Swap chain: failed to start video command: ", m_command));
+        return false;
+      }
+#endif
+
+      Logger::info(str::format("Swap chain: streaming ", m_width, "x", m_height, " video to: ", m_command));
+      return true;
+    }
+
+    bool writeBytes(const void* data, size_t size) {
+      if (!m_rawPath.empty())
+        return bool(m_file.write(reinterpret_cast<const char*>(data), size));
+
+#ifdef _WIN32
+      auto ptr = reinterpret_cast<const uint8_t*>(data);
+
+      while (size) {
+        DWORD written = 0;
+
+        if (!WriteFile(m_pipe, ptr, DWORD(std::min<size_t>(size, 1u << 30)), &written, nullptr))
+          return false;
+
+        ptr += written;
+        size -= written;
+      }
+
+      return true;
+#else
+      return std::fwrite(data, 1, size, m_pipe) == size;
+#endif
+    }
+
+    static void ebmlId(std::vector<uint8_t>& out, uint32_t id) {
+      for (int32_t shift = 24; shift >= 0; shift -= 8) {
+        if ((id >> shift) || !shift)
+          out.push_back(uint8_t(id >> shift));
+      }
+    }
+
+    static void ebmlSize(std::vector<uint8_t>& out, uint64_t size) {
+      // Always use the 8-byte encoding
+      out.push_back(0x01u);
+
+      for (int32_t shift = 48; shift >= 0; shift -= 8)
+        out.push_back(uint8_t(size >> shift));
+    }
+
+    static void ebmlBinary(std::vector<uint8_t>& out, uint32_t id, const void* data, size_t size) {
+      ebmlId(out, id);
+      ebmlSize(out, size);
+
+      auto bytes = reinterpret_cast<const uint8_t*>(data);
+      out.insert(out.end(), bytes, bytes + size);
+    }
+
+    static void ebmlString(std::vector<uint8_t>& out, uint32_t id, const char* text) {
+      ebmlBinary(out, id, text, std::strlen(text));
+    }
+
+    static void ebmlUint(std::vector<uint8_t>& out, uint32_t id, uint64_t value) {
+      ebmlId(out, id);
+      ebmlSize(out, 8u);
+
+      for (int32_t shift = 56; shift >= 0; shift -= 8)
+        out.push_back(uint8_t(value >> shift));
+    }
+
+    static void ebmlMaster(std::vector<uint8_t>& out, uint32_t id, const std::vector<uint8_t>& body) {
+      ebmlBinary(out, id, body.data(), body.size());
+    }
+
+    bool writeHeader() {
+      std::vector<uint8_t> ebml;
+      ebmlUint(ebml, 0x4286u, 1u);              // EBMLVersion
+      ebmlUint(ebml, 0x42f7u, 1u);              // EBMLReadVersion
+      ebmlUint(ebml, 0x42f2u, 4u);              // EBMLMaxIDLength
+      ebmlUint(ebml, 0x42f3u, 8u);              // EBMLMaxSizeLength
+      ebmlString(ebml, 0x4282u, "matroska");    // DocType
+      ebmlUint(ebml, 0x4287u, 4u);              // DocTypeVersion
+      ebmlUint(ebml, 0x4285u, 2u);              // DocTypeReadVersion
+
+      std::vector<uint8_t> info;
+      ebmlUint(info, 0x2ad7b1u, 1000000u);      // TimestampScale: 1 ms
+      ebmlString(info, 0x4d80u, "DXVK");        // MuxingApp
+      ebmlString(info, 0x5741u, "DXVK");        // WritingApp
+
+      std::vector<uint8_t> video;
+      ebmlUint(video, 0xb0u, m_width);          // PixelWidth
+      ebmlUint(video, 0xbau, m_height);         // PixelHeight
+      ebmlBinary(video, 0x2eb524u, "BGRA", 4u); // ColourSpace
+
+      std::vector<uint8_t> track;
+      ebmlUint(track, 0xd7u, 1u);               // TrackNumber
+      ebmlUint(track, 0x73c5u, 1u);             // TrackUID
+      ebmlUint(track, 0x83u, 1u);               // TrackType: video
+      ebmlUint(track, 0x9cu, 0u);               // FlagLacing
+      ebmlString(track, 0x86u, "V_UNCOMPRESSED");
+      ebmlMaster(track, 0xe0u, video);
+
+      std::vector<uint8_t> tracks;
+      ebmlMaster(tracks, 0xaeu, track);         // TrackEntry
+
+      std::vector<uint8_t> header;
+      ebmlMaster(header, 0x1a45dfa3u, ebml);
+
+      // Segment of unknown size, since the output is a stream
+      ebmlId(header, 0x18538067u);
+      header.insert(header.end(), { 0x01u, 0xffu, 0xffu, 0xffu, 0xffu, 0xffu, 0xffu, 0xffu });
+
+      ebmlMaster(header, 0x1549a966u, info);
+      ebmlMaster(header, 0x1654ae6bu, tracks);
+      return writeBytes(header.data(), header.size());
+    }
+
+    bool writeFrame(const Frame& frame) {
+      if (m_rawPath.empty()) {
+        // One cluster per frame, with the time stamp and one key frame block
+        const std::array<uint8_t, 4> blockHeader = { 0x81u, 0x00u, 0x00u, 0x80u };
+
+        std::vector<uint8_t> timecode;
+        ebmlUint(timecode, 0xe7u, (frame.timeUs + 500u) / 1000u);
+
+        std::vector<uint8_t> cluster;
+        ebmlId(cluster, 0x1f43b675u);
+        ebmlSize(cluster, timecode.size() + 9u + blockHeader.size() + m_frameSize);
+        cluster.insert(cluster.end(), timecode.begin(), timecode.end());
+        ebmlId(cluster, 0xa3u);                 // SimpleBlock
+        ebmlSize(cluster, blockHeader.size() + m_frameSize);
+        cluster.insert(cluster.end(), blockHeader.begin(), blockHeader.end());
+
+        if (!writeBytes(cluster.data(), cluster.size()))
+          return false;
+      }
+
+      return writeBytes(frame.pixels.data(), m_frameSize);
+    }
+
+    void close(const std::vector<uint64_t>& timestamps) {
+      std::string result;
+
+      if (!m_rawPath.empty()) {
+        if (m_file.is_open())
+          m_file.close();
+
+        std::string path = m_rawPath + ".txt";
+        std::ofstream file(str::topath(path.c_str()).c_str(), std::ios::trunc);
+        file << m_width << " " << m_height << "\n";
+
+        for (uint64_t t : timestamps)
+          file << t << "\n";
+
+        result = file ? str::format("wrote ", m_rawPath, ".bgra and ", path)
+                      : str::format("failed to write ", path);
+      } else {
+#ifdef _WIN32
+        if (m_pipe) {
+          CloseHandle(m_pipe);
+
+          DWORD exitCode = 0;
+
+          if (WaitForSingleObject(m_process, 60000) == WAIT_OBJECT_0
+           && GetExitCodeProcess(m_process, &exitCode))
+            result = str::format("command exited with code ", exitCode);
+          else
+            result = "command still running";
+
+          CloseHandle(m_process);
+        }
+#else
+        if (m_pipe)
+          result = str::format("command exited with status ", pclose(m_pipe));
+#endif
+        m_pipe = nullptr;
+      }
+
+      double seconds = timestamps.size() > 1u
+        ? double(timestamps.back() - timestamps.front()) / 1000000.0 : 0.0;
+      double fps = seconds > 0.0 ? double(timestamps.size() - 1u) / seconds : 0.0;
+
+      // Every presented frame is written: the intervals between the time
+      // stamps are the game's own frame times, so a slow or uneven clip
+      // shows up here as long intervals rather than as missing frames.
+      std::vector<uint64_t> intervals;
+
+      for (size_t i = 1u; i < timestamps.size(); i++)
+        intervals.push_back(timestamps[i] - timestamps[i - 1u]);
+
+      std::sort(intervals.begin(), intervals.end());
+
+      uint64_t medianUs = intervals.empty() ? 0u : intervals[intervals.size() / 2u];
+      uint64_t maxUs = intervals.empty() ? 0u : intervals.back();
+      size_t longFrames = 0u;
+
+      for (uint64_t interval : intervals)
+        longFrames += interval > 2u * medianUs ? 1u : 0u;
+
+      Logger::info(str::format("Swap chain: video capture finished, ", timestamps.size(),
+        " frames in ", seconds, " s, average ", fps, " fps (frame time median ",
+        double(medianUs) / 1000.0, " ms, longest ", double(maxUs) / 1000.0, " ms, ",
+        longFrames, " frames over twice the median), ", m_dropped, " dropped, ",
+        m_blockedFrames, " frames waited ", m_blockedUs / 1000u, " ms for the writer (longest ",
+        m_blockedMaxUs / 1000u, " ms); ", result));
+    }
+
+  };
   
