 namespace dxvk {
 
   /**
+   * \brief Reads a process environment variable of any length
+   *
+   * env::getEnvVar is limited to MAX_PATH characters on Windows, which
+   * is too short for a video capture command line.
+   */
+  static std::string getVideoControlEnvVar(const char* name) {
+#ifdef _WIN32
+    std::wstring wname = str::tows(name);
+    DWORD size = ::GetEnvironmentVariableW(wname.c_str(), nullptr, 0);
+
+    if (!size)
+      return std::string();
+
+    std::vector<WCHAR> value(size + 1u);
+    DWORD len = ::GetEnvironmentVariableW(wname.c_str(), value.data(), size + 1u);
+
+    if (!len || len > size)
+      return std::string();
+
+    return str::fromws(value.data());
+#else
+    const char* value = std::getenv(name);
+    return value ? value : "";
+#endif
+  }
+
+
+  /**
+   * \brief Sets a process environment variable
+   */
+  static void setVideoControlEnvVar(const char* name, const std::string& value) {
+#ifdef _WIN32
+    ::SetEnvironmentVariableW(str::tows(name).c_str(), str::tows(value.c_str()).c_str());
+#else
+    ::setenv(name, value.c_str(), 1);
+#endif
+  }
