+  void DxvkSwapchainBlitter::pollVideoControl() {
+    // Every swap chain sees the same variable, so each value is only acted
+    // on once per process. A swap chain created while a clip is recording
+    // does not restart it; the clip ended with the old swap chain.
+    static dxvk::mutex s_controlMutex;
+    static std::string s_controlHandled;
+
+    std::string control = getVideoControlEnvVar("DXVK_CAPTURE_VIDEO_CONTROL");
+
+    { std::lock_guard lock(s_controlMutex);
+
+      if (control == s_controlHandled)
+        return;
+
+      s_controlHandled = control;
+    }
+
+    if (m_videoState == VideoState::Waiting || m_videoState == VideoState::Recording)
+      finishVideo(true);
+
+    if (control.empty())
+      return;
+
+    size_t separator = control.find('|');
+
+    if (separator == std::string::npos || separator + 1u >= control.size()) {
+      Logger::err(str::format("Swap chain: invalid DXVK_CAPTURE_VIDEO_CONTROL: ", control));
+      setVideoControlEnvVar("DXVK_CAPTURE_VIDEO_STATE", "invalid|" + control);
+      return;
+    }
+
+    m_videoMaxHeight = uint32_t(std::clamp(std::strtol(control.c_str(), nullptr, 10), 120l, 4320l));
+    m_videoTarget = control.substr(separator + 1u);
+    m_videoEvent.clear();
+    m_videoStart = std::chrono::microseconds(0);
+    m_videoLength = std::chrono::minutes(30);
+    m_videoFirstPresent = high_resolution_clock::time_point();
+    m_videoState = VideoState::Waiting;
+
+    Logger::info(str::format("Swap chain: video clip of up to ", m_videoMaxHeight,
+      " lines requested: ", m_videoTarget));
+    setVideoControlEnvVar("DXVK_CAPTURE_VIDEO_STATE", "recording|" + m_videoTarget);
   }
 
 
